# Required — from Supabase dashboard: Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role secret key>

# Required — any long random string. Salts the IP hash used for rate limiting.
IP_SALT=<random string>

# Optional — enables email notification of new enquiries.
#
# RESEND_API_KEY  Without it nothing is emailed: the enquiry still saves to
#                 the database, but nobody is alerted. Mark it Sensitive in
#                 Vercel, never commit it.
# NOTIFY_EMAIL    Comma-separated, no space after the comma. Every address
#                 listed gets a copy of each enquiry.
# NOTIFY_FROM     Must be on a domain verified in Resend, otherwise the send
#                 is rejected. The verified sending domain for this site is
#                 update.ninjaplumbers.co.uk. Leaving this blank falls back to
#                 Resend's shared sandbox sender, which can only deliver to
#                 the address that owns the Resend account — so with more than
#                 one recipient it fails.
#
# These are read with import.meta.env, which Astro inlines at build time, so a
# redeploy is required after changing any of them.
RESEND_API_KEY=
NOTIFY_EMAIL=info@ninjaplumbers.co.uk,rankdent@gmail.com
NOTIFY_FROM=Ninja Plumbers Website <noreply@update.ninjaplumbers.co.uk>

# Optional — forwards each enquiry to a GoHighLevel (or other CRM) inbound webhook
GHL_WEBHOOK_URL=
