# Required — from Supabase dashboard: Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role secret key>

# Required — any long random string. Salts the IP hash used for rate limiting.
IP_SALT=<random string>

# Optional — enables email notification of new enquiries
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

# Optional — forwards each enquiry to a GoHighLevel (or other CRM) inbound webhook
GHL_WEBHOOK_URL=
