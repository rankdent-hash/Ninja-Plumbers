---
// Site search overlay. Opened by the header search button (and "/"), filled
// by /search.js, which loads on first use together with /search-index.json.
import site from '../data/site.json';
import PhoneIcon from './PhoneIcon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
---
<div class="search-overlay" id="site-search" hidden>
  <div class="search-backdrop" data-search-close></div>
  <div class="search-panel" role="dialog" aria-modal="true" aria-labelledby="search-title">
    <h2 id="search-title" class="sr-only">Search the site</h2>
    <form class="search-form" role="search" action="/site-map" method="get">
      <svg class="search-ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="20" y1="20" x2="16.65" y2="16.65"/></svg>
      <label for="search-input" class="sr-only">Search for a service, area or postcode</label>
      <input type="search" id="search-input" name="q" placeholder="Search a service, area or postcode…" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="search-hint">
      <button type="button" class="search-close" data-search-close aria-label="Close search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </form>
    <p class="search-hint" id="search-hint">Try &ldquo;boiler repair&rdquo;, &ldquo;blocked drain&rdquo;, &ldquo;Fulham&rdquo; or &ldquo;SW6&rdquo;.</p>
    <p class="sr-only" id="search-status" role="status" aria-live="polite"></p>
    <div class="search-results" id="search-results"></div>
    <div class="search-cta">
      <span class="search-cta-eyebrow">Need someone now?</span>
      <div class="search-cta-actions">
        <a href={`tel:${site.booking.tel}`} class="btn btn-orange"><PhoneIcon /> Call {site.booking.display}</a>
        <a href={site.whatsapp.url} class="btn btn-ghost"><WhatsAppIcon /> WhatsApp</a>
        <a href="/contact#enquiry" class="btn btn-navy" data-search-enquiry data-book-open>Send us the job</a>
      </div>
    </div>
  </div>
</div>
