---
// Schematic map of London and the M25 for /admin/areas: the 33 borough
// outlines and the surrounding districts as a backdrop, with a dot per
// postcode district carrying data.
//
// Server-rendered SVG with no tile server, no map library and no API key —
// nothing about an admin's session leaves this domain to draw it, and the
// geometry is committed (see src/data/londonMap.ts).
//
// Two kinds of dot, and the difference matters more than anything else here:
//   - ENQUIRIES sit at the district of the postcode the customer typed. That
//     is where the job is.
//   - CLICKS sit at the district of the page the visitor was reading when they
//     tapped call/WhatsApp/text. That is NOT where the person was — we have no
//     idea where they were — it is which local page earned the tap.
// The legend says so, because a dot that silently mixes the two would be a
// map that lies.
//
// Accessibility: this SVG is decorative-with-a-summary. The table beneath it on
// the page carries the same numbers in full, which is the real non-visual
// equivalent — per-dot <title> elements inside a role="img" are not announced.
import { BOROUGHS, OUTER_DISTRICTS, POINTS, M25, MAP_WIDTH, MAP_HEIGHT, UNITS_PER_MILE } from '../data/londonMap';
import { COVERED_OUTSIDE_LONDON, CORRIDOR_MILES } from '../data/serviceArea';
import { DISTRICT_PARENT } from '../lib/districtParents';
import { DISTRICT_CELLS } from '../lib/districtCells';
import { postcodes } from '../data/postcodes';
import { districtPrimary, districtPlaceList, DISTRICT_PLACES } from '../lib/districtPlaces';
import { districtPageGap } from '../lib/placeCoverage';

// The planned expansion: up to 3 miles either side of the M25. Drawn as a
// stroke that wide rather than a computed buffer polygon — a round-capped,
// round-joined stroke IS the buffer of a line, and it closes the small gaps
// between the motorway's separately-sampled runs for free.
const CORRIDOR_WIDTH = CORRIDOR_MILES * 2 * UNITS_PER_MILE;

// Three tiers, and keeping them apart is the whole point of this layer:
//   - boroughs          covered today
//   - covered districts covered today, outside Greater London (the client named these)
//   - the rest          the corridor runs through them; NOT covered today
const covered = new Set(COVERED_OUTSIDE_LONDON);
const districts = OUTER_DISTRICTS.map((o) => ({ ...o, covered: covered.has(o.name) }));

// Ampersand on the drawn label only — it buys back two characters on the
// longest names, which is the difference between fitting and being clipped at
// the frame edge. Hover and the table keep the full official name. The label
// generator assumes this same shortening when it reserves space.
const shortName = (n: string) => n.replace(' and ', ' & ');

// Guard against a rename in the generated geometry silently turning a covered
// area back into a planned one.
const missing = COVERED_OUTSIDE_LONDON.filter((n) => !OUTER_DISTRICTS.some((o) => o.name === n));
if (missing.length) {
  throw new Error(`serviceArea.ts names districts that are not in the map: ${missing.join(', ')}`);
}

export type MapMarker = {
  district: string;
  borough: string | null;
  x: number;
  y: number;
  enquiries: number;
  phone: number;
  whatsapp: number;
  sms: number;
};

export type DistrictDetail = {
  district: string;
  places: string[];
  borough: string | null;
  enquiries: number;
  booked: number;
  // How the district's enquiries reached us. These sum to `enquiries`, and are
  // a different thing from the phone/whatsapp/sms fields below: those count
  // taps on a page, positioned by the page rather than by the person, while
  // these count enquiries that genuinely came from this postcode.
  byChannel: { form: number; phone: number; whatsapp: number; other: number };
  phone: number;
  whatsapp: number;
  sms: number;
  pages: { page: string; views: number; phone: number; whatsapp: number; sms: number; forms: number; contacts: number }[];
  areaPage: string | null;
  areaName: string | null;
};

interface Props {
  markers: MapMarker[];
  details?: DistrictDetail[];
  summary: string;
}
const { markers, details = [], summary } = Astro.props;

// A panel per district that has something to say. Server-rendered because it
// keeps the interaction to a class toggle, and because these numbers belong in
// the HTML rather than being assembled by a script that might not run.
const pct = (n: number, of: number) => (of > 0 ? Math.round((n / of) * 100) : null);

// Dots are placed on a small rosette around the district centroid so four
// types at one district stay separable instead of stacking into one blob.
// Offsets and radii are in viewBox units: the map is ~2075 units wide and
// renders around 1100px, so a unit is roughly half a pixel.
// Widening the frame to fit the corridor districts shrank everything drawn in
// it, so the dots and their rosette scale back up by the same factor and keep
// the size they were tuned at.
//
// Derived, not typed in: .areamap-svg is width:100%/height:auto, so what is on
// screen is driven by MAP_WIDTH alone and MAP_HEIGHT only sets the aspect
// ratio. A hand-set 1.14 was wrong here — that is the HEIGHT ratio, which
// cannot affect rendered size.
const TUNED_WIDTH = 1918.6;
const SCALE = MAP_WIDTH / TUNED_WIDTH;
const OFFSETS: Record<string, [number, number]> = {
  enquiries: [0, -13 * SCALE],
  phone: [13 * SCALE, 4 * SCALE],
  whatsapp: [-13 * SCALE, 4 * SCALE],
  sms: [0, 17 * SCALE],
};
const KINDS = ['enquiries', 'phone', 'whatsapp', 'sms'] as const;

// Area, not radius, carries the count — a circle twice as wide reads as four
// times as much, which is exactly the misreading sqrt avoids.
const radius = (n: number) => Math.min(30 * SCALE, (7 + Math.sqrt(n) * 4.5) * SCALE);

// One label per postcode district, rendered for every shape but shown only for
// the one the reader has opened. Rendering them all server-side keeps the
// interaction to a class toggle — no measuring, no layout work on click.
// Names come from src/lib/districtPlaces.ts, which merges the client's
// workbook with public place names for everything the workbook does not reach.
// Asking the workbook alone left 200 of the 329 districts nameless, which is
// why one borough looked labelled and the next looked bare.

// The boroughs a district ACTUALLY spans, from the same workbook. This is the
// honest answer to the straddling problem: SW8's centre falls in Wandsworth, so
// that is the shape it is filed under here, but it really runs across Lambeth
// and Wandsworth and the tooltip should say so rather than repeat the guess.
const boroughsByDistrict = new Map(
  postcodes.map((p) => [p.district.toUpperCase(), (p.boroughs ?? []).join(', ')])
);

const districtLabels = Object.entries(POINTS)
  .filter(([code]) => DISTRICT_PARENT[code])
  .map(([code, [x, y]]) => ({
    code,
    x,
    y,
    parent: DISTRICT_PARENT[code],
    primary: districtPrimary(code),
    // The rest of the places this district covers. Shown only when the district
    // is opened, because listing four names on every shape at once is noise.
    extra: (DISTRICT_PLACES[code] ?? []).slice(1, 4),
    boroughs: boroughsByDistrict.get(code) || DISTRICT_PARENT[code],
  }));

// The district centre and the rosette offset are kept apart on each dot so the
// script can rebuild cx/cy at any zoom. Both the offset and the radius are
// divided by the zoom at runtime: a marker is a marker, not a piece of
// geography, so it should hold its size and its cluster should stay a cluster
// however far in the map goes.
// What the search box can find: every postcode district by code or by any of
// its place names, and every area by name. Emitted as JSON rather than as DOM
// so the matching can be done properly — substring across several names per
// entry — instead of leaning on whatever a datalist happens to do.
const searchIndex = [
  ...Object.keys(POINTS)
    .filter((code) => DISTRICT_PARENT[code])
    .map((code) => ({
      t: 'd',
      c: code,
      p: DISTRICT_PARENT[code],
      n: (DISTRICT_PLACES[code] ?? []).join(', '),
    })),
  ...BOROUGHS.map((b) => ({ t: 's', c: b.name, p: '', n: 'Greater London borough' })),
  ...OUTER_DISTRICTS.map((o) => ({
    t: 's',
    c: o.name,
    p: '',
    n: covered.has(o.name) ? 'Covered, outside London' : 'M25 corridor, not covered yet',
  })),
];

const dots = markers.flatMap((m) =>
  KINDS.filter((k) => m[k] > 0).map((k) => ({
    kind: k,
    district: m.district,
    borough: m.borough,
    count: m[k],
    x: m.x,
    y: m.y,
    ox: OFFSETS[k][0],
    oy: OFFSETS[k][1],
    cx: m.x + OFFSETS[k][0],
    cy: m.y + OFFSETS[k][1],
    r: radius(m[k]),
  }))
);
---
<div class="areamap" data-areamap>
  <div class="areamap-search">
    <label class="areamap-search-label" for="areamap-q">Find an area or postcode</label>
    <div class="areamap-search-box">
      <input
        type="text"
        id="areamap-q"
        class="areamap-search-input"
        placeholder="SW18, Earlsfield, Wandsworth&hellip;"
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="areamap-suggestions"
        aria-autocomplete="list"
        data-areamap-search
      />
      <button type="button" class="areamap-search-clear" data-areamap-search-clear hidden aria-label="Clear search">&times;</button>
      <ul class="areamap-suggestions" id="areamap-suggestions" role="listbox" data-areamap-suggestions hidden></ul>
    </div>
    <p class="areamap-search-status" data-areamap-search-status role="status" aria-live="polite"></p>
  </div>

  {/* is:inline or Astro treats this as a module to bundle and it never reaches
      the page — the search box then finds an empty index and silently does
      nothing. */}
  <script type="application/json" data-areamap-index is:inline set:html={JSON.stringify(searchIndex)}></script>

  <div class="areamap-toolbar">
    <div class="areamap-legend">
      <span class="areamap-key areamap-key-enquiries">Enquiries <small>(job postcode)</small></span>
      <span class="areamap-key areamap-key-phone">Phone</span>
      <span class="areamap-key areamap-key-whatsapp">WhatsApp</span>
      <span class="areamap-key areamap-key-sms">Text</span>
      <span class="areamap-key areamap-key-corridor">M25 &plusmn;{CORRIDOR_MILES} miles</span>
      <span class="areamap-key areamap-key-covered">Covered today</span>
      <span class="areamap-key areamap-key-planned">Not covered yet</span>
      <span class="areamap-legend-note">Click any area to zoom into it and see the postcode districts inside, then click a district or one of its dots for the full breakdown &mdash; how many enquiries and taps, and which pages earned them. Escape steps back out. Those district divisions are schematic &mdash; each district centre claims the ground nearest to it, so the middle of each one is right and the seams between them are approximate. Call, WhatsApp and text dots show the page that earned the tap, not where the person was. Greater London, Guildford and St Albans are covered; the named districts around the M25 are where the planned expansion would reach, not places we work today.</span>
    </div>
    <div class="areamap-zoom">
      <button type="button" class="btn btn-ghost" data-areamap-toggle="corridor" aria-pressed="true">M25 band</button>
      <button type="button" class="btn btn-ghost" data-areamap-zoom="in" aria-label="Zoom in">+</button>
      <button type="button" class="btn btn-ghost" data-areamap-zoom="out" aria-label="Zoom out">&minus;</button>
      <button type="button" class="btn btn-ghost" data-areamap-zoom="reset">Reset</button>
    </div>
  </div>

  <p class="areamap-readout" data-areamap-readout hidden aria-live="polite"></p>


  <div class="areamap-stage">
    <svg
      class="areamap-svg"
      viewBox={`0 0 ${MAP_WIDTH} ${MAP_HEIGHT}`}
      data-areamap-svg
      data-vb-w={MAP_WIDTH}
      data-vb-h={MAP_HEIGHT}
      role="img"
      aria-label={summary}
      preserveAspectRatio="xMidYMid meet"
    >
      <g data-areamap-pan>
        {/* Everything outside the borough outlines: the counties the business
            does not cover today, tinted so "inside Greater London" reads at a
            glance. Boroughs are painted over the top of it. */}
        <rect class="areamap-outside" x="0" y="0" width={MAP_WIDTH} height={MAP_HEIGHT} />

        {/* The counties around London. Drawn under the boroughs and under the
            corridor band. Several run off the edge of the frame, which is
            true — they continue beyond it. */}
        <g class="areamap-districts">
          {districts.map((o) => (
            <path
              d={o.d}
              class:list={['areamap-district', { 'is-covered': o.covered }]}
              data-borough={o.name}
              data-covered={o.covered ? 'yes' : 'no'}
            ><title>{o.covered ? `${o.name} — covered` : `${o.name} — not covered yet`}</title></path>
          ))}
        </g>

        <g class="areamap-boroughs">
          {BOROUGHS.map((b) => (
            <path d={b.d} class="areamap-borough" data-borough={b.name} data-covered="yes"><title>{b.name}</title></path>
          ))}
        </g>

        {/* Over the boroughs, not under them, so the band is visible on both
            sides of the motorway. */}
        <g class="areamap-corridor" data-areamap-corridor>
          {M25.map((d) => (
            <path d={d} stroke-width={CORRIDOR_WIDTH} />
          ))}
        </g>
        <g class="areamap-m25">
          {M25.map((d) => (
            <path d={d}><title>M25</title></path>
          ))}
        </g>

        {/* Names for the outer districts. London's boroughs stay hover-only —
            33 labels in that space would be unreadable — but out here there is
            room, and a shape with no name on it is no use for deciding where
            to advertise. aria-hidden because the table below carries the same
            ground in text. */}
        <g class="areamap-labels" aria-hidden="true">
          {districts.filter((o) => o.label).map((o) => (
            <text
              x={o.label![0]}
              y={o.label![1]}
              class:list={['areamap-label', { 'is-covered': o.covered }]}
            >{shortName(o.name)}</text>
          ))}
        </g>

        {/* Postcode districts inside whichever shape is open. Hidden until
            then: 268 codes at once would bury the map. */}
        {/* The districts inside the open area. Schematic: each district centre
            claims the ground nearest to it, trimmed to the area outline. Not
            surveyed postcode boundaries — the page says so. */}
        <g class="areamap-cells" aria-hidden="true">
          {DISTRICT_CELLS.map((c) => (
            <path
              d={c.d}
              class="areamap-cell"
              data-parent={c.parent}
              data-code={c.code}
              data-place={districtPlaceList(c.code)}
              data-area={boroughsByDistrict.get(c.code) || c.parent}
            />
          ))}
        </g>

        <g class="areamap-districtcodes" aria-hidden="true">
          {districtLabels.map((d) => (
            <text x={d.x} y={d.y} class="areamap-code" data-parent={d.parent} data-code={d.code}>
              <tspan x={d.x} dy="-0.35em">{d.code}</tspan>
              {d.primary && <tspan x={d.x} dy="1.25em" class="areamap-code-place">{d.primary}</tspan>}
              {d.extra.map((n) => (
                <tspan x={d.x} dy="1.15em" class="areamap-code-place areamap-code-extra">{n}</tspan>
              ))}
            </text>
          ))}
        </g>

        <g class="areamap-dots">
          {dots.map((d) => (
            <circle
              class={`areamap-dot areamap-dot-${d.kind}`}
              cx={d.cx}
              cy={d.cy}
              r={d.r}
              data-district={d.district}
              data-borough={d.borough ?? ''}
              data-kind={d.kind}
              data-count={d.count}
              data-summary={(() => {
                const m = markers.find((x) => x.district === d.district)!;
                return [
                  m.enquiries ? `${m.enquiries} enquir${m.enquiries === 1 ? 'y' : 'ies'}` : '',
                  m.phone ? `${m.phone} phone` : '',
                  m.whatsapp ? `${m.whatsapp} WhatsApp` : '',
                  m.sms ? `${m.sms} text` : '',
                ].filter(Boolean).join(' &middot; ');
              })()}
              data-x={d.x}
              data-y={d.y}
              data-ox={d.ox}
              data-oy={d.oy}
              data-r={d.r}
              data-parent-shape={DISTRICT_PARENT[d.district] ?? ''}
            />
          ))}
        </g>
      </g>
    </svg>

    <div class="areamap-tip" data-areamap-tip hidden aria-hidden="true"></div>
  </div>

  {details.map((d) => {
    const taps = d.phone + d.whatsapp + d.sms;
    const views = d.pages.reduce((s, p) => s + p.views, 0);
    const contacts = d.pages.reduce((s, p) => s + p.contacts, 0);
    const rate = pct(contacts, views);
    const bookedRate = pct(d.booked, d.enquiries);
    const thin = d.enquiries + taps < 10;
    return (
      <section class="areamap-detail" data-areamap-detail={d.district} hidden>
        <div class="areamap-detail-head">
          <h2>
            {d.district}
            {d.places.length > 0 && <span class="areamap-detail-places"> {d.places.slice(0, 4).join(', ')}</span>}
          </h2>
          {d.borough && <p class="areamap-detail-sub">{d.borough}</p>}
        </div>

        <div class="areamap-detail-stats">
          <div class="areamap-stat">
            <span class="areamap-stat-n">{d.enquiries}</span>
            <span class="areamap-stat-l">
              {d.enquiries === 1 ? 'enquiry' : 'enquiries'}<br />
              {/* Only worth a line once some of them came in by hand. On a
                  district where every enquiry is a form submission, "4 by
                  form" is the same sentence as the number above it. */}
              <small>{d.byChannel.form < d.enquiries
                ? [
                    d.byChannel.form ? `${d.byChannel.form} by form` : '',
                    d.byChannel.phone ? `${d.byChannel.phone} by phone` : '',
                    d.byChannel.whatsapp ? `${d.byChannel.whatsapp} on WhatsApp` : '',
                    d.byChannel.other ? `${d.byChannel.other} other` : '',
                  ].filter(Boolean).join(', ')
                : 'job postcode'}</small>
            </span>
          </div>
          <div class="areamap-stat">
            <span class="areamap-stat-n">{d.booked}</span>
            <span class="areamap-stat-l">booked{bookedRate !== null && <><br /><small>{bookedRate}% of enquiries</small></>}</span>
          </div>
          <div class="areamap-stat"><span class="areamap-stat-n">{d.phone}</span><span class="areamap-stat-l">phone taps</span></div>
          <div class="areamap-stat"><span class="areamap-stat-n">{d.whatsapp}</span><span class="areamap-stat-l">WhatsApp taps</span></div>
          <div class="areamap-stat"><span class="areamap-stat-n">{d.sms}</span><span class="areamap-stat-l">text taps</span></div>
        </div>

        {d.pages.length > 0 && (
          <>
            <h3 class="areamap-detail-h4">
              Pages behind this
              {rate !== null && <span class="areamap-detail-rate"> &mdash; {contacts} contact{contacts === 1 ? '' : 's'} from {views} view{views === 1 ? '' : 's'}, {rate}%</span>}
            </h3>
            <div class="admin-table-scroll" tabindex="0">
              <table class="admin-table areamap-detail-table">
                <thead>
                  <tr>
                    <th>Page</th>
                    <th class="admin-num">Views</th>
                    <th class="admin-num">Phone</th>
                    <th class="admin-num">WhatsApp</th>
                    <th class="admin-num">Text</th>
                    <th class="admin-num">Forms</th>
                    <th class="admin-num">Rate</th>
                  </tr>
                </thead>
                <tbody>
                  {d.pages.map((p) => {
                    const r = pct(p.contacts, p.views);
                    return (
                      <tr>
                        <td><a href={p.page} target="_blank" rel="noopener">{p.page}</a></td>
                        <td class="admin-num">{p.views}</td>
                        <td class="admin-num">{p.phone || <span class="admin-dim">&mdash;</span>}</td>
                        <td class="admin-num">{p.whatsapp || <span class="admin-dim">&mdash;</span>}</td>
                        <td class="admin-num">{p.sms || <span class="admin-dim">&mdash;</span>}</td>
                        <td class="admin-num">{p.forms || <span class="admin-dim">&mdash;</span>}</td>
                        <td class="admin-num">{r === null ? <span class="admin-dim">&mdash;</span> : `${r}%`}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </>
        )}

        <p class="areamap-detail-note">
          {thin ? (
            <><strong>Too little here to act on.</strong>{` ${d.enquiries + taps} ${d.enquiries + taps === 1 ? 'record' : 'records'} is not a pattern — one more would move every percentage on this panel. Treat it as a note of what has come in, not a signal. `}</>
          ) : (
            <><strong>Rate is the number to watch, not the count.</strong> A page with fewer views and a higher rate is
            working harder per visit, which is what tells you where another pound of ad spend goes furthest.{' '}</>
          )}
          The enquiry count is a real location — the postcode the customer typed. The phone, WhatsApp and text counts are
          not: they record the page the tap happened on, so they say which local page earned the contact, not where the
          person was.
          {d.enquiries > 0 && !d.areaPage && <> There is no neighbourhood page for this district yet, which is the cheapest thing to change.</>}
          {d.areaPage && <> Its area page is <a href={`/areas/${d.areaPage}`} target="_blank" rel="noopener">{d.areaName}</a>.</>}
        </p>

        {(() => {
          // A district is one dot but several named places, and the gap between
          // "we have a page for this district" and "we have a page for the
          // places in it" is where the content plan lives. Places says which.
          const gap = districtPageGap(d.district);
          if (gap.total === 0) return null;
          const missing = gap.total - gap.withPage;
          return (
            <p class="areamap-detail-note">
              {d.district} covers {gap.total} named {gap.total === 1 ? 'place' : 'places'}
              {missing === 0
                ? ', and each one has a page of its own.'
                : ` — ${missing} of them ${missing === 1 ? 'has' : 'have'} no page of ${missing === 1 ? 'its' : 'their'} own.`}
              {' '}<a href={`/admin/places?q=${encodeURIComponent(d.district)}&status=all`}>See them in Places</a>.
            </p>
          );
        })()}
      </section>
    );
  })}

  <section class="areamap-detail areamap-detail-empty" data-areamap-detail-empty hidden>
    <p class="admin-note">Nothing recorded in this district for the period shown — no enquiries with this postcode, and no
    taps on a page about it.</p>
  </section>

  {markers.length === 0 && (
    <p class="admin-empty areamap-empty">Nothing to plot for this period yet. The map fills in as enquiries and taps come in.</p>
  )}
</div>

<script src="/admin-areas-map.js" is:inline></script>
