---
// Single source for service iconography — nav, hub cards and page headers.
import { SERVICE_ICON_PATHS } from '../data/serviceIconPaths';
const { name, size = 24 } = Astro.props;

const paths = SERVICE_ICON_PATHS;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
     set:html={paths[name] ?? paths.general} />
