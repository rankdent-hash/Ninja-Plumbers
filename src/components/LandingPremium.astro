---
// The higher-end landing-page body, used by /lp/[slug] for any page whose
// data sets `premium` (see landing.ts). Everything shown here is either
// already on the page in its basic form (rating, offer, trust claims) or
// pulled from site.json — the layout is different, the claims are not.
import site from '../data/site.json';
import type { Landing, PremiumIcon } from '../data/landing';
import { iconSvg as icon } from '../data/premium-icons';
import { areas } from '../data/areas';
import EnquiryForm from './EnquiryForm.astro';
import Tick from './Tick.astro';
import PhoneIcon from './PhoneIcon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

type Props = { lp: Landing; serviceTitle: string };
const { lp, serviceTitle } = Astro.props;
const p = lp.premium!;
const topAreas = [...areas].sort((a, b) => b.volume - a.volume).slice(0, 10);
const ratingPct = Math.round((parseFloat(p.rating.score) / 5) * 100);

// Submit-button rotation, picked client-side on each page load (see
// EnquiryForm.astro). "Claim My £25 Off" only makes sense when the page
// actually carries that offer.
const ctaVariants = lp.offer
  ? ['Get Booked In', 'Get a Call Back', 'Claim My £25 Off']
  : ['Get Booked In', 'Get a Call Back'];

const googleG = `<svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/><path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/><path fill="#FBBC05" d="M11.69 28.18A13.99 13.99 0 0 1 10.94 24c0-1.45.25-2.86.7-4.18v-5.7H4.34A21.99 21.99 0 0 0 2 24c0 3.55.85 6.91 2.34 9.88l7.35-5.7z"/><path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/></svg>`;
const star = '<svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15 9 22 9.5 17 14.5 18.5 22 12 18 5.5 22 7 14.5 2 9.5 9 9"/></svg>';
const starsRow = star.repeat(5);
---

<section class="lp-hero lp-hero-premium">
  <div class="container lp-hero-grid">
    <div class="lp-hero-copy">
      <div class="lp-hero-top">
        <span class="eyebrow eyebrow-hero">{p.eyebrow}</span>
        <span class="lp-rating" role="img" aria-label={`Rated ${p.rating.score} out of 5 from ${p.rating.count} Google reviews`}>
          <Fragment set:html={googleG} />
          <span class="lp-stars" aria-hidden="true">
            <span class="lp-stars-bg" set:html={starsRow} />
            <span class="lp-stars-fg" style={`width:${ratingPct}%`} set:html={starsRow} />
          </span>
          <span class="lp-rating-text" aria-hidden="true">Google reviews</span>
        </span>
      </div>

      <h1>{lp.h1}</h1>
      <p class="lp-sub">{lp.sub}</p>

      <div class="lp-cta">
        <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
          <PhoneIcon /> Call {site.booking.display}
        </a>
        <a href={site.whatsapp.url} target="_blank" rel="noopener" class="btn btn-outline btn-lg">
          <WhatsAppIcon /> {p.whatsappLabel ?? 'WhatsApp us a photo'}
        </a>
      </div>

      {lp.offer && (
        <a href="#enquiry" class="lp-offer-chip">
          <span class="lp-offer-chip-tag">Offer</span>
          <span>£25 off your first call-out for new customers</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      )}

      <ul class="lp-proof">
        {p.proof.map((it) => (
          <li>
            <span class="lp-proof-icon" set:html={icon(it.icon)} />
            <span class="lp-proof-text">
              <strong>{it.label}</strong>
              <small>{it.note}</small>
            </span>
          </li>
        ))}
      </ul>

      <p class="lp-hours">{site.hours.office} &middot; {site.hours.emergency}</p>
    </div>

    <div class="lp-form-card lp-form-card-premium">
      {lp.offer && (
        <div class="lp-ticket">
          <span class="lp-ticket-amount">£25 off</span>
          <span class="lp-ticket-text">
            <strong>your first call-out</strong>
            <small>{lp.offer.disclaimer}</small>
          </span>
        </div>
      )}
      <h2>{p.form.title}</h2>
      <p class="lp-form-sub">{p.form.sub}</p>
      <EnquiryForm service={serviceTitle} extraOption={lp.formLabel ?? ''} submitLabel={p.form.submit} ctaVariants={ctaVariants} />
      <p class="lp-form-note">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        {p.form.note}
      </p>
    </div>
  </div>
</section>

<section class="lp-cred" aria-label="Credentials">
  <div class="container">
    <ul class="lp-cred-list">
      <li class="lp-cred-rating">
        <span class="lp-cred-g" set:html={googleG} />
        <span class="lp-cred-text">
          <strong>Google reviews</strong>
          <span class="lp-stars lp-stars-dark" role="img" aria-label={`Rated ${p.rating.score} out of 5 on Google`}>
            <span class="lp-stars-bg" set:html={starsRow} />
            <span class="lp-stars-fg" style={`width:${ratingPct}%`} set:html={starsRow} />
          </span>
        </span>
      </li>
      <li>
        <span class="lp-cred-icon" set:html={icon('shield', 20)} />
        <span class="lp-cred-text"><strong>Gas Safe registered</strong><small>Gas work done legally and signed off</small></span>
      </li>
      <li>
        <span class="lp-cred-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/></svg></span>
        <span class="lp-cred-text"><strong>Fully insured</strong><small>Public liability cover on every job</small></span>
      </li>
      <li>
        <span class="lp-cred-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span>
        <span class="lp-cred-text"><strong>DBS-checked engineers</strong><small>Directly employed, never subcontracted</small></span>
      </li>
      <li>
        <span class="lp-cred-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><path d="M9 21v-6h6v6"/></svg></span>
        <span class="lp-cred-text"><strong>Established {site.established}</strong><small>{site.legalName}, Company No. {site.companyNumber}</small></span>
      </li>
    </ul>
  </div>
</section>

<slot name="reviews" />

<section class="section">
  <div class="container">
    <div class="section-head center-head">
      <span class="eyebrow">{p.fixes.eyebrow}</span>
      <h2>{p.fixes.title}</h2>
      <p class="lead">{p.fixes.lead}</p>
    </div>
    <ul class="lp-fixes">
      {p.fixes.items.map((f) => (
        <li>
          <span class="lp-fix-icon" set:html={icon(f.icon, 24)} />
          <h3>{f.title}</h3>
          <p>{f.note}</p>
        </li>
      ))}
    </ul>
    {lp.crossLink && (
      <p class="lp-crosslink lp-crosslink-center">
        <strong>{lp.crossLink.label}</strong> {lp.crossLink.body}{' '}
        <a href={lp.crossLink.href}>See {lp.crossLink.href.split('/').pop()?.replace(/-/g, ' ')} &rarr;</a>
      </p>
    )}
  </div>
</section>

<section class="section section-alt lp-diag">
  <div class="container lp-diag-grid">
    <div class="lp-diag-panel" aria-hidden="true">
      {p.diagnosis.art === 'gauge' && (
      <svg class="lp-art lp-gauge" viewBox="0 0 320 260">
        <defs>
          <linearGradient id="gaugeFace" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#0F4A72"/>
            <stop offset="1" stop-color="#072A42"/>
          </linearGradient>
        </defs>
        <!-- dial face -->
        <circle cx="160" cy="150" r="112" fill="url(#gaugeFace)" stroke="#B9C9D8" stroke-width="6"/>
        <circle cx="160" cy="150" r="98" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1.5"/>
        <!-- zones: red (low), amber, green (good) -->
        <path d="M66 150 A94 94 0 0 1 93.5 83.5" fill="none" stroke="#E0533D" stroke-width="12" stroke-linecap="butt"/>
        <path d="M93.5 83.5 A94 94 0 0 1 160 56" fill="none" stroke="#F2A93B" stroke-width="12"/>
        <path d="M160 56 A94 94 0 0 1 254 150" fill="none" stroke="#3FA66B" stroke-width="12"/>
        <!-- ticks -->
        <g stroke="#CFE0EC" stroke-width="2.5" stroke-linecap="round">
          <line x1="66" y1="150" x2="80" y2="150"/>
          <line x1="93.5" y1="83.5" x2="103.4" y2="93.4"/>
          <line x1="160" y1="56" x2="160" y2="70"/>
          <line x1="226.5" y1="83.5" x2="216.6" y2="93.4"/>
          <line x1="254" y1="150" x2="240" y2="150"/>
        </g>
        <text x="86" y="176" fill="#F5B9AE" font-family="Inter, sans-serif" font-size="12" font-weight="700">LOW</text>
        <text x="212" y="176" fill="#BDEBCF" font-family="Inter, sans-serif" font-size="12" font-weight="700">GOOD</text>
        <text x="160" y="205" text-anchor="middle" fill="#CFE0EC" font-family="Inter, sans-serif" font-size="11" letter-spacing="2">BAR</text>
        <!-- needle -->
        <g class="lp-needle">
          <polygon points="160,150 154,150 160,66 166,150" fill="#F26419"/>
          <circle cx="160" cy="150" r="9" fill="#F26419" stroke="#FFD9B8" stroke-width="3"/>
        </g>
      </svg>
      )}
      {p.diagnosis.art === 'toilet' && (
      <svg class="lp-art lp-loo" viewBox="0 0 320 260">
        <defs>
          <linearGradient id="looWater" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#8FD3FF"/>
            <stop offset="1" stop-color="#2E86C1"/>
          </linearGradient>
          <clipPath id="looCistern"><rect x="92" y="40" width="136" height="88" rx="10"/></clipPath>
        </defs>
        <!-- cistern -->
        <rect x="92" y="40" width="136" height="88" rx="10" fill="#0F4A72" stroke="#B9C9D8" stroke-width="5"/>
        <g clip-path="url(#looCistern)">
          <rect class="lp-loo-water" x="92" y="40" width="136" height="88" fill="url(#looWater)" opacity="0.85"/>
        </g>
        <!-- float arm and ball -->
        <g class="lp-loo-float">
          <line x1="120" y1="70" x2="185" y2="80" stroke="#EAF1F7" stroke-width="4" stroke-linecap="round"/>
          <circle cx="188" cy="82" r="12" fill="#EAF1F7"/>
        </g>
        <rect x="112" y="56" width="10" height="66" rx="4" fill="#B9C9D8"/>
        <!-- push button -->
        <rect x="140" y="28" width="40" height="14" rx="6" fill="#EAF1F7"/>
        <!-- pan -->
        <path d="M84 138 h152 v18 a48 48 0 0 1 -48 48 h-56 a48 48 0 0 1 -48 -48 z" fill="#EAF1F7"/>
        <path d="M84 138 h152 v18 a48 48 0 0 1 -48 48 h-56 a48 48 0 0 1 -48 -48 z" fill="none" stroke="#B9C9D8" stroke-width="4"/>
        <ellipse cx="160" cy="156" rx="52" ry="12" fill="#2E86C1" opacity="0.55"/>
        <rect x="120" y="204" width="80" height="20" rx="6" fill="#B9C9D8"/>
        <!-- fixed tick -->
        <g class="lp-loo-tick">
          <circle cx="252" cy="196" r="24" fill="#2E8B57"/>
          <polyline points="240,197 249,206 265,188" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
        </g>
      </svg>
      )}
      {p.diagnosis.art === 'certificate' && (
      <svg class="lp-art lp-cert" viewBox="0 0 320 260">
        <!-- house outline behind -->
        <path d="M40 120 L110 62 L180 120" fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M56 110 v78 h108 v-78" fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- certificate sheet -->
        <rect x="118" y="44" width="164" height="196" rx="10" fill="#EAF1F7"/>
        <rect x="118" y="44" width="164" height="22" rx="10" fill="#B9C9D8"/>
        <rect x="118" y="56" width="164" height="10" fill="#B9C9D8"/>
        <text x="200" y="60" text-anchor="middle" fill="#0B3C5D" font-family="Inter, sans-serif" font-size="10" font-weight="700" letter-spacing="1.5">GAS SAFETY RECORD</text>
        <!-- lines that draw in -->
        <g stroke="#0B3C5D" stroke-width="6" stroke-linecap="round" class="lp-cert-lines">
          <line class="lp-cert-line" x1="138" y1="90" x2="250" y2="90"/>
          <line class="lp-cert-line" x1="138" y1="112" x2="230" y2="112"/>
          <line class="lp-cert-line" x1="138" y1="134" x2="256" y2="134"/>
          <line class="lp-cert-line" x1="138" y1="156" x2="216" y2="156"/>
        </g>
        <text x="138" y="196" fill="#54646F" font-family="Inter, sans-serif" font-size="10" font-weight="600">RENEW IN 12 MONTHS</text>
        <!-- stamp -->
        <g class="lp-cert-stamp">
          <circle cx="240" cy="200" r="28" fill="#2E8B57"/>
          <circle cx="240" cy="200" r="22" fill="none" stroke="#fff" stroke-width="2.5" stroke-dasharray="3 3"/>
          <polyline points="227,201 236,210 254,190" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
        </g>
      </svg>
      )}
      {p.diagnosis.art === 'leak' && (
      <svg class="lp-art lp-leak" viewBox="0 0 320 260">
        <defs>
          <linearGradient id="leakWall" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#EAF1F7"/><stop offset="1" stop-color="#C3D2DF"/>
          </linearGradient>
        </defs>
        {/* wall section with a pipe buried behind it */}
        <rect x="30" y="30" width="260" height="150" rx="6" fill="url(#leakWall)"/>
        <g stroke="#AFC2D2" stroke-width="2" opacity="0.75">
          <line x1="30" y1="80" x2="290" y2="80"/><line x1="30" y1="130" x2="290" y2="130"/>
          <line x1="100" y1="30" x2="100" y2="80"/><line x1="190" y1="30" x2="190" y2="80"/>
          <line x1="145" y1="80" x2="145" y2="130"/><line x1="235" y1="80" x2="235" y2="130"/>
          <line x1="100" y1="130" x2="100" y2="180"/><line x1="200" y1="130" x2="200" y2="180"/>
        </g>
        {/* the hidden pipe and its leak point */}
        <path d="M55 155 h90 a10 10 0 0 0 10-10 V95" fill="none" stroke="#7F97AC" stroke-width="11" stroke-linecap="round"/>
        <circle class="lp-leak-source" cx="155" cy="120" r="7" fill="#2E86C1"/>
        {/* damp patch spreading from it */}
        <ellipse class="lp-damp" cx="155" cy="130" rx="40" ry="30" fill="#2E86C1" opacity="0.2"/>
        {/* detector sweeping the wall */}
        <circle class="lp-scan lp-scan-1" cx="155" cy="120" r="22" fill="none" stroke="#F26419" stroke-width="3"/>
        <circle class="lp-scan lp-scan-2" cx="155" cy="120" r="22" fill="none" stroke="#F26419" stroke-width="3"/>
        <g class="lp-detector">
          <rect x="228" y="196" width="54" height="36" rx="7" fill="#0F4A72" stroke="#CFE0EC" stroke-width="3"/>
          <rect x="236" y="204" width="38" height="14" rx="3" fill="#8FD3FF"/>
          <circle cx="247" cy="226" r="3" fill="#CFE0EC"/><circle cx="263" cy="226" r="3" fill="#CFE0EC"/>
        </g>
        <text x="60" y="222" fill="#CFE0EC" font-family="Inter, sans-serif" font-size="12" font-weight="700">FOUND, NOT GUESSED</text>
      </svg>
      )}
      {p.diagnosis.art === 'pipes' && (
      <svg class="lp-art lp-pipes" viewBox="0 0 320 260">
        <defs>
          <linearGradient id="pipeMetal" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#EAF1F7"/><stop offset="0.55" stop-color="#B9C9D8"/><stop offset="1" stop-color="#7F97AC"/>
          </linearGradient>
        </defs>
        {/* a run of pipework with joints */}
        <path d="M30 70 h110 a18 18 0 0 1 18 18 v54 a18 18 0 0 0 18 18 h114" fill="none" stroke="url(#pipeMetal)" stroke-width="20" stroke-linecap="round"/>
        <rect x="120" y="58" width="18" height="24" rx="3" fill="#7F97AC"/>
        <rect x="148" y="150" width="24" height="18" rx="3" fill="#7F97AC"/>
        <rect x="246" y="148" width="18" height="24" rx="3" fill="#7F97AC"/>
        {/* isolation valve with a handle that turns */}
        <g class="lp-valve-turn">
          <rect x="70" y="46" width="10" height="18" rx="3" fill="#C2500F"/>
          <rect x="56" y="36" width="38" height="12" rx="6" fill="#F26419"/>
        </g>
        {/* the drip that stops once it is tightened */}
        <g class="lp-pipe-drop"><path d="M160 172 c-6 9 -6 16 0 16 c6 0 6 -7 0 -16z" fill="#8FD3FF"/></g>
        {/* tick that lands when the job is done */}
        <g class="lp-pipe-ok">
          <circle cx="252" cy="212" r="24" fill="#2E8B57"/>
          <polyline points="240,213 249,222 265,204" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
        </g>
        <text x="34" y="218" fill="#CFE0EC" font-family="Inter, sans-serif" font-size="12" font-weight="700">TIGHTENED, TESTED, TIDIED</text>
      </svg>
      )}
      {p.diagnosis.art === 'tap' && (
      <svg class="lp-art lp-tap" viewBox="0 0 320 260">
        <defs>
          <linearGradient id="tapMetal" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#EAF1F7"/>
            <stop offset="0.55" stop-color="#B9C9D8"/>
            <stop offset="1" stop-color="#7F97AC"/>
          </linearGradient>
          <linearGradient id="tapDrop" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#8FD3FF"/>
            <stop offset="1" stop-color="#2E86C1"/>
          </linearGradient>
        </defs>
        <!-- supply pipe -->
        <rect x="46" y="14" width="22" height="82" rx="11" fill="url(#tapMetal)"/>
        <!-- body -->
        <rect x="36" y="86" width="132" height="26" rx="13" fill="url(#tapMetal)"/>
        <!-- handle -->
        <rect x="94" y="52" width="16" height="40" rx="6" fill="url(#tapMetal)"/>
        <rect x="74" y="40" width="56" height="16" rx="8" fill="url(#tapMetal)"/>
        <!-- spout -->
        <path d="M156 99 h24 a32 32 0 0 1 32 32 v18" fill="none" stroke="url(#tapMetal)" stroke-width="22" stroke-linecap="round"/>
        <rect x="199" y="142" width="26" height="14" rx="4" fill="#7F97AC"/>
        <!-- drops -->
        <g class="lp-drop lp-drop-1"><path d="M212 160 c-7 10 -7 18 0 18 c7 0 7 -8 0 -18z" fill="url(#tapDrop)"/></g>
        <g class="lp-drop lp-drop-2"><path d="M212 160 c-7 10 -7 18 0 18 c7 0 7 -8 0 -18z" fill="url(#tapDrop)"/></g>
        <g class="lp-drop lp-drop-3"><path d="M212 160 c-7 10 -7 18 0 18 c7 0 7 -8 0 -18z" fill="url(#tapDrop)"/></g>
        <!-- ripples -->
        <ellipse class="lp-ring lp-ring-1" cx="212" cy="236" rx="10" ry="3" fill="none" stroke="#8FD3FF" stroke-width="2"/>
        <ellipse class="lp-ring lp-ring-2" cx="212" cy="236" rx="10" ry="3" fill="none" stroke="#8FD3FF" stroke-width="2"/>
        <ellipse cx="212" cy="236" rx="34" ry="5" fill="#2E86C1" opacity="0.35"/>
      </svg>
      )}
      <p class="lp-diag-tag">{p.diagnosis.tag}</p>
    </div>
    <div class="lp-diag-copy">
      <span class="eyebrow">{p.diagnosis.eyebrow}</span>
      <h2>{p.diagnosis.title}</h2>
      <p class="lead">{p.diagnosis.intro}</p>
      <ul class="lp-diag-points">
        {lp.reassure.map((r) => (
          <li>
            <span class="lp-diag-tick"><Tick size={16} /></span>
            <div>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head center-head">
      <span class="eyebrow">How it works</span>
      <h2>No mystery, no surprise invoice</h2>
    </div>
    <ol class="steps lp-steps">
      {p.steps.map((s) => (
        <li class="step">
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section section-alt">
  <div class="container areas-band">
    <div>
      <span class="eyebrow">Areas we cover</span>
      <h2>Plumbers across London</h2>
      <p class="measure">Our engineers work across the London boroughs, from the City and Westminster out to Croydon, Harrow and Enfield. The office is in Fulham.</p>
      <p class="lp-areas-text">
        {topAreas.map((a) => a.name).join(', ')}, and {areas.length - topAreas.length} more areas across London.
      </p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container measure-wide">
    <h2>Questions</h2>
    <div class="faqs">
      {lp.faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section section-navy lp-close">
  <div class="container lp-close-inner">
    {lp.offer && <span class="eyebrow eyebrow-hero">New-customer offer</span>}
    <h2>{p.close.title}</h2>
    <p class="lp-close-body">{p.close.body}</p>
    {lp.offer && <p class="lp-close-terms">{lp.offer.disclaimer}</p>}
    <div class="cta-row center-row">
      <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
        <PhoneIcon /> Call {site.booking.display}
      </a>
      <a href={site.whatsapp.url} target="_blank" rel="noopener" class="btn btn-outline btn-lg">
        <WhatsAppIcon /> WhatsApp us
      </a>
    </div>
    <p class="lp-close-alt">Prefer to write? <a href="#enquiry">Send the booking form</a> and we&rsquo;ll come back to you with a price.</p>
  </div>
</section>
