---
// The claims the business has confirmed, in a strip under the hero.
// Replaces the separate emergency banner and the bullet list that used to sit
// inside the hero copy on the homepage — one row, not three places.
const items = [
  {
    label: 'Gas Safe registered',
    note: 'Legal, signed-off gas work, every time',
    icon: '<path d="M12 2l7 4v6c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-4z"/><polyline points="9 12 11 14 15 10"/>',
  },
  {
    label: 'Fully insured',
    note: 'Public liability insurance on every job',
    icon: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/>',
  },
  {
    label: 'DBS-checked engineers',
    note: 'Background-checked people in your home',
    icon: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  },
  {
    label: 'Price agreed first',
    note: 'The figure is settled before we begin',
    icon: '<path d="M4 4h16v16H4z"/><path d="M8 12h8M8 8h8M8 16h5"/>',
  },
  {
    label: 'F-Gas certified',
    note: 'Qualified for air con refrigerant work',
    icon: '<line x1="12" y1="2" x2="12" y2="22"/><line x1="4.93" y1="7" x2="19.07" y2="17"/><line x1="19.07" y1="7" x2="4.93" y2="17"/>',
  },
  {
    label: 'Workmanship guaranteed',
    note: 'Every job is backed by our guarantee',
    icon: '<circle cx="12" cy="9" r="6"/><polyline points="8.5 14.5 7 22 12 19.5 17 22 15.5 14.5"/>',
  },
];
---
<section class="trust" aria-label="Why choose Ninja">
  <div class="container">
    <ul class="trust-grid">
      {items.map((it) => (
        <li>
          <span class="trust-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={it.icon} />
          </span>
          <span class="trust-text">
            <strong>{it.label}</strong>
            <small>{it.note}</small>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
