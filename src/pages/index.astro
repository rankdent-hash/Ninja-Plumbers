---
/*
 * Home page, rebuilt to the "Ninja Plumbers Redesign" canvas (Home — desktop
 * 1440 / Home — mobile 390).
 *
 * Copy is unchanged. The canvas carried placeholder content of its own —
 * "family-run since 2012", a "£25 off online bookings" offer, a
 * "4.9 · 180+ Google reviews" badge, "[FROM £]" on every service card and a
 * Gas Safe registration number — and none of that is in this repo's data, so
 * none of it is published here. What the site already says, and the sections
 * that say it (the problem finder, "The first few minutes", the FAQs), are
 * kept and restyled.
 *
 * Reviews render only when a real approved testimonial exists, which is the
 * rule the rest of the site already follows — see ReviewsCarousel.astro and
 * reviews.astro.
 */
import Ninja from '../layouts/Ninja.astro';
import NinjaIcon from '../components/ninja/NinjaIcon.astro';
import NinjaQuoteCard from '../components/ninja/NinjaQuoteCard.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import Schema from '../components/Schema.astro';
import site from '../data/site.json';
import { services } from '../data/services';
import { areas } from '../data/areas';
import { home } from '../data/home';
import { blogPosts } from '../data/blog';
import { getApprovedTestimonials } from '../lib/testimonials';

// Eight services across the grid, from the data file rather than hand-copied,
// so a card can never drift from the page it links to.
const featured = [
  'emergency-plumbing', 'boiler-repair', 'drain-unblocking', 'leak-detection',
  'bathroom-installation', 'boiler-installation', 'gas-safety-certificate', 'general-plumbing',
].map((slug) => services.find((s) => s.slug === slug)!);

const topAreas = [...areas].sort((a, b) => b.volume - a.volume).slice(0, 10);

// Posts are scheduled ahead; only show ones whose date has arrived.
const today = new Date().toISOString().slice(0, 10);
const latestPosts = blogPosts.filter((p) => p.date && p.date <= today).slice(0, 3);

const testimonials = await getApprovedTestimonials();
---
<Ninja
  title="London Plumbers | Heating &amp; Drainage | Ninja Plumbers"
  description={`London plumbers for emergencies, boiler repair, blocked drains and bathroom fits. Gas Safe registered, fully insured. Call ${site.booking.display}.`}
  schema
>
<Schema slot="head" faqs={home.faq.items} />

{/* ---------- Hero ---------- */}
<section class="hero">
  <svg class="hero-rings" viewBox="0 0 600 600" aria-hidden="true">
    <circle cx="300" cy="300" r="118"/><circle cx="300" cy="300" r="178"/>
    <circle cx="300" cy="300" r="238"/><circle cx="300" cy="300" r="296"/>
  </svg>

  <div class="shell">
    <div>
      <span class="hero-chip"><span class="dot"></span>Emergency callout 24/7</span>
      <h1>London plumbers who show up, quote before starting and do the job properly</h1>
      <p class="lead">
        Whether your boiler gave up overnight or you want a whole bathroom refitted, Ninja
        Plumbers covers homes and businesses across London. When it can&rsquo;t wait until
        morning, we don&rsquo;t make you wait.
      </p>

      <ul class="hero-bullets">
        <li><NinjaIcon name="check" />Fully insured and on the Gas Safe Register</li>
        <li><NinjaIcon name="check" />Price agreed before any work starts</li>
        <li><NinjaIcon name="check" />Directly employed, DBS-checked engineers</li>
        <li><NinjaIcon name="check" />Workmanship guaranteed</li>
      </ul>

      <div class="hero-actions">
        <a class="btn btn-light btn-lg" href={`tel:${site.booking.tel}`}>
          <NinjaIcon name="phone" /> Call {site.booking.display}
        </a>
        <a class="btn btn-wa btn-lg" href={site.whatsapp.url} target="_blank" rel="noopener">
          <NinjaIcon name="whatsapp" /> WhatsApp us
        </a>
      </div>

      <p class="hero-hours">
        <span><NinjaIcon name="clock" />Office {site.hours.office}</span>
        <span><NinjaIcon name="pin" />{site.address.line1}, {site.address.postcode}</span>
        <span><NinjaIcon name="headset" />A real person answers the phone</span>
      </p>
    </div>

    <NinjaQuoteCard
      heading="Tell us about the job"
      intro="We'll call you back about the work and the price."
      submitLabel="Send enquiry"
      trust={['No obligation', 'Price agreed before work starts']}
    />
  </div>
</section>

{/* ---------- Trust strip ---------- */}
<section class="trust">
  <div class="shell">
    <div class="trust-grid">
      <div>
        <span class="ti"><NinjaIcon name="shield" /></span>
        <span><strong>Gas Safe registered</strong><small>Every gas job done by a registered engineer</small></span>
      </div>
      <div>
        <span class="ti"><NinjaIcon name="lock" /></span>
        <span><strong>Price agreed first</strong><small>You approve the quote before we start</small></span>
      </div>
      <div>
        <span class="ti"><NinjaIcon name="clock" /></span>
        <span><strong>Emergency callout 24/7</strong><small>Across Greater London and Surrey</small></span>
      </div>
      <div>
        <span class="ti"><NinjaIcon name="check" /></span>
        <span><strong>Guaranteed workmanship</strong><small>Fully insured, DBS-checked engineers</small></span>
      </div>
    </div>
  </div>
</section>

{/* ---------- Services ---------- */}
<section class="section">
  <div class="shell">
    <div class="section-head center">
      <p class="eyebrow">Our services</p>
      <h2>From a dripping tap to a brand-new boiler</h2>
      <p>One team for plumbing, heating, drainage and electrics, right across the London boroughs.</p>
    </div>

    <div class="grid-4">
      {featured.map((s) => (
        <a class="svc-card" href={`/services/${s.slug}`}>
          <span class="badge badge-sm">
            <span class="disc"></span>
            <span class="ring"></span>
            <ServiceIcon name={s.icon} />
          </span>
          <h3 set:html={s.title} />
          <p>{s.summary}</p>
          <span class="go">See the service <NinjaIcon name="arrow" /></span>
        </a>
      ))}
    </div>

    <p style="text-align:center;margin:36px 0 0">
      <a class="btn btn-outline" href="/services">See all {services.length} services</a>
    </p>
  </div>
</section>

{/* ---------- Problem finder ---------- */}
<section class="section section-cream">
  <div class="shell">
    <div class="section-head">
      <p class="eyebrow">{home.problemFinder.eyebrow}</p>
      <h2>{home.problemFinder.heading}</h2>
      <p>{home.problemFinder.intro}</p>
    </div>

    <ul class="related">
      {home.problemFinder.items.map((p) => (
        <li>
          <a href={p.href}>
            <span style="display:block">
              {p.label}
              <small style="display:block;font-weight:500;color:var(--muted);margin-top:4px">{p.hint}</small>
            </span>
            <NinjaIcon name="arrow" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ---------- How it works ---------- */}
<section class="section">
  <div class="shell">
    <div class="split">
      <div>
        <p class="eyebrow">The process</p>
        <h2>A clear process and no unexpected bill</h2>
        <ol class="steps" style="grid-template-columns:1fr;margin-top:28px">
          <li class="step">
            <span class="n">1</span>
            <h3>Describe the problem</h3>
            <p>Call the booking line, or WhatsApp us a photo. When we can see the fault before the van leaves, the engineer is more likely to arrive with the right parts on the first visit.</p>
          </li>
          <li class="step">
            <span class="n">2</span>
            <h3>You get the price up front</h3>
            <p>You&rsquo;ll know the cost before any tools come out. Should we uncover something that changes the job, we pause and talk it over with you instead of pressing on.</p>
          </li>
          <li class="step">
            <span class="n">3</span>
            <h3>The repair, then the tidy-up</h3>
            <p>We complete the work, test it and leave things tidy. Any gas work is done by Gas Safe registered engineers, with a certificate issued wherever one is required.</p>
          </li>
        </ol>
      </div>

      <div class="photo">
        <img src="/images/home/ninja-vans-on-the-road.webp" width="1600" height="1200"
             alt="A dark grey van and a white van in Ninja Plumbers livery, showing the phone number and website, parked on a London high street"
             loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

{/* ---------- Safety ---------- */}
<section class="section section-white" aria-labelledby="safety-heading">
  <div class="shell">
    <div class="section-head center">
      <p class="eyebrow">Before we arrive</p>
      <h2 id="safety-heading">{home.safety.heading}</h2>
    </div>

    <div class="guidance">
      {home.safety.items.map((it) => (
        <div class="guidance-item">
          <h3>{it.title}</h3>
          <p>{it.body}</p>
        </div>
      ))}
    </div>

    <div class="callout" style="margin-top:24px">
      <NinjaIcon name="alert" />
      <p><a href={`tel:${site.booking.tel}`}>{home.safety.note}</a></p>
    </div>
  </div>
</section>

{/* ---------- Reviews — only when a real one has been approved ---------- */}
{testimonials.length > 0 && (
  <section class="section section-cream" aria-label="Google reviews">
    <div class="shell">
      <div class="section-head center">
        <p class="eyebrow">Customer feedback</p>
        <h2>Our Google reviews</h2>
      </div>
      <div class="grid-3">
        {testimonials.slice(0, 3).map((t) => (
          <div class="review">
            <span class="stars" aria-label={`${t.rating} out of 5`}>{'★'.repeat(t.rating)}</span>
            <p>{t.text}</p>
            <span class="who"><b>{t.name.slice(0, 1)}</b>{t.name}</span>
          </div>
        ))}
      </div>
      <p style="text-align:center;margin:24px 0 0">
        <a class="btn btn-outline" href="/reviews">Read the reviews</a>
      </p>
    </div>
  </section>
)}

{/* ---------- Dark CTA band ---------- */}
<section class="band">
  <div class="shell">
    <div>
      <p class="eyebrow">Emergency? Don&rsquo;t fill in a form</p>
      <h2>Something gone wrong right now?</h2>
      <p>
        Water coming through the ceiling, a smell of gas, no heating at all &mdash; call us.
        The office is open {site.hours.office}, and emergency callout runs 24/7.
      </p>
      <a class="phone-big" href={`tel:${site.booking.tel}`}>
        <span class="pi"><NinjaIcon name="phone" /></span>{site.booking.display}
      </a>
    </div>
    <div class="actions">
      <a class="btn btn-light btn-lg" href={`tel:${site.booking.tel}`}>Call now</a>
      <a class="btn btn-wa btn-lg" href={site.whatsapp.url} target="_blank" rel="noopener">
        WhatsApp a photo of the problem
      </a>
      <a class="btn btn-ghost" href="#enquiry">Not urgent? Get a quote</a>
    </div>
  </div>
</section>

{/* ---------- Areas ---------- */}
<section class="section">
  <div class="shell">
    <div class="section-head">
      <p class="eyebrow">Coverage</p>
      <h2>Plumbers in the London boroughs</h2>
      <p>
        We send engineers out from the Fulham office to jobs right across the London boroughs,
        from the City and Westminster through to Croydon, Harrow and Enfield.
      </p>
    </div>

    <ul class="chips" aria-label="Popular areas">
      {topAreas.map((a) => (
        <li><a href={`/areas/${a.slug}`}>{a.name}</a></li>
      ))}
      <li><a href="/areas-we-cover">All {areas.length} areas <NinjaIcon name="arrow" /></a></li>
    </ul>
  </div>
</section>

{/* ---------- Guides ---------- */}
{latestPosts.length > 0 && (
  <section class="section section-white">
    <div class="shell">
      <div class="section-head center">
        <p class="eyebrow">{home.guides.eyebrow}</p>
        <h2>{home.guides.heading}</h2>
        <p>{home.guides.intro}</p>
      </div>
      <div class="grid-3">
        {latestPosts.map((p) => (
          <a class="svc-card" style="align-items:flex-start;text-align:left" href={`/blog/${p.slug}`}>
            <h3 style="margin-top:0">{p.title}</h3>
            <p>{p.excerpt}</p>
            <span class="go">Open the guide <NinjaIcon name="arrow" /></span>
          </a>
        ))}
      </div>
      <p style="text-align:center;margin:36px 0 0">
        <a class="btn btn-outline" href="/blog">See every guide</a>
      </p>
    </div>
  </section>
)}

{/* ---------- FAQ ---------- */}
<section class="section section-cream">
  <div class="shell">
    <div class="section-head center">
      <p class="eyebrow">Good to know</p>
      <h2>{home.faq.heading}</h2>
    </div>
    <div class="faq">
      {home.faq.items.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}<NinjaIcon name="chevron" /></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

</Ninja>
