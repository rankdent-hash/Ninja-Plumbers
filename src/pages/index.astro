---
import Base from '../layouts/Base.astro';
import HeroWithForm from '../components/HeroWithForm.astro';
import TrustBar from '../components/TrustBar.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import Tick from '../components/Tick.astro';
import PhoneIcon from '../components/PhoneIcon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import site from '../data/site.json';
import { services } from '../data/services';
import { areas } from '../data/areas';
import { home } from '../data/home';
import { blogPosts } from '../data/blog';
import Schema from '../components/Schema.astro';

// Six services on the homepage, from the data file rather than hand-copied,
// so the cards cannot drift from the pages they link to. The earlier version
// linked four of them to /services#anchor URLs that no longer exist.
const featured = ['emergency-plumbing', 'boiler-repair', 'drain-unblocking',
                  'leak-detection', 'bathroom-installation', 'emergency-electrician']
  .map((slug) => services.find((s) => s.slug === slug)!);

const topAreas = [...areas].sort((a, b) => b.volume - a.volume).slice(0, 10);

// Posts are scheduled ahead; only show ones whose date has arrived. The
// homepage is built at deploy time, so this is as of the last deploy.
const today = new Date().toISOString().slice(0, 10);
const latestPosts = blogPosts.filter((p) => p.date && p.date <= today).slice(0, 3);
---
<Base
  title="London Plumbers | Heating &amp; Drainage | Ninja Plumbers"
  description={`London plumbers for emergencies, boiler repair, blocked drains and bathroom fits. Gas Safe registered, fully insured. Call ${site.booking.display}.`}
  schema
>
<Schema slot="head" faqs={home.faq.items} />

<HeroWithForm
  eyebrow="24/7 emergency callouts available"
  h1="London plumbers who show up, quote before starting and do the job properly"
  intro="Whether your boiler gave up overnight or you want a whole bathroom refitted, Ninja Plumbers covers homes and businesses across London. When it can't wait until morning, we don't make you wait."
  formHeading="Tell us about the job"
  pattern
/>

<TrustBar />
<ReviewsCarousel />

<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{home.problemFinder.eyebrow}</span>
      <h2>{home.problemFinder.heading}</h2>
      <p class="lead measure">{home.problemFinder.intro}</p>
    </div>
    <ul class="problem-grid">
      {home.problemFinder.items.map((p) => (
        <li>
          <a href={p.href} class="problem-link">
            <strong>{p.label}</strong>
            <span>{p.hint}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section section-alt safety-band" aria-labelledby="safety-heading">
  <div class="container">
    <h2 id="safety-heading">{home.safety.heading}</h2>
    <div class="guidance">
      {home.safety.items.map((it) => (
        <div class="guidance-item">
          <h3>{it.title}</h3>
          <p>{it.body}</p>
        </div>
      ))}
    </div>
    <p class="safety-note"><a href={`tel:${site.booking.tel}`}>{home.safety.note}</a></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Our services</span>
      <h2>One team for plumbing, heating, drainage and electrics</h2>
      <p class="lead measure">{home.intros.services}</p>
    </div>

    <ul class="grid grid-3 card-grid">
      {featured.map((s) => (
        <li class="card card-service">
          <div class="icon"><ServiceIcon name={s.icon} /></div>
          <h3><a href={`/services/${s.slug}`} class="card-title-link" set:html={s.title} /></h3>
          <p>{s.summary}</p>
          <a href={`/services/${s.slug}`} class="card-link" aria-hidden="true" tabindex="-1">See the service <span>&rarr;</span></a>
        </li>
      ))}
    </ul>
    <p class="section-foot"><a href="/services" class="btn btn-ghost">Browse every service</a></p>
  </div>
</section>

{/* A visual break between the service cards and the text-heavy sections below
    — the one spot on the page showing the work rather than describing it.
    Each tile links through to the page it illustrates. Captions stick to
    claims made elsewhere on the site (directly employed engineers, Gas Safe
    registration) and describe the type of work rather than one specific job. */}
<section class="section work-band">
  <div class="container">
    <div class="section-head center-head">
      <span class="eyebrow">Out on jobs</span>
      <h2>Ninja engineers at work</h2>
      <p class="lead measure">We don't use subcontractors. Each booking is handled by one of our own directly employed engineers, travelling out from Fulham to homes and premises across the London boroughs.</p>
    </div>

    <div class="work-grid">
      <a class="work-tile work-tile-wide" href="/areas-we-cover">
        <img src="/images/home/ninja-vans-on-the-road.webp" width="1600" height="1200"
             alt="A dark grey van and a white van in Ninja Plumbers livery, showing the phone number and website, parked on a London high street"
             loading="lazy" decoding="async" />
        <span class="work-caption">
          <strong>Ninja vans on London streets</strong>
          <small>Liveried vans and our own engineers, setting out from Fulham</small>
        </span>
      </a>

      <a class="work-tile" href="/services/general-plumbing">
        <img src="/images/home/kitchen-sink-plumbing.webp" width="900" height="675"
             alt="Under a kitchen sink, an engineer fixes the waste pipe, with a protective mat down and the tool bag open"
             loading="lazy" decoding="async" />
        <span class="work-caption">
          <strong>Household plumbing repairs</strong>
          <small>Leaks, taps, sinks and pipes fixed</small>
        </span>
      </a>

      <a class="work-tile" href="/services/boiler-repair">
        <img src="/images/home/boiler-service-gas-safe.webp" width="900" height="675"
             alt="A multimeter in use as an engineer checks the internals of a wall-hung boiler"
             loading="lazy" decoding="async" />
        <span class="work-caption">
          <strong>Gas boiler repairs</strong>
          <small>Only Gas Safe registered engineers take on this work</small>
        </span>
      </a>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Our customers</span>
      <h2>Households and businesses</h2>
    </div>
    <div class="split">
      <div class="split-panel">
        <div class="icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><path d="M9 21v-7h6v7"/></svg></div>
        <h3>In your home</h3>
        <p>Across London, landlords, tenants and homeowners call us about kitchens, bathrooms, toilets, basins, radiators and boilers. That includes a pipe that bursts at eleven at night, too.</p>
        <ul class="ticks">
          <li><Tick /> Day and night emergency repairs</li>
          <li><Tick /> Boiler services and replacements</li>
          <li><Tick /> Fitting bathrooms and en-suites</li>
          <li><Tick /> Repairs and turnarounds for landlords</li>
        </ul>
      </div>
      <div class="split-panel">
        <div class="icon"><ServiceIcon name="commercial" /></div>
        <h3>At your business</h3>
        <p>We look after offices, restaurants, shops and blocks of flats. Visits fit around your opening hours and your tenants, and we report to whoever signs the work off.</p>
        <ul class="ticks">
          <li><Tick /> Plumbing for washrooms and kitchens</li>
          <li><Tick /> Clearing commercial drains</li>
          <li><Tick /> Managing agents&rsquo; reactive repairs</li>
          <li><Tick /> Work outside hours to keep disruption down</li>
        </ul>
        <p class="split-foot"><a href="/services/commercial-plumbing" class="inline-link">Commercial plumbing <span aria-hidden="true">&rarr;</span></a></p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">The process</span>
      <h2>A clear process and no unexpected bill</h2>
    </div>
    <ol class="steps">
      <li class="step">
        <h3>Describe the problem</h3>
        <p>Call the booking line, or WhatsApp us a photo. When we can see the fault before the van leaves, the engineer is more likely to arrive with the right parts on the first visit.</p>
      </li>
      <li class="step">
        <h3>You get the price up front</h3>
        <p>You'll know the cost before any tools come out. Should we uncover something that changes the job, we pause and talk it over with you instead of pressing on.</p>
      </li>
      <li class="step">
        <h3>The repair, then the tidy-up</h3>
        <p>We complete the work, test it and leave things tidy. Any gas work is done by Gas Safe registered engineers, with a certificate issued wherever one is required.</p>
      </li>
    </ol>
  </div>
</section>

<section class="section section-alt">
  <div class="container areas-band">
    <div>
      <span class="eyebrow">Coverage</span>
      <h2>Plumbers in the London boroughs</h2>
      <p class="measure">We send engineers out from the Fulham office to jobs right across the London boroughs. That covers the City and Westminster through to Croydon, Harrow and Enfield.</p>
      <ul class="area-chips" aria-label="Popular areas">
        {topAreas.map((a) => (
          <li><a href={`/areas/${a.slug}`}>{a.name}</a></li>
        ))}
        <li><a href="/areas-we-cover" class="chip-more">All {areas.length} areas <span aria-hidden="true">&rarr;</span></a></li>
      </ul>
    </div>

    <aside class="about-card">
      <span class="eyebrow">About</span>
      <h3>A London company focused on plumbing</h3>
      <p>Ninja Plumbers is {site.legalName}, set up in {site.established} and based in Fulham. We do plumbing, heating and drainage and nothing else. That focus is why we take care over what other trades often skip: arriving when we said, pricing before starting and cleaning up before we go.</p>
      <dl class="about-facts">
        <div><dt>Office</dt><dd>{site.address.line1}, {site.address.postcode}</dd></div>
        <div><dt>Job booking</dt><dd><a href={`tel:${site.booking.tel}`}>{site.booking.display}</a></dd></div>
        <div><dt>Management</dt><dd><a href={`tel:${site.management.tel}`}>{site.management.display}</a></dd></div>
        <div><dt>Hours</dt><dd>{site.hours.office} &middot; emergencies 24/7</dd></div>
      </dl>
      <p class="about-links"><a href="/about" class="inline-link">Company details</a> <a href="/reviews" class="inline-link">Reviews</a></p>
    </aside>
  </div>
</section>

{latestPosts.length > 0 && (
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{home.guides.eyebrow}</span>
        <h2>{home.guides.heading}</h2>
        <p class="lead measure">{home.guides.intro}</p>
      </div>
      <ul class="grid grid-3 card-grid">
        {latestPosts.map((p) => (
          <li class="card">
            <h3><a href={`/blog/${p.slug}`} class="card-title-link">{p.title}</a></h3>
            <p>{p.excerpt}</p>
            <a href={`/blog/${p.slug}`} class="card-link" aria-hidden="true" tabindex="-1">Open the guide <span>&rarr;</span></a>
          </li>
        ))}
      </ul>
      <p class="section-foot"><a href="/blog" class="btn btn-ghost">See every guide</a></p>
    </div>
  </section>
)}

<section class="section section-alt">
  <div class="container measure-wide">
    <span class="eyebrow">FAQs</span>
    <h2>{home.faq.heading}</h2>
    <div class="faqs">
      {home.faq.items.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section section-navy">
  <div class="container center measure-wide">
    <h2>Looking for a plumber today?</h2>
    <p>Call the booking line and a real person picks up, someone who can send an engineer your way. For anything urgent, phone us instead of emailing.</p>
    <div class="cta-row center-row">
      <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg"><PhoneIcon /> Call {site.booking.display}</a>
      <a href={site.whatsapp.url} class="btn btn-outline btn-lg"><WhatsAppIcon /> WhatsApp us</a>
    </div>
  </div>
</section>

</Base>
