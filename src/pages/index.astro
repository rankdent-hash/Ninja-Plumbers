---
import Base from '../layouts/Base.astro';
import HeroWithForm from '../components/HeroWithForm.astro';
import TrustBar from '../components/TrustBar.astro';
import ReviewsCarousel from '../components/ReviewsCarousel.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import Tick from '../components/Tick.astro';
import PhoneIcon from '../components/PhoneIcon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import site from '../data/site.json';
import { services } from '../data/services';
import { areas } from '../data/areas';
import { home } from '../data/home';
import { blogPosts } from '../data/blog';
import Schema from '../components/Schema.astro';

// Six services on the homepage, from the data file rather than hand-copied,
// so the cards cannot drift from the pages they link to. The earlier version
// linked four of them to /services#anchor URLs that no longer exist.
const featured = ['emergency-plumbing', 'boiler-repair', 'drain-unblocking',
                  'leak-detection', 'bathroom-installation', 'general-plumbing']
  .map((slug) => services.find((s) => s.slug === slug)!);

const topAreas = [...areas].sort((a, b) => b.volume - a.volume).slice(0, 10);

// Posts are scheduled ahead; only show ones whose date has arrived. The
// homepage is built at deploy time, so this is as of the last deploy.
const today = new Date().toISOString().slice(0, 10);
const latestPosts = blogPosts.filter((p) => p.date && p.date <= today).slice(0, 3);
---
<Base
  title="London Plumbers | Ninja Plumbers — Plumbing, Heating &amp; Drainage"
  description={`London plumbers for emergencies, boiler repair, blocked drains and bathroom fits. Gas Safe registered, fully insured. Call ${site.booking.display}.`}
  schema
>
<Schema slot="head" faqs={home.faq.items} />

<HeroWithForm
  eyebrow="Emergency callout available 24/7"
  h1="London plumbers who turn up, price the job first, and fix it properly"
  intro="From a boiler that's died overnight to a full bathroom refit — Ninja Plumbers handles it for homes and businesses across London. If it can't wait until morning, neither do we."
  formHeading="Send us the job"
  pattern
/>

<TrustBar />
<ReviewsCarousel />

<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{home.problemFinder.eyebrow}</span>
      <h2>{home.problemFinder.heading}</h2>
      <p class="lead measure">{home.problemFinder.intro}</p>
    </div>
    <ul class="problem-grid">
      {home.problemFinder.items.map((p) => (
        <li>
          <a href={p.href} class="problem-link">
            <strong>{p.label}</strong>
            <span>{p.hint}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section section-alt safety-band" aria-labelledby="safety-heading">
  <div class="container">
    <h2 id="safety-heading">{home.safety.heading}</h2>
    <div class="guidance">
      {home.safety.items.map((it) => (
        <div class="guidance-item">
          <h3>{it.title}</h3>
          <p>{it.body}</p>
        </div>
      ))}
    </div>
    <p class="safety-note"><a href={`tel:${site.booking.tel}`}>{home.safety.note}</a></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">What we do</span>
      <h2>Plumbing, heating and drainage &mdash; the whole job</h2>
      <p class="lead measure">{home.intros.services}</p>
    </div>

    <ul class="grid grid-3 card-grid">
      {featured.map((s) => (
        <li class="card card-service">
          <div class="icon"><ServiceIcon name={s.icon} /></div>
          <h3><a href={`/services/${s.slug}`} class="card-title-link" set:html={s.title} /></h3>
          <p>{s.summary}</p>
          <a href={`/services/${s.slug}`} class="card-link" aria-hidden="true" tabindex="-1">Find out more <span>&rarr;</span></a>
        </li>
      ))}
    </ul>
    <p class="section-foot"><a href="/services" class="btn btn-ghost">All our services</a></p>
  </div>
</section>

{/* A visual break between the service cards and the text-heavy sections below
    — the one spot on the page showing the work rather than describing it.
    Each tile links through to the page it illustrates. Captions stick to
    claims made elsewhere on the site (directly employed engineers, Gas Safe
    registration) and describe the type of work rather than one specific job. */}
<section class="section work-band">
  <div class="container">
    <div class="section-head center-head">
      <span class="eyebrow">See us at work</span>
      <h2>Ninja engineers, on the tools</h2>
      <p class="lead measure">No subcontractors — every booking goes to one of our own directly employed engineers, out on jobs across the London boroughs from our Fulham base.</p>
    </div>

    <div class="work-grid">
      <a class="work-tile work-tile-wide" href="/areas-we-cover">
        <img src="/images/home/ninja-vans-on-the-road.webp" width="1600" height="1200"
             alt="Two Ninja Plumbers vans, one dark grey and one white, parked on a London high street with the company phone number and website on the side"
             loading="lazy" decoding="async" />
        <span class="work-caption">
          <strong>Ninja vans, out across London</strong>
          <small>Our own liveried vans and engineers, working from our Fulham base</small>
        </span>
      </a>

      <a class="work-tile" href="/services/general-plumbing">
        <img src="/images/home/kitchen-sink-plumbing.webp" width="900" height="675"
             alt="An engineer working on the waste pipe under a kitchen sink, with a protective mat and tool bag laid out on the floor"
             loading="lazy" decoding="async" />
        <span class="work-caption">
          <strong>General plumbing repairs</strong>
          <small>Leaks, taps, sinks and pipework sorted</small>
        </span>
      </a>

      <a class="work-tile" href="/services/boiler-repair">
        <img src="/images/home/boiler-service-gas-safe.webp" width="900" height="675"
             alt="An engineer testing the inside of a wall-mounted boiler with a multimeter"
             loading="lazy" decoding="async" />
        <span class="work-caption">
          <strong>Gas boiler repairs</strong>
          <small>Every job handled by a Gas Safe registered engineer</small>
        </span>
      </a>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Who we work for</span>
      <h2>Homes and commercial premises</h2>
    </div>
    <div class="split">
      <div class="split-panel">
        <div class="icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><path d="M9 21v-7h6v7"/></svg></div>
        <h3>For your home</h3>
        <p>We work for homeowners, tenants and landlords right across London — kitchens, bathrooms, toilets and basins, radiators and boilers, and yes, the burst pipe at eleven at night.</p>
        <ul class="ticks">
          <li><Tick /> Emergency repairs, day or night</li>
          <li><Tick /> Boiler servicing and replacement</li>
          <li><Tick /> Bathroom and en-suite installation</li>
          <li><Tick /> Landlord repairs and turnarounds</li>
        </ul>
      </div>
      <div class="split-panel">
        <div class="icon"><ServiceIcon name="commercial" /></div>
        <h3>For your business</h3>
        <p>Offices, restaurants, shops and blocks of flats. We work around opening hours and tenants, and report back to whoever needs to sign it off.</p>
        <ul class="ticks">
          <li><Tick /> Washroom and kitchen plumbing</li>
          <li><Tick /> Commercial drain clearance</li>
          <li><Tick /> Reactive repairs for managing agents</li>
          <li><Tick /> Out-of-hours work to avoid disruption</li>
        </ul>
        <p class="split-foot"><a href="/services/commercial-plumbing" class="inline-link">Commercial plumbing <span aria-hidden="true">&rarr;</span></a></p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">How it works</span>
      <h2>No mystery, no surprise invoice</h2>
    </div>
    <ol class="steps">
      <li class="step">
        <h3>Tell us what&rsquo;s wrong</h3>
        <p>Ring the booking line or send a photo over WhatsApp. Knowing what we're dealing with before the van sets off means a better chance of showing up with the right parts first time.</p>
      </li>
      <li class="step">
        <h3>We agree the price first</h3>
        <p>Before an engineer picks up a tool, you'll know what it costs. And if something turns up underneath that changes the job, we stop and talk it through with you rather than carry on.</p>
      </li>
      <li class="step">
        <h3>We fix it and clear up</h3>
        <p>The job gets finished, tested and tidied. Gas work is carried out by Gas Safe registered engineers and certificated where it needs to be.</p>
      </li>
    </ol>
  </div>
</section>

<section class="section section-alt">
  <div class="container areas-band">
    <div>
      <span class="eyebrow">Areas we cover</span>
      <h2>Plumbers across London</h2>
      <p class="measure">From the City and Westminster out to Croydon, Harrow and Enfield, our engineers are on the road across the London boroughs — dispatched from the office in Fulham.</p>
      <ul class="area-chips" aria-label="Popular areas">
        {topAreas.map((a) => (
          <li><a href={`/areas/${a.slug}`}>{a.name}</a></li>
        ))}
        <li><a href="/areas-we-cover" class="chip-more">All {areas.length} areas <span aria-hidden="true">&rarr;</span></a></li>
      </ul>
    </div>

    <aside class="about-card">
      <span class="eyebrow">About</span>
      <h3>A dedicated London plumbing company</h3>
      <p>Ninja Plumbers is {site.legalName}, established {site.established} and based in Fulham. Being focused on plumbing, heating and drainage — and nothing else — is why we care about the things trades usually skip: turning up when we said, pricing before the work, leaving the place clean.</p>
      <dl class="about-facts">
        <div><dt>Office</dt><dd>{site.address.line1}, {site.address.postcode}</dd></div>
        <div><dt>Job booking</dt><dd><a href={`tel:${site.booking.tel}`}>{site.booking.display}</a></dd></div>
        <div><dt>Management</dt><dd><a href={`tel:${site.management.tel}`}>{site.management.display}</a></dd></div>
        <div><dt>Hours</dt><dd>{site.hours.office} &middot; 24/7 emergency</dd></div>
      </dl>
      <p class="about-links"><a href="/about" class="inline-link">More about Ninja</a> <a href="/reviews" class="inline-link">Reviews</a></p>
    </aside>
  </div>
</section>

{latestPosts.length > 0 && (
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{home.guides.eyebrow}</span>
        <h2>{home.guides.heading}</h2>
        <p class="lead measure">{home.guides.intro}</p>
      </div>
      <ul class="grid grid-3 card-grid">
        {latestPosts.map((p) => (
          <li class="card">
            <h3><a href={`/blog/${p.slug}`} class="card-title-link">{p.title}</a></h3>
            <p>{p.excerpt}</p>
            <a href={`/blog/${p.slug}`} class="card-link" aria-hidden="true" tabindex="-1">Read the guide <span>&rarr;</span></a>
          </li>
        ))}
      </ul>
      <p class="section-foot"><a href="/blog" class="btn btn-ghost">All guides</a></p>
    </div>
  </section>
)}

<section class="section section-alt">
  <div class="container measure-wide">
    <span class="eyebrow">Questions</span>
    <h2>{home.faq.heading}</h2>
    <div class="faqs">
      {home.faq.items.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section section-navy">
  <div class="container center measure-wide">
    <h2>Need a plumber today?</h2>
    <p>A real person answers the booking line, and they can actually get an engineer moving toward you. Something urgent? Ring rather than email.</p>
    <div class="cta-row center-row">
      <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg"><PhoneIcon /> Call {site.booking.display}</a>
      <a href={site.whatsapp.url} class="btn btn-outline btn-lg"><WhatsAppIcon /> WhatsApp us</a>
    </div>
  </div>
</section>

</Base>
