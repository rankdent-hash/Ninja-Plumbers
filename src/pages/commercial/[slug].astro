---
// One page per small-business sector (see src/data/sectors.ts). Sits under
// Commercial Plumbing in the breadcrumb and links out to the service pages
// that matter to the sector, then to related sectors.
import Base from '../../layouts/Base.astro';
import HeroWithForm from '../../components/HeroWithForm.astro';
import Schema from '../../components/Schema.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import Tick from '../../components/Tick.astro';
import PhoneIcon from '../../components/PhoneIcon.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import site from '../../data/site.json';
import { sectors, audienceOf, type Sector } from '../../data/sectors';
import { providerRef, WEBSITE_ID } from '../../data/entity';
import { SECTORS_UPDATED } from '../../data/contentDates';
import { services } from '../../data/services';
import { appliances } from '../../data/appliances';
import { dampPages } from '../../data/damp';
import { SCHEMA_AREA_SERVED } from '../../data/serviceArea';
import SectorScene from '../../components/SectorScene.astro';
import TrustBar from '../../components/TrustBar.astro';
import SectorPictogram from '../../components/SectorPictogram.astro';
import { iconForHref, iconForNeed } from '../../data/sectorVisuals';

export function getStaticPaths() {
  return sectors.map((sector) => ({ params: { slug: sector.slug }, props: { sector } }));
}

const { sector } = Astro.props as { sector: Sector };

// Every outbound link must point at a real page, and every related sector
// must exist: a renamed page should fail the build, not leave a dead link.
const known = new Set([
  ...services.map((s) => `/services/${s.slug}`),
  ...appliances.map((a) => `/appliances/${a.slug}`),
  ...dampPages.map((d) => `/damp/${d.slug}`),
  '/heating', '/drainage', '/boilers', '/electrical',
]);
for (const l of sector.links) {
  if (!known.has(l.href) && !l.href.startsWith('/blog/')) throw new Error(`sectors.json: ${sector.slug} links to unknown page ${l.href}`);
}
const related = sector.related.map((slug) => {
  const r = sectors.find((s) => s.slug === slug);
  if (!r) throw new Error(`sectors.json: ${sector.slug} lists unknown related sector ${slug}`);
  return r;
});

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Commercial plumbing', href: '/services/commercial-plumbing' },
  { label: sector.name },
];

const audience = audienceOf(sector);
const Audience = audience.charAt(0).toUpperCase() + audience.slice(1);
const updatedLabel = new Date(`${SECTORS_UPDATED}T12:00:00Z`).toLocaleDateString('en-GB', {
  month: 'long', year: 'numeric', timeZone: 'Europe/London',
});

// The facts a search engine or an AI assistant is most often asked about a
// trade — who, what, where, when, who does the work, price, how to book —
// stated once, plainly, in one place. The same facts are true for every
// sector, so they are composed here from the business's details rather than
// written 40 times, and cannot drift out of step with each other.
const facts = [
  { k: 'Who it is for', v: `${Audience} in London and nearby Surrey` },
  { k: 'What we do', v: 'Plumbing, heating, drainage, electrics and air conditioning, from one team' },
  { k: 'Typical jobs', v: sector.does.slice(0, 4).join('; ') },
  { k: 'Where', v: 'Greater London, plus Guildford, Woking and nearby Surrey and north-east Hampshire towns' },
  { k: 'When', v: 'Planned work early, late or at weekends, around your opening hours. Emergency callout 24/7.' },
  { k: 'Who does the work', v: 'Gas Safe registered engineers, registered electricians and F-Gas certified air conditioning engineers. DBS-checked, directly employed and fully insured.' },
  { k: 'Price', v: 'Agreed with you before any work starts. Workmanship guaranteed. Card or cash.' },
  { k: 'How to book', v: `Call ${site.booking.display}, message us on WhatsApp, or use the form at the top of this page.` },
];

const pageUrl = new URL(`/commercial/${sector.slug}`, Astro.site).href;
const abs = (href: string) => new URL(href, Astro.site).href;
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: sector.h1,
  description: sector.summary,
  serviceType: `Plumbing, heating and electrical services for ${audience}`,
  category: 'Commercial plumbing',
  url: pageUrl,
  audience: { '@type': 'BusinessAudience', audienceType: audience },
  areaServed: SCHEMA_AREA_SERVED,
  provider: providerRef,
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: pageUrl,
    servicePhone: { '@type': 'ContactPoint', telephone: site.booking.tel, contactType: 'customer service', availableLanguage: 'en-GB' },
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `Jobs we take on for ${audience}`,
    itemListElement: sector.does.map((d) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: d } })),
  },
};
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageUrl,
  url: pageUrl,
  name: sector.metaTitle,
  description: sector.metaDescription,
  inLanguage: 'en-GB',
  isPartOf: { '@type': 'WebSite', '@id': WEBSITE_ID, url: site.url, name: site.name },
  about: { '@id': `${pageUrl}#service` },
  dateModified: SECTORS_UPDATED,
  // The short answer and the opening paragraph are the parts written to be
  // read aloud or quoted by an assistant.
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.glance-answer', '.sector-lead'] },
  relatedLink: [...sector.links.map((l) => abs(l.href)), ...related.map((r) => abs(`/commercial/${r.slug}`))],
};
---
<Base title={sector.metaTitle} description={sector.metaDescription}>
  <Schema slot="head" breadcrumb={crumbs} faqs={sector.faqs} extra={[pageSchema, serviceSchema]} />

  <HeroWithForm
    eyebrow={sector.eyebrow}
    h1={sector.heroTitle ?? sector.h1}
    intro={sector.heroSub ?? sector.intro}
    landing
    breadcrumb={crumbs}
    bullets={[
      'Work scheduled around your opening hours',
      'Gas Safe registered and fully insured',
      'DBS-checked, directly employed engineers',
      'Price agreed before work starts',
      'Workmanship guaranteed',
    ]}
    formHeading="Tell us about your premises"
  />

  <TrustBar />

  <section class="section">
    <div class="container service-row">
      <div class="service-copy">
        <span class="eyebrow">What we do</span>
        <h2>{sector.h1}</h2>
        <p class="lead sector-lead">{sector.intro}</p>
        <h3 class="sector-jobs-h">What jobs do we take on for {audience}?</h3>
        <ul class="ticks sector-does">
          {sector.does.map((d) => <li><Tick /> {d}</li>)}
        </ul>
        <h3 class="sector-oneteam">One team, around your hours</h3>
        <p>
          Plumbing, heating, drainage, electrics and air conditioning from one company, so a job
          that needs more than one trade is booked once. We work early, late or at weekends so
          you can keep trading, and the price is agreed before anything starts.
        </p>
      </div>
      <aside class="sector-scene-wrap">
        <SectorScene sector={sector} />
      </aside>
    </div>
  </section>

  <section class="section section-tight" aria-labelledby="glance-h">
    <div class="container">
      <div class="glance">
        <span class="eyebrow">At a glance</span>
        <h2 id="glance-h">Who does plumbing for {audience} in London?</h2>
        <p class="glance-answer">
          Ninja Plumbers does. We are a London plumbing, heating and electrical company with our own
          engineers and electricians, and we look after {audience} across Greater London and nearby
          Surrey, working around your opening hours with the price agreed before anything starts.
        </p>
        <dl class="glance-facts">
          {facts.map((f) => (
            <div>
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))}
        </dl>
        <p class="glance-updated">Page updated <time datetime={SECTORS_UPDATED}>{updatedLabel}</time></p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">What premises like yours need</span>
      <h2>What do {audience} need from their plumbing, heating and electrics?</h2>
      <ul class="grid grid-2 card-grid">
        {sector.needs.map((n) => (
          <li class="card">
            <div class="icon"><ServiceIcon name={n.icon ?? iconForNeed(n.title, n.body)} /></div>
            <h3>{n.title}</h3>
            <p>{n.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="guidance">
        {sector.guidance.map((g) => (
          <div class="guidance-item">
            <h2 class="guidance-h2">{g.title}</h2>
            <p>{g.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h2>Which of our services matter most to {audience}?</h2>
      <ul class="grid grid-3 card-grid">
        {sector.links.map((l) => (
          <li class="card">
            <div class="icon"><ServiceIcon name={iconForHref(l.href)} /></div>
            <h3><a href={l.href} class="card-title-link">{l.label}</a></h3>
            <p>{l.why}</p>
            <a href={l.href} class="card-link" aria-hidden="true" tabindex="-1">Find out more <span>&rarr;</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container measure-wide">
      <span class="eyebrow">Questions</span>
      <h2>Questions about plumbing for {audience}</h2>
      <div class="faqs">
        {sector.faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">Other businesses we work for</span>
      <h2>Related sectors</h2>
      <ul class="grid grid-3 card-grid">
        {related.map((r) => (
          <li class="card">
            <div class="icon"><SectorPictogram slug={r.slug} /></div>
            <h3><a href={`/commercial/${r.slug}`} class="card-title-link">{r.name}</a></h3>
            <p>{r.summary}</p>
          </li>
        ))}
      </ul>
      <p class="section-foot">
        <a href="/services/commercial-plumbing" class="btn btn-ghost">All commercial plumbing</a>
      </p>
    </div>
  </section>

  <section class="section section-navy">
    <div class="container center measure-wide">
      <h2>Need something fixed at your premises?</h2>
      <p>Tell us what the premises are, what is wrong and when you are open, and we will agree a time and a price that work around your business.</p>
      <div class="cta-row center-row">
        <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
          <PhoneIcon /> Call {site.booking.display}
        </a>
        <a href={site.whatsapp.url} class="btn btn-outline btn-lg" target="_blank" rel="noopener">
          <WhatsAppIcon /> WhatsApp us
        </a>
      </div>
      <p class="small">For ongoing maintenance or accounts, call management on <a href={`tel:${site.management.tel}`}>{site.management.display}</a>.</p>
    </div>
  </section>
</Base>
