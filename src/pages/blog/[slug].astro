---
// One page per blog post. Server-rendered (see /blog/index.astro for why),
// reading the single published row matching the requested slug at request
// time — instant once published, unlike the build-time cross-link sections
// on service/appliance/damp pages.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { getSupabaseAdmin } from '../../lib/supabaseAdmin';
import { services } from '../../data/services';
import { appliances } from '../../data/appliances';
import { dampPages } from '../../data/damp';
import ServiceIcon from '../../components/ServiceIcon.astro';
import PhoneIcon from '../../components/PhoneIcon.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import HeroWithForm from '../../components/HeroWithForm.astro';
import Schema from '../../components/Schema.astro';
import { overlap, postHubs } from '../../lib/blogLinks';

const slug = Astro.params.slug;
const supabase = getSupabaseAdmin();

type PostRow = {
  slug: string; title: string; h1: string; meta_title: string; meta_description: string;
  excerpt: string; body: string; hero_image_url: string | null; published_at: string; updated_at: string | null;
  related_services: string[]; related_appliances: string[]; related_damp: string[];
};
type OtherRow = Pick<PostRow, 'slug' | 'title' | 'published_at' | 'related_services' | 'related_appliances' | 'related_damp'>;

let post: PostRow | null = null;
let allOthers: OtherRow[] = [];

if (supabase && slug) {
  const [{ data: postData }, { data: othersData }] = await Promise.all([
    supabase
      .from('blog_posts')
      .select('slug, title, h1, meta_title, meta_description, excerpt, body, hero_image_url, published_at, updated_at, related_services, related_appliances, related_damp')
      .eq('status', 'published')
      .eq('slug', slug)
      .maybeSingle(),
    supabase
      .from('blog_posts')
      .select('slug, title, published_at, related_services, related_appliances, related_damp')
      .eq('status', 'published')
      .neq('slug', slug)
      .order('published_at', { ascending: false }),
  ]);
  post = postData ?? null;
  allOthers = othersData ?? [];
}

if (!post) {
  return new Response('Not found', { status: 404 });
}

// "More advice": the posts sharing the most linked pages with this one, then
// the newest, so readers (and crawlers) move between posts on the same topic.
const others = allOthers
  .map((o, i) => ({ o, i, n: overlap(post!, o) }))
  .sort((a, b) => b.n - a.n || a.i - b.i)
  .slice(0, 4)
  .map((x) => x.o);
const hubLinks = postHubs(post);

const relatedServices = post.related_services.map((s) => services.find((x) => x.slug === s)).filter((x): x is (typeof services)[number] => !!x);
const relatedAppliances = post.related_appliances.map((s) => appliances.find((x) => x.slug === s)).filter((x): x is (typeof appliances)[number] => !!x);
const relatedDamp = post.related_damp.map((s) => dampPages.find((x) => x.slug === s)).filter((x): x is (typeof dampPages)[number] => !!x);

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: post.title },
];

const postUrl = new URL(`/blog/${post.slug}`, Astro.site).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.meta_description,
  datePublished: post.published_at,
  dateModified: post.updated_at || post.published_at,
  mainEntityOfPage: postUrl,
  url: postUrl,
  image: post.hero_image_url || new URL('/images/og-ninja-vans.jpg', Astro.site).href,
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
    logo: { '@type': 'ImageObject', url: new URL('/images/logo.png', Astro.site).href },
  },
};

const fmt = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
---
<Base title={post.meta_title} description={post.meta_description}>
  <Schema slot="head" breadcrumb={crumbs} extra={articleSchema} />

  <HeroWithForm
    eyebrow="Advice"
    h1={post.h1}
    intro={post.excerpt}
    breadcrumb={crumbs}
    bullets={[
      'Gas Safe registered and fully insured',
      'DBS-checked engineers',
      'Emergency callout available 24/7',
      'Price agreed before work starts',
      'Workmanship guaranteed',
    ]}
    formHeading="Need this looked at properly?"
  />

  <section class="section">
    <div class="container measure-wide">
      <p class="blog-post-date">{fmt(post.published_at)}</p>
      {post.hero_image_url && <img class="blog-hero-image" src={post.hero_image_url} alt="" width="1200" height="675" />}
      <div class="blog-body">
        <Fragment set:html={post.body} />
      </div>
      <aside class="blog-about">
        <p>
          From Ninja Plumbers, <a href="/">London plumbers</a> based in Fulham and
          covering <a href="/areas-we-cover">every London borough and the towns around Guildford</a>.
          This guide sits under our {hubLinks.map((h, i) => (
            <>{i > 0 && (i === hubLinks.length - 1 ? ' and ' : ', ')}<a href={h.href}>{h.label}</a></>
          ))}. <a href="/about">More about us</a>.
        </p>
      </aside>
    </div>
  </section>

  {(relatedServices.length > 0 || relatedAppliances.length > 0 || relatedDamp.length > 0) && (
    <section class="section section-alt">
      <div class="container">
        <span class="eyebrow">Related</span>
        <h2>Pages that cover this properly</h2>
        <ul class="grid grid-3 card-grid">
          {relatedServices.map((s) => (
            <li class="card">
              <div class="icon"><ServiceIcon name={s.icon} /></div>
              <h3><a href={`/services/${s.slug}`} class="card-title-link" set:html={s.title} /></h3>
              <p>{s.summary}</p>
              <a href={`/services/${s.slug}`} class="card-link">More on {s.title.replace('&amp;', 'and')} <span aria-hidden="true">&rarr;</span></a>
            </li>
          ))}
          {relatedAppliances.map((a) => (
            <li class="card">
              <div class="icon"><ServiceIcon name={a.icon} /></div>
              <h3><a href={`/appliances/${a.slug}`} class="card-title-link">{a.title}</a></h3>
              <p>{a.summary}</p>
              <a href={`/appliances/${a.slug}`} class="card-link">More on {a.title.toLowerCase()} <span aria-hidden="true">&rarr;</span></a>
            </li>
          ))}
          {relatedDamp.map((d) => (
            <li class="card">
              <div class="icon"><ServiceIcon name={d.icon} /></div>
              <h3><a href={`/damp/${d.slug}`} class="card-title-link">{d.title}</a></h3>
              <p>{d.summary}</p>
              <a href={`/damp/${d.slug}`} class="card-link">More on {d.title.toLowerCase()} <span aria-hidden="true">&rarr;</span></a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {others.length > 0 && (
    <section class="section">
      <div class="container">
        <span class="eyebrow">Keep reading</span>
        <h2>More advice</h2>
        <ul class="combo-links">
          {others.map((p) => (
            <li><a href={`/blog/${p.slug}`}>{p.title}</a></li>
          ))}
        </ul>
        <p><a href="/blog" class="btn btn-navy">All advice</a></p>
      </div>
    </section>
  )}

  <section class="section section-navy">
    <div class="container center measure-wide">
      <h2>Prefer to have it looked at?</h2>
      <p>Tell us what&rsquo;s happening and where you are, and we&rsquo;ll tell you what it costs before anyone starts work.</p>
      <div class="cta-row center-row">
        <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
          <PhoneIcon /> Call {site.booking.display}
        </a>
        <a href={site.whatsapp.url} class="btn btn-outline btn-lg">
          <WhatsAppIcon /> WhatsApp us
        </a>
      </div>
    </div>
  </section>
</Base>
