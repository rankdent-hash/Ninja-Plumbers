---
import Base from '../layouts/Base.astro';
import HeroWithForm from '../components/HeroWithForm.astro';
import site from '../data/site.json';
import Schema from '../components/Schema.astro';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'About' }];
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Ninja Plumbers',
  url: new URL('/about', Astro.site).href,
  about: {
    '@type': 'Plumber',
    name: site.name,
    legalName: site.legalName,
    foundingDate: site.established,
    url: site.url,
    telephone: site.booking.tel,
  },
};

const whatWeDo = [
  { href: '/services/emergency-plumbing', title: 'Emergency plumbing', blurb: 'Burst pipes, major leaks and no water, around the clock.' },
  { href: '/boilers', title: 'Boilers', blurb: 'Repairs, servicing, new boilers and replacements, every make.' },
  { href: '/heating', title: 'Heating', blurb: 'Radiators, cylinders, controls and whole systems.' },
  { href: '/drainage', title: 'Drainage', blurb: 'Blocked drains, CCTV surveys and drain repairs.' },
  { href: '/services/bathroom-installation', title: 'Bathrooms', blurb: 'Full bathroom fits, showers, wet rooms and toilets.' },
  { href: '/damp', title: 'Damp and condensation', blurb: 'Surveys first, then the fix that matches the cause.' },
  { href: '/electrical', title: 'Electrical', blurb: 'Registered electricians: emergencies, EICRs, fuse boxes, rewires and EV chargers.' },
  { href: '/services/air-conditioning-installation', title: 'Air conditioning', blurb: 'Fitted, serviced and repaired by F-Gas certified engineers.' },
  { href: '/appliances', title: 'Appliances and fixtures', blurb: 'Softeners, boiling taps, pumps and more, fitted properly.' },
];
---
<Base
  title="About Us | Ninja Plumbers, London"
  description="Meet Ninja Plumbers, a Fulham-based plumbing company established in 2024. Gas Safe registered and insured, working for homes and businesses across London."
  image="/images/og-ninja-vans.jpg"
>
<Schema slot="head" breadcrumb={crumbs} extra={aboutSchema} />

<HeroWithForm
  eyebrow="About us"
  h1="A London plumbing company, built to do the basics properly"
  intro="Ninja Plumbers is a dedicated London plumbing company based in Fulham. We built the business around the things a lot of trades treat as optional — turning up when we said we would, pricing before the work rather than after, and leaving the place clean enough that you'd struggle to prove we'd been there."
  breadcrumb={crumbs}
  bullets={[
    'Fully insured and on the Gas Safe Register',
    'Engineers with DBS checks',
    '24/7 emergency callouts available',
    'Price agreed before any work begins',
    'Workmanship guaranteed',
  ]}
  formHeading="Tell us about the job"
/>

<section class="section">
  <div class="container service-row">
    <div class="service-copy">
      <span class="eyebrow">Our company</span>
      <h2>A dedicated plumbing team, not a side job</h2>
      <p class="lead">Ninja Plumbers exists to do one thing well: plumbing, heating and drainage across London, carried out by our own engineers rather than passed to a sub-contractor. Being focused on that one job is what lets us hold the standard we set for ourselves.</p>
      <p>That means the things a lot of trades treat as optional — turning up on time, quoting before the work rather than after, and clearing up so thoroughly you'd struggle to prove we'd been there at all.</p>
      <p>Our engineers travel out from the Fulham office to jobs all over Greater London. Landlords, managing agents, tenants, homeowners and commercial premises all use us.</p>
    </div>
    <aside class="service-aside">
      <div class="icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/><path d="M9 8h1"/><path d="M9 12h1"/><path d="M9 16h1"/><path d="M14 8h1"/><path d="M14 12h1"/><path d="M14 16h1"/></svg></div>
      <h3>{site.legalName}</h3>
      <p>Company number {site.companyNumber}, registered in England and Wales.</p>
    </aside>
  </div>
  <div class="container">
    <figure class="about-photo">
      <img src="/images/home/ninja-vans-on-the-road.webp" width="1600" height="1200"
           alt="Two Ninja Plumbers vans, one dark grey and one white, parked on a London high street with the company phone number and website on the side"
           loading="lazy" decoding="async" />
      <figcaption>Two of our vans out on a London high street. If you see the Ninja livery on your road, it's one of our own engineers, not a subcontractor.</figcaption>
    </figure>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <span class="eyebrow">Our standards</span>
    <h2>What we are prepared to promise</h2>
    <p class="measure">Six plain claims, and each one is something we can prove.</p>
    <ul class="grid grid-2 card-grid">
      <li class="card">
        <div class="icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg></div>
        <h3>Gas Safe registered</h3>
        <p>Only Gas Safe registered engineers do our gas work, and it is certificated wherever the job calls for it. At the door, ask to see their card &mdash; a genuine engineer will be happy to show you.</p>
      </li>
      <li class="card">
        <div class="icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
        <h3>Fully insured</h3>
        <p>Every job we do is covered by our insurance, so if something on your property goes wrong, you're not left carrying the cost.</p>
      </li>
      <li class="card">
        <div class="icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg></div>
        <h3>Engineers with DBS checks</h3>
        <p>All of our engineers have been DBS checked. You want that from anyone entering your home, and it counts for even more in managed or tenanted properties.</p>
      </li>
      <li class="card">
        <div class="icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg></div>
        <h3>A price before we begin</h3>
        <p>Before an engineer starts, you are given a price for the job. Should something hidden behind a wall change the work, we pause and discuss it with you instead of carrying on and adding it to the bill later.</p>
      </li>
      <li class="card">
        <div class="icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="2" x2="12" y2="22"/><line x1="4.93" y1="7" x2="19.07" y2="17"/><line x1="19.07" y1="7" x2="4.93" y2="17"/></svg></div>
        <h3>F-Gas certified</h3>
        <p>Work on the refrigerant side of air conditioning is restricted by law to F-Gas certified businesses and engineers. We hold that certification, so installation, servicing and repairs are done legally.</p>
      </li>
      <li class="card">
        <div class="icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="6"/><polyline points="8.5 14.5 7 22 12 19.5 17 22 15.5 14.5"/></svg></div>
        <h3>Workmanship guaranteed</h3>
        <p>We stand behind the work we do. If something we fitted or repaired is not right, call the office and we will come back and put it right.</p>
      </li>
    </ul>
  </div>
</section>

<section class="section">
  <div class="container">
    <span class="eyebrow">Our services</span>
    <h2>The work we take on</h2>
    <p class="measure">Plumbing, heating, drainage and electrical work, from a dripping tap to a new boiler. These are the main areas, and <a href="/services">all our services</a> are listed on one page.</p>
    <ul class="grid grid-3 card-grid">
      {whatWeDo.map((w) => (
        <li class="card">
          <h3><a href={w.href} class="card-title-link">{w.title}</a></h3>
          <p>{w.blurb}</p>
        </li>
      ))}
    </ul>
    <p class="measure" style="margin-top:20px;">We work across Greater London from our Fulham base, and in Guildford, Woking and the towns around them. <a href="/areas-we-cover">See every area we cover</a>.</p>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="coverage-split">
      <div class="check-area">
        <h2>Company details</h2>
        <dl class="detail-list">
          <dt>Registered company</dt>
          <dd>{site.legalName}</dd>
          <dt>Company number</dt>
          <dd>{site.companyNumber}</dd>
          <dt>Office</dt>
          <dd>{site.address.line1},<br>{site.address.city}, {site.address.postcode}</dd>
          <dt>Opening hours</dt>
          <dd>{site.hours.office}<br>24/7 emergency callouts available</dd>
        </dl>
      </div>
      <div class="check-area">
        <h2>Getting in touch</h2>
        <dl class="detail-list">
          <dt>Job booking</dt>
          <dd><a href={`tel:${site.booking.tel}`}>{site.booking.display}</a></dd>
          <dt>Management</dt>
          <dd><a href={`tel:${site.management.tel}`}>{site.management.display}</a></dd>
          <dt>WhatsApp</dt>
          <dd><a href={site.whatsapp.url}>{site.whatsapp.display}</a></dd>
          <dt>Email</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </dl>
        <p class="small">If it is urgent, phone instead of emailing. Whoever answers the booking line can send an engineer your way.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-navy">
  <div class="container center measure-wide">
    <h2>Looking for a plumber in London?</h2>
    <p>Give us the where and the what, and Ninja Plumbers will tell you the cost before anyone picks up a spanner.</p>
    <div class="cta-row center-row">
      <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">Call {site.booking.display}</a>
      <a href={site.whatsapp.url} class="btn btn-outline btn-lg"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.13h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.36c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.23 8.24c0 4.54-3.69 8.21-8.23 8.21zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.09-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.16 1.71 2.61 4.14 3.66.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.05.14-1.16-.06-.1-.22-.16-.47-.28z"/></svg> WhatsApp us</a>
    </div>
  </div>
</section>

</Base>
