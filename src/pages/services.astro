---
// Server-rendered so a service page published in /admin/service-pages or via
// MCP appears on this hub straight away, not after the next deploy — same
// reasoning as /services/[slug].astro.
export const prerender = false;

import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { services as staticServices } from '../data/services';
import ServiceIcon from '../components/ServiceIcon.astro';
import Tick from '../components/Tick.astro';
import PhoneIcon from '../components/PhoneIcon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import HeroWithForm from '../components/HeroWithForm.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { getSupabaseAdmin } from '../lib/supabaseAdmin';
import { publishedServicePages } from '../lib/servicePages';

const services = [...staticServices, ...(await publishedServicePages(getSupabaseAdmin()))];

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');
---
<Base
  title="London Plumbing Services | Ninja Plumbers"
  description={`Emergency call-outs, boiler work, leak detection, drain unblocking and bathroom fitting from Ninja Plumbers, anywhere in London. Call ${site.booking.display}.`}
>

<HeroWithForm
  eyebrow="Services"
  h1="Plumbing, heating, drainage and electrical work across London"
  intro="Every job on this page is carried out by engineers of our own, for householders and commercial clients alike. Missing the job you need? Give us a ring. Asking takes less time than guessing from a list."
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
  bullets={[
    'Fully insured and Gas Safe registered',
    'Engineers DBS-checked',
    '24/7 emergency callouts',
    'Price agreed before we start',
    'Workmanship guaranteed',
  ]}
/>

<section class="section">
  <div class="container">
    <span class="eyebrow">The full list</span>
    <h2>Pick your job</h2>
    <p class="measure">Each page sets out what the job includes, the things worth checking before you ring us, and the questions we hear most often.</p>

    <ul class="grid grid-3 card-grid">
      {services.map((s) => (
        <li class="card" id={s.slug}>
          <div class="icon"><ServiceIcon name={s.icon} /></div>
          <h3><a href={`/services/${s.slug}`} class="card-title-link" set:html={s.title} /></h3>
          <p>{s.summary}</p>
          <a href={`/services/${s.slug}`} class="card-link" aria-label={`Read about ${s.title.replace('&amp;', 'and')}`}>
            Read more <span aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="split">
      <div class="split-panel">
        <h3>Homes and landlords</h3>
        <p>Homeowners, tenants and landlords all over the capital call us, whether for a pipe that bursts at eleven at night or a bathroom you&rsquo;ve been meaning to redo for three years now.</p>
        <ul class="ticks">
          <li><Tick /> Repairs in an emergency, at any hour</li>
          <li><Tick /> Boiler replacement and servicing</li>
          <li><Tick /> En-suite and bathroom fitting</li>
          <li><Tick /> Tenancy turnarounds and repairs for landlords</li>
        </ul>
      </div>
      <div class="split-panel">
        <h3>Businesses and managed blocks</h3>
        <p>We look after offices, restaurants, shops and blocks of flats, fitting the work around tenants and opening hours and reporting back to the person who signs the work off.</p>
        <ul class="ticks">
          <li><Tick /> Plumbing for washrooms and commercial kitchens</li>
          <li><Tick /> Drain clearance and CCTV surveys for commercial sites</li>
          <li><Tick /> Reactive repairs on behalf of managing agents</li>
          <li><Tick /> Visits out of hours so trading is not disrupted</li>
        </ul>
        <div class="cta-row">
          <a href="/services/commercial-plumbing" class="btn btn-navy">Commercial plumbing</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <span class="eyebrow">Boiler brands</span>
    <h2>Boiler work, make by make</h2>
    <p class="measure">
      Each boiler job, from repair and servicing to installation and replacement, has a page of its own above.
      There is also a page for every brand, explaining the faults it tends to develop.
    </p>
    <p><a href="/boilers" class="btn btn-navy">See every boiler brand</a></p>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <span class="eyebrow">Damp</span>
    <h2>Damp and condensation</h2>
    <p class="measure">
      Damp is something we survey, diagnose and treat as well. Rising damp, penetrating damp and condensation each call for a different fix, so Ninja Plumbers begins with a proper inspection instead of a guess.
    </p>
    <p><a href="/damp" class="btn btn-navy">Damp & condensation services</a></p>
  </div>
</section>

<RelatedPosts covers={staticServices.map((s) => `/services/${s.slug}`)} heading="Advice on plumbing and heating" />

<section class="section section-navy">
  <div class="container center measure-wide">
    <h2>Unsure what the job needs?</h2>
    <p>Explain what is happening and Ninja Plumbers will walk you through the work involved and the cost. For anything urgent, call instead of emailing. The booking line is answered by a real person who can get an engineer on the way.</p>
    <div class="cta-row center-row">
      <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
        <PhoneIcon /> Call {site.booking.display}
      </a>
      <a href="/contact#enquiry" class="btn btn-outline btn-lg">Send an enquiry</a>
    </div>
  </div>
</section>

</Base>
