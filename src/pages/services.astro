---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { services } from '../data/services';
import ServiceIcon from '../components/ServiceIcon.astro';
import Tick from '../components/Tick.astro';
import PhoneIcon from '../components/PhoneIcon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import HeroWithForm from '../components/HeroWithForm.astro';
---
<Base
  title="London Plumbing Services | Ninja Plumbers"
  description={`Ninja Plumbers covers emergency call-outs, boiler work, drain unblocking, leak detection and bathroom fits across London. Call ${site.booking.display}.`}
>

<HeroWithForm
  eyebrow="Our services"
  h1="Plumbing, heating and drainage across London"
  intro="Ninja Plumbers' own engineers carry out every job listed here, for homes and commercial premises alike. Can't see what you need? Ring and ask — quicker than guessing from a list."
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
  bullets={[
    'Gas Safe registered and fully insured',
    'DBS-checked engineers',
    'Emergency callout available 24/7',
    'Price agreed before work starts',
  ]}
/>

<section class="section">
  <div class="container">
    <span class="eyebrow">What we do</span>
    <h2>Choose the job</h2>
    <p class="measure">Click through to any of these and you'll find what's included, what's worth checking before you pick up the phone, and the questions people ask us most often.</p>

    <ul class="grid grid-3 card-grid">
      {services.map((s) => (
        <li class="card" id={s.slug}>
          <div class="icon"><ServiceIcon name={s.icon} /></div>
          <h3><a href={`/services/${s.slug}`} class="card-title-link" set:html={s.title} /></h3>
          <p>{s.summary}</p>
          <a href={`/services/${s.slug}`} class="card-link" aria-label={`More on ${s.title.replace('&amp;', 'and')}`}>
            Read more <span aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="split">
      <div class="split-panel">
        <h3>For your home</h3>
        <p>We work with homeowners, tenants and landlords across the capital — the burst pipe at eleven at night, and the bathroom you&rsquo;ve been putting off replacing for three years.</p>
        <ul class="ticks">
          <li><Tick /> Emergency repairs, day or night</li>
          <li><Tick /> Boiler servicing and replacement</li>
          <li><Tick /> Bathroom and en-suite installation</li>
          <li><Tick /> Landlord repairs and tenancy turnarounds</li>
        </ul>
      </div>
      <div class="split-panel">
        <h3>For your business</h3>
        <p>Offices, restaurants, shops and blocks of flats. We work around opening hours and tenants, and report back to whoever signs it off.</p>
        <ul class="ticks">
          <li><Tick /> Washroom and commercial kitchen plumbing</li>
          <li><Tick /> Commercial drain clearance and CCTV survey</li>
          <li><Tick /> Reactive repairs for managing agents</li>
          <li><Tick /> Out-of-hours work to avoid disrupting trade</li>
        </ul>
        <div class="cta-row">
          <a href="/services/commercial-plumbing" class="btn btn-navy">Commercial plumbing</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <span class="eyebrow">Boilers</span>
    <h2>Boiler work by brand</h2>
    <p class="measure">
      Repair, servicing, installation and replacement are each covered on their own page above.
      For what tends to come up on your specific make, we've got a page per brand too.
    </p>
    <p><a href="/boilers" class="btn btn-navy">All boiler brands</a></p>
  </div>
</section>

<section class="section section-navy">
  <div class="container center measure-wide">
    <h2>Not sure what you need?</h2>
    <p>Tell Ninja Plumbers what's going on and we'll talk you through what's involved and what it costs. If it's urgent, ring rather than email — a real person answers the booking line and can get an engineer moving.</p>
    <div class="cta-row center-row">
      <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
        <PhoneIcon /> Call {site.booking.display}
      </a>
      <a href="/contact#enquiry" class="btn btn-outline btn-lg">Send us the job</a>
    </div>
  </div>
</section>

</Base>
