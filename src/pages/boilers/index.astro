---
// Boiler hub. Ties the four boiler services to the brand pages.
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { brands } from '../../data/brands';
import { services } from '../../data/services';
import Schema from '../../components/Schema.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import PhoneIcon from '../../components/PhoneIcon.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';

const boilerServices = services.filter((s) => s.slug.startsWith('boiler-'));

const active = brands.filter((b) => b.status === 'active');
const legacy = brands.filter((b) => b.status !== 'active');

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Boilers' },
];

const faqs = [
  {
    q: 'Do you work on every boiler make?',
    a: 'We do. Any Gas Safe registered engineer is legally entitled to work on any make of gas boiler — if a brand is no longer sold new, the badge isn’t the issue, getting hold of parts is.',
  },
  {
    q: 'Are you an approved installer for any manufacturer?',
    a: 'We do not claim manufacturer accreditation. Gas work is carried out by Gas Safe registered engineers, which is the legal requirement, and we would rather state what we hold than imply something we do not.',
  },
];
---
<Base
  title="Boiler Repair &amp; Servicing London | Ninja Plumbers"
  description={`Ninja Plumbers repairs, services and installs boilers across London — every make, by Gas Safe registered engineers. Call ${site.booking.display}.`}
>
  <Schema slot="head" breadcrumb={crumbs} faqs={faqs} />

  <section class="page-hero">
    <div class="container">
      <div class="breadcrumb"><a href="/">Home</a> / Boilers</div>
      <span class="eyebrow">Heating and hot water</span>
      <h1>Boilers</h1>
      <p>
        Whatever the make, Ninja Plumbers covers repair, servicing, installation and replacement
        across London, with all gas work carried out by Gas Safe registered engineers.
      </p>
      <div class="cta-row">
        <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
          <PhoneIcon /> Call {site.booking.display}
        </a>
        <a href={site.whatsapp.url} class="btn btn-outline btn-lg">
          <WhatsAppIcon /> WhatsApp us
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">What you need</span>
      <h2>Four different jobs</h2>
      <p class="measure">
        Each of these is a different job with a different answer, which is why we've kept them
        on separate pages instead of lumping them together.
      </p>
      <ul class="grid grid-2 card-grid">
        {boilerServices.map((s) => (
          <li class="card">
            <div class="icon"><ServiceIcon name={s.icon} /></div>
            <h3><a href={`/services/${s.slug}`} class="card-title-link" set:html={s.title} /></h3>
            <p>{s.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">Brands</span>
      <h2>Makes we work on</h2>
      <p class="measure">
        A Gas Safe registered engineer can legally work on any make out there. The pages below
        set out what's typical of each brand and the faults that tend to show up on it.
      </p>
      <ul class="combo-links">
        {active.map((b) => (
          <li><a href={`/boilers/${b.slug}`}>{b.name}</a></li>
        ))}
      </ul>

      <h3>Legacy and transitioning brands</h3>
      <p class="measure">
        Still widely installed, but not straightforwardly available new. We service and repair
        these and advise on what replaces them.
      </p>
      <ul class="combo-links">
        {legacy.map((b) => (
          <li><a href={`/boilers/${b.slug}`}>{b.name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Questions</span>
      <h2>Before you call</h2>
      <dl class="faq">
        {faqs.map((f) => (
          <div class="faq-item">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section-navy">
    <div class="container center measure-wide">
      <h2>Boiler playing up?</h2>
      <p>
        Message Ninja Plumbers the make, model and any fault code showing on the display, and
        we can often work out what's likely wrong before an engineer even leaves the office.
      </p>
      <div class="cta-row center-row">
        <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
          <PhoneIcon /> Call {site.booking.display}
        </a>
        <a href={site.whatsapp.url} class="btn btn-outline btn-lg">
          <WhatsAppIcon /> WhatsApp us
        </a>
      </div>
    </div>
  </section>
</Base>
