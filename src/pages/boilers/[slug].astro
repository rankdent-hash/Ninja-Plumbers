---
// Boiler brand pages.
//
// One page per brand rather than the workbook's four-per-brand (repair,
// service, installation, replacement). Ninety-six brand-and-intent URLs would
// be near-identical to each other and the measured demand does not support
// them: outside Vaillant, every brand-plus-London term tested returned 20
// monthly searches or fewer. The workbook's own rules say not to multiply
// dimensions without demand behind them.
//
// So each brand gets one page covering all four intents for that brand, and
// the four service pages carry the intent-level content.
import { SCHEMA_AREA_SERVED } from '../../data/serviceArea';
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { brands } from '../../data/brands';
import HeroWithForm from '../../components/HeroWithForm.astro';
import Schema from '../../components/Schema.astro';
import PhoneIcon from '../../components/PhoneIcon.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import Tick from '../../components/Tick.astro';

export function getStaticPaths() {
  return brands.map((brand) => ({ params: { slug: brand.slug }, props: { brand } }));
}

const { brand } = Astro.props;

const others = brands.filter((b) => b.slug !== brand.slug && b.tier === brand.tier).slice(0, 6);

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Boilers', href: '/boilers' },
  { label: brand.name },
];

// Services we offer on this brand. Installation is dropped for legacy and
// transitioning brands so no page implies a new unit can be bought.
const offered = [
  { slug: 'boiler-repair', label: `${brand.name} boiler repair`, note: 'We find the fault first, then quote for the fix.' },
  { slug: 'boiler-service', label: `${brand.name} boiler service`, note: 'An annual check, which most manufacturer warranties require.' },
  ...(brand.installs
    ? [{ slug: 'boiler-installation', label: `${brand.name} boiler installation`, note: 'Matched to your home, at a price agreed up front.' }]
    : []),
  { slug: 'boiler-replacement', label: `${brand.name} boiler replacement`, note: 'You see repair and replacement costs side by side first.' },
];

const faqs = [
  ...brand.faqs,
  {
    q: `Can you repair and service my ${brand.name} boiler?`,
    a: `Yes. Our gas work is done by Gas Safe registered engineers, as the law requires for any gas boiler, whatever the make.`,
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: `${brand.name} boiler repair and servicing`,
  provider: { '@type': 'Plumber', name: site.legalName, telephone: site.booking.tel, url: site.url },
  areaServed: SCHEMA_AREA_SERVED,
};

// The long form runs past 65 characters for brands with long names — "Alpha
// Heating Innovation" alone is 24 — so it drops "& Service" only when it has
// to, rather than shortening every brand for the sake of one.
const longBrandTitle = `${brand.name} Boiler Repairs & Service London | Ninja Plumbers`;
const brandTitle = longBrandTitle.length <= 65
  ? longBrandTitle
  : `${brand.name} Boiler Repairs London | Ninja Plumbers`;

const statusLine =
  brand.status === 'legacy'
    ? `${brand.name} counts as a legacy brand. Boilers already fitted can be serviced and repaired by us, and we give advice on replacing them, but we do not install new ${brand.name} boilers.`
    : brand.status === 'transitioning'
      ? `${brand.name} is now part of a bigger group instead of a fully separate range on sale today. We repair, service and replace these boilers.`
      : null;
---
<Base
  title={brandTitle}
  description={`Need ${brand.name} boiler repair, a service${brand.installs ? ', a new installation' : ''} or replacement in London? Our engineers are Gas Safe registered. Call ${site.booking.display}.`}
>
  <Schema slot="head" breadcrumb={crumbs} faqs={faqs} extra={schema} />

  <HeroWithForm
    eyebrow={`${brand.tier} · ${brand.fuel}`}
    h1={`${brand.name} boiler repair and service engineers in London`}
    intro={brand.summary}
    breadcrumb={crumbs}
    bullets={[
      'Fully insured and Gas Safe registered',
      'Every fault diagnosed before we quote',
      'You agree the price before we start',
      'Our workmanship is guaranteed',
    ]}
    formHeading={`Ask for a price on your ${brand.name}`}
  />

  <section class="section">
    <div class="container">
      <span class="eyebrow">The make</span>
      <h2>{brand.name} boilers</h2>
      <p class="measure">{brand.character}</p>
      <h3>The {brand.name} range</h3>
      <p class="measure">{brand.range}</p>

      {statusLine && (
        <div class="brand-status">
          <p>{statusLine}</p>
        </div>
      )}

      <h3>Faults we often find on {brand.name} boilers</h3>
      <ul class="ticks">
        {brand.common.map((c) => <li><Tick /> {c}</li>)}
      </ul>
      <p class="small">
        This list reflects what Ninja Plumbers finds across {brand.name} boilers in general. It is
        not a diagnosis of yours, and we confirm any fault on site before giving a price.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="guidance">
        <div class="guidance-item">
          <h2 class="guidance-h2">{brand.name} servicing</h2>
          <p>{brand.servicing}</p>
        </div>
        <div class="guidance-item">
          <h2 class="guidance-h2">Repair it or replace it?</h2>
          <p>{brand.repairOrReplace}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Our services</span>
      <h2>Work we do on {brand.name} boilers</h2>
      <ul class="grid grid-2 card-grid">
        {offered.map((o) => (
          <li class="card">
            <h3><a href={`/services/${o.slug}`} class="card-title-link">{o.label}</a></h3>
            <p>{o.note}</p>
          </li>
        ))}
      </ul>
      {!brand.installs && (
        <p class="small">
          We do not fit new {brand.name} boilers. If yours needs replacing, we will explain the
          current options that would suit your home.
        </p>
      )}
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">FAQs</span>
      <h2>Questions about {brand.name} boilers</h2>
      <dl class="faq">
        {faqs.map((f) => (
          <div class="faq-item">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {others.length > 0 && (
    <section class="section">
      <div class="container">
        <span class="eyebrow">More makes</span>
        <h2>We handle every make of boiler</h2>
        <ul class="combo-links">
          {others.map((b) => (
            <li><a href={`/boilers/${b.slug}`}>{b.name} boilers</a></li>
          ))}
          <li><a href="/boilers">See every boiler brand</a></li>
        </ul>
      </div>
    </section>
  )}

  <section class="section section-navy">
    <div class="container center measure-wide">
      <h2>Problem with your {brand.name}?</h2>
      <p>
        Tell us the model and whatever fault code the display shows. We can often say what the likely
        problem is before an engineer is on the way.
      </p>
      <div class="cta-row center-row">
        <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
          <PhoneIcon /> Call {site.booking.display}
        </a>
        <a href={site.whatsapp.url} class="btn btn-outline btn-lg">
          <WhatsAppIcon /> Message us on WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>
