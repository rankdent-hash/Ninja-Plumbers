---
// Where enquiries come from, by the postcode we were given for the job.
//
// This is deliberately NOT "where our visitors are". It counts enquiries per
// postcode district, because that postcode is the only location a customer
// actually gave us. Two kinds of enquiry now feed it: a website form
// submission, and a call, WhatsApp message or email the office logged by hand.
// Both are real jobs at real addresses, so both belong on the same map, and
// the district panel splits them so neither is mistaken for the other.
//
// Phone, WhatsApp and SMS *taps* are a different thing entirely and stay
// separate: /api/track records which link was tapped and on which page,
// nothing about where the person was, so a tap dot sits at the place the page
// is about rather than at a location anyone gave us.
//
// Aggregate only. enquiries rows carry a name, phone number, email and full
// postcode; nothing here may render one. Counts per district, never a point
// per customer.
import AdminLayout from '../../layouts/AdminLayout.astro';
import AreaMap, { type MapMarker, type DistrictDetail } from '../../components/AreaMap.astro';
import { getSupabaseAdmin } from '../../lib/supabaseAdmin';
import { leadSourceLabel } from '../../lib/leadChannels';
import { areas } from '../../data/areas';
import { postcodes } from '../../data/postcodes';
import { POINTS, OUTER_DISTRICTS } from '../../data/londonMap';
import { COVERED_OUTSIDE_LONDON, CORRIDOR_AREA_SHARE_PCT } from '../../data/serviceArea';
import { londonDayRange } from '../../lib/londonDay';
import { DISTRICT_PLACES } from '../../lib/districtPlaces';

export const prerender = false;

const admin = Astro.locals.admin!;
const supabase = getSupabaseAdmin();

// All time is the default here, unlike /admin/activity: this report answers a
// slow question (which parts of London send us work) and at current volumes a
// 30-day window would usually be empty. The short windows answer a different
// question — where the work that just came in is landing — and the low-sample
// warning below still fires when they are too thin to read anything into,
// which for today and yesterday will be nearly always.
const RANGES = [
  { days: 0, label: 'All time' },
  { days: 365, label: '12 months' },
  { days: 90, label: '90 days' },
  { days: 30, label: '30 days' },
  { days: 14, label: '14 days' },
  { days: 7, label: '7 days' },
] as const;

// Today and yesterday are calendar days in London, not rolling windows, so
// they need an upper bound as well as a lower one and cannot be expressed as
// another `days` value the way "7 days" can.
const DAY_RANGES = [
  { range: 'today', label: 'Today' },
  { range: 'yesterday', label: 'Yesterday' },
] as const;
type DayRange = (typeof DAY_RANGES)[number]['range'];

const params = Astro.url.searchParams;
const requestedRange = params.get('range');
const dayRange = (DAY_RANGES.some((r) => r.range === requestedRange) ? requestedRange : null) as DayRange | null;
const requestedDays = parseInt(params.get('days') || '0', 10);
const days = dayRange ? 0 : RANGES.some((r) => r.days === requestedDays) ? requestedDays : 0;

const activeWindow = dayRange
  ? londonDayRange(dayRange)
  : {
      since: days === 0
        ? new Date('2000-01-01T00:00:00Z').toISOString()
        : new Date(Date.now() - days * 24 * 60 * 60 * 1000).toISOString(),
      until: undefined as string | undefined,
    };
const { since, until } = activeWindow;

const href = (d: number) => (d === 0 ? '/admin/areas' : `/admin/areas?days=${d}`);
const dayHref = (r: DayRange) => `/admin/areas?range=${r}`;

type AreaRow = {
  district: string;
  borough: string | null;
  total: number;
  booked: number;
  in_service_area: boolean;
  borough_unknown: number;
  // How each district's enquiries arrived. These sum to `total`.
  by_form: number;
  by_phone: number;
  by_whatsapp: number;
  by_other: number;
};

type SourceRow = { page: string; views: number; phone: number; whatsapp: number; sms: number; forms: number };
type LeadSourceRow = { lead_source: string; total: number; booked: number };

let rows: AreaRow[] = [];
let sources: SourceRow[] = [];
let leadSources: LeadSourceRow[] = [];
let loadError = '';
if (!supabase) {
  loadError = 'The admin panel is not connected to Supabase yet.';
} else {
  const [areaRes, sourceRes, leadSourceRes] = await Promise.all([
    supabase.rpc('enquiry_areas', { since, until }),
    supabase.rpc('contact_sources', { since, until }),
    supabase.rpc('lead_sources', { since, until }),
  ]);
  if (areaRes.error) loadError = 'Could not load enquiry areas from the database.';
  else rows = (areaRes.data ?? []) as AreaRow[];
  // Clicks are supplementary: if this one fails the map simply has no tap
  // dots, which is better than failing the whole page.
  if (!sourceRes.error) sources = (sourceRes.data ?? []) as SourceRow[];
  if (!leadSourceRes.error) leadSources = (leadSourceRes.data ?? []) as LeadSourceRow[];
}

// Which page, if any, already covers this district. postcodes.ts is the
// authoritative district -> area hand-off; areas.ts is checked as well because
// an area lists the districts it covers and the two are maintained separately.
const districtPage = new Map(postcodes.map((p) => [p.district.toUpperCase(), p]));
function coverage(district: string) {
  const pc = districtPage.get(district.toUpperCase());
  const areaSlug = pc?.areaSlug ?? null;
  const byArea = areas.find((a) => a.postcodes.some((p) => p.toUpperCase() === district.toUpperCase()));
  const area = (areaSlug ? areas.find((a) => a.slug === areaSlug) : undefined) ?? byArea;
  return { area, districtPage: pc };
}

// A contact click records the page it happened on, never a location. Where
// that page is about a specific place, the tap is attributable to that
// place's district — "this local page earned a call", which is a different
// claim from "the caller was there", and the map's legend keeps them apart.
const areaBySlug = new Map(areas.map((a) => [a.slug, a]));

// Central London is the one place where the site and the map disagree about
// what a district is. POINTS carries sub-districts (W1B, SW1A, EC1A, WC2A)
// while postcodes.ts and areas.ts use the parent codes (W1, SW1, EC1, WC2), so
// every tap on /postcodes/w1, /postcodes/sw1, /postcodes/ec1..ec4,
// /postcodes/wc1, /postcodes/wc2 and the whole Westminster area family was
// falling through as unplaceable — and then being reported under the words
// "pages that are not about a particular place", which Westminster plainly is.
//
// A parent sits at the mean of its own sub-districts. That is derived from
// points already committed here, not a new coordinate from somewhere else.
//
// The suffix must be LETTERS: "SW1" + "A" is a sub-district of SW1, but
// "SW1" + "0" is SW10, a different district a mile and a half away. A plain
// startsWith would silently put Pimlico taps in Battersea.
const SUBDISTRICT_MEANS = new Map<string, [number, number]>();
for (const parent of ['EC1', 'EC2', 'EC3', 'EC4', 'SW1', 'W1', 'WC1', 'WC2']) {
  const kids = Object.entries(POINTS).filter(
    ([k]) => k.length > parent.length && k.startsWith(parent) && /^[A-Z]+$/.test(k.slice(parent.length))
  );
  if (!kids.length) continue;
  SUBDISTRICT_MEANS.set(parent, [
    kids.reduce((s, [, p]) => s + p[0], 0) / kids.length,
    kids.reduce((s, [, p]) => s + p[1], 0) / kids.length,
  ]);
}
const pointFor = (d: string): [number, number] | undefined => POINTS[d] ?? SUBDISTRICT_MEANS.get(d);

function districtForPage(page: string): string | null {
  const clean = (page || '').split('?')[0].replace(/\/+$/, '');
  const postcodeMatch = clean.match(/^\/postcodes\/([a-z0-9-]+)$/i);
  if (postcodeMatch) {
    const d = postcodeMatch[1].toUpperCase();
    return pointFor(d) ? d : null;
  }
  const areaMatch = clean.match(/^\/areas\/([a-z0-9-]+)$/i) || clean.match(/^\/services\/[a-z0-9-]+\/([a-z0-9-]+)$/i);
  if (areaMatch) {
    const area = areaBySlug.get(areaMatch[1].toLowerCase());
    const d = area?.postcodes.find((p) => pointFor(p.toUpperCase()));
    return d ? d.toUpperCase() : null;
  }
  return null;
}

type Taps = { phone: number; whatsapp: number; sms: number };
const tapsByDistrict = new Map<string, Taps>();
let unplaceableTaps = 0;

// The pages behind each district's taps, kept rather than summed away. A count
// on its own says a district is busy; the pages say WHICH page earned it and
// how hard it had to work to do so, which is the question worth asking before
// moving money.
type PageRow = { page: string; views: number; phone: number; whatsapp: number; sms: number; forms: number };
const pagesByDistrict = new Map<string, PageRow[]>();

for (const s of sources) {
  const taps = Number(s.phone) + Number(s.whatsapp) + Number(s.sms);
  const forms = Number(s.forms);
  if (taps === 0 && forms === 0 && Number(s.views) === 0) continue;
  const d = districtForPage(s.page);
  if (!d) {
    unplaceableTaps += taps;
    continue;
  }
  const cur = tapsByDistrict.get(d) ?? { phone: 0, whatsapp: 0, sms: 0 };
  cur.phone += Number(s.phone);
  cur.whatsapp += Number(s.whatsapp);
  cur.sms += Number(s.sms);
  tapsByDistrict.set(d, cur);

  const list = pagesByDistrict.get(d) ?? [];
  list.push({
    page: s.page,
    views: Number(s.views),
    phone: Number(s.phone),
    whatsapp: Number(s.whatsapp),
    sms: Number(s.sms),
    forms,
  });
  pagesByDistrict.set(d, list);
}

const boroughByDistrict = new Map(rows.map((r) => [r.district, r.borough]));
const markerDistricts = new Set<string>([...rows.map((r) => r.district), ...tapsByDistrict.keys()]);
const markers: MapMarker[] = [...markerDistricts]
  .filter((d) => pointFor(d))
  .map((d) => {
    const row = rows.find((r) => r.district === d);
    const taps = tapsByDistrict.get(d) ?? { phone: 0, whatsapp: 0, sms: 0 };
    return {
      district: d,
      borough: row?.borough ?? boroughByDistrict.get(d) ?? null,
      x: pointFor(d)![0],
      y: pointFor(d)![1],
      enquiries: Number(row?.total ?? 0),
      phone: taps.phone,
      whatsapp: taps.whatsapp,
      sms: taps.sms,
    };
  });

// The per-district breakdown behind each dot. Only districts with something to
// show get one — there is no value in a panel that says nothing, and rendering
// all 329 would bloat the page for no reader.
const details: DistrictDetail[] = markers
  .filter((m) => m.enquiries + m.phone + m.whatsapp + m.sms > 0)
  .map((m) => {
    const row = rows.find((r) => r.district === m.district);
    const pages = (pagesByDistrict.get(m.district) ?? [])
      .map((p) => ({ ...p, contacts: p.phone + p.whatsapp + p.sms + p.forms }))
      .filter((p) => p.contacts > 0 || p.views > 0)
      .sort((a, b) => b.contacts - a.contacts || b.views - a.views);
    return {
      district: m.district,
      places: DISTRICT_PLACES[m.district] ?? [],
      borough: m.borough,
      enquiries: m.enquiries,
      booked: Number(row?.booked ?? 0),
      byChannel: {
        form: Number(row?.by_form ?? 0),
        phone: Number(row?.by_phone ?? 0),
        whatsapp: Number(row?.by_whatsapp ?? 0),
        other: Number(row?.by_other ?? 0),
      },
      phone: m.phone,
      whatsapp: m.whatsapp,
      sms: m.sms,
      pages,
      areaPage: coverage(m.district).area?.slug ?? null,
      areaName: coverage(m.district).area?.name ?? null,
    };
  })
  .sort((a, b) => b.enquiries - a.enquiries || b.phone + b.whatsapp + b.sms - (a.phone + a.whatsapp + a.sms));

// A district with enquiries but no point on the map (outside Greater London,
// or a code the boundary data does not carry) must be visible as a gap rather
// than silently missing — the table lists every row regardless.
const offMap = rows.filter((r) => !pointFor(r.district));

const totalEnquiries = rows.reduce((sum, r) => sum + Number(r.total), 0);
const totalBooked = rows.reduce((sum, r) => sum + Number(r.booked), 0);
const uncovered = rows.filter((r) => !coverage(r.district).area);
const unknownBoroughs = rows.reduce((sum, r) => sum + Number(r.borough_unknown), 0);
const pct = (n: number) => (totalEnquiries ? Math.round((n / totalEnquiries) * 100) : 0);

// Only the districts we do NOT cover are drawn unfilled and dashed. Counting
// all of OUTER_DISTRICTS here would be wrong by exactly the two we do cover.
const plannedCount = OUTER_DISTRICTS.length - COVERED_OUTSIDE_LONDON.length;

// Logged leads, and how many of them are still waiting for a postcode. The
// second number is the honest caveat on the first: a logged call with no
// postcode is real work that this map cannot place, and saying so is better
// than letting the districts look like the whole picture.
const manualTotal = rows.reduce((sum, r) => sum + Number(r.by_phone) + Number(r.by_whatsapp) + Number(r.by_other), 0);
const notRecorded = rows.find((r) => r.district === '(not recorded)');
const manualNoPostcode = notRecorded
  ? Number(notRecorded.by_phone) + Number(notRecorded.by_whatsapp) + Number(notRecorded.by_other)
  : 0;
const leadSourceTotal = leadSources.reduce((sum, r) => sum + Number(r.total), 0);
const corridorSharePct = CORRIDOR_AREA_SHARE_PCT;
---
<AdminLayout title="Areas" admin={admin}>
  <div class="admin-head">
    <h1>Areas</h1>
    <p class="admin-sub">
      {totalEnquiries} enquiries across {rows.length} postcode {rows.length === 1 ? 'district' : 'districts'}
      {totalBooked > 0 && <> &middot; {totalBooked} booked</>}
    </p>
  </div>

  <nav class="admin-tabs" aria-label="Date range">
    {RANGES.map((r) => (
      <a href={href(r.days)} class:list={{ 'is-active': !dayRange && days === r.days }}>{r.label}</a>
    ))}
    {DAY_RANGES.map((r) => (
      <a href={dayHref(r.range)} class:list={{ 'is-active': dayRange === r.range }}>{r.label}</a>
    ))}
  </nav>

  <p class="admin-note">
    Where the job was, taken from the postcode we were given &mdash; the one genuinely accurate
    location we have. That covers enquiries from the website form and calls, WhatsApp messages and
    emails the office logged by hand, which sit on the map together because a job in SW6 is in SW6
    however it reached us. Click a district to see how its enquiries split between the two.
    The map adds phone, WhatsApp and text taps on top, positioned by the page they happened on
    rather than by where the person was; see the note under the table for why that distinction
    matters before you move any budget on it.
  </p>

  {!loadError && manualTotal > 0 && manualNoPostcode > 0 && (
    <p class="admin-note-warn" role="status">
      {manualNoPostcode} of the {manualTotal} logged {manualTotal === 1 ? 'enquiry' : 'enquiries'} in
      this period {manualNoPostcode === 1 ? 'has' : 'have'} no postcode yet, so {manualNoPostcode === 1 ? 'it sits' : 'they sit'}
      {' '}under &ldquo;(not recorded)&rdquo; rather than in a district. Adding one from the
      lead&rsquo;s own page puts {manualNoPostcode === 1 ? 'it' : 'them'} on the map.
    </p>
  )}

  {loadError && <p class="form-error-summary" role="alert">{loadError}</p>}

  {!loadError && (
    <AreaMap
      markers={markers}
      details={details}
      summary={`Map of London and the M25 corridor showing ${markers.length} postcode ${markers.length === 1 ? 'district' : 'districts'} with activity. The table below this map lists the same figures.`}
    />
  )}

  {!loadError && offMap.length > 0 && (
    <p class="admin-note">
      {offMap.length === 1 ? 'One district is' : `${offMap.length} districts are`} not on the map
      &mdash; {offMap.map((r) => r.district).join(', ')}. The map can only draw a dot where it holds a
      position for the postcode district, and it holds {Object.keys(POINTS).length} of them; these are
      not among them, so {offMap.length === 1 ? 'it' : 'they'} would have to be plotted somewhere
      invented. {offMap.length === 1 ? 'It is' : 'They are'} still counted in the table below, and
      {offMap.some((r) => COVERED_OUTSIDE_LONDON.some((n) => r.district.startsWith('GU') || r.district.startsWith('AL')))
        ? 'a district being absent here says nothing about whether we cover it — Guildford and St Albans are covered and have no dot position yet.'
        : 'being absent here says nothing about whether we cover the place.'}
    </p>
  )}

  {!loadError && unplaceableTaps > 0 && (
    <p class="admin-note">
      {unplaceableTaps} phone, WhatsApp or text {unplaceableTaps === 1 ? 'tap' : 'taps'} happened on
      pages that are not about a particular place &mdash; the homepage, a general service page, an
      ad landing page &mdash; so there is nowhere honest to plot {unplaceableTaps === 1 ? 'it' : 'them'}.
      {' '}<a href="/admin/activity">Activity</a> shows every tap by page.
    </p>
  )}

  {!loadError && rows.length === 0 && (
    <p class="admin-empty">No enquiries with a postcode in this period.</p>
  )}

  {!loadError && rows.length > 0 && totalEnquiries < 25 && (
    <p class="admin-note">
      <strong>Too few to act on yet.</strong> {totalEnquiries} enquiries is not a pattern &mdash; one
      more lead would change the order of this table. Treat it as a record of what has come in so
      far, and wait for the numbers to build before moving budget on the strength of it.
    </p>
  )}

  {!loadError && rows.length > 0 && (
    <div class="admin-table-scroll" tabindex="0">
      <table class="admin-table">
        <thead>
          <tr>
            <th>District</th>
            <th>Borough</th>
            <th class="admin-num">Enquiries</th>
            <th class="admin-num">Share</th>
            <th class="admin-num">Booked</th>
            <th>Page covering it</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => {
            const { area, districtPage: pc } = coverage(r.district);
            return (
              <tr>
                <td>
                  {pc
                    ? <a href={`/postcodes/${pc.slug}`} target="_blank" rel="noopener">{r.district}</a>
                    : r.district}
                </td>
                <td>
                  {r.borough ?? <span class="admin-dim">not found</span>}
                  {!r.in_service_area && <> <span class="admin-urgency is-draft">outside London</span></>}
                </td>
                <td class="admin-num">{r.total}</td>
                <td class="admin-num">{pct(Number(r.total))}%</td>
                <td class="admin-num">{r.booked || <span class="admin-dim">&mdash;</span>}</td>
                <td>
                  {area
                    ? <a href={`/areas/${area.slug}`} target="_blank" rel="noopener">{area.name}</a>
                    : <span class="admin-urgency is-live">No area page</span>}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}

  {!loadError && leadSourceTotal > 0 && (
    <section class="admin-section">
      <h2>How the logged leads found us</h2>
      <p class="admin-note">
        Calls, WhatsApp messages and emails the office recorded by hand, grouped by what the
        customer said when asked. Website form submissions are not in here: the page they came from
        is already known exactly, and folding the two together would bury the question this
        answers &mdash; whether the phone rings because of Google Ads.
      </p>
      <p class="admin-note">
        This is what somebody remembered and reported, not a measurement. It is the only record we
        have of a call that never touched the website, and it is worth having, but it is the
        weakest evidence on this page: treat it as a steer, and check it against the ad account
        before it moves money.
      </p>
      <div class="admin-table-scroll admin-source-table" tabindex="0">
        <table class="admin-table">
          <thead>
            <tr>
              <th>How they found us</th>
              <th class="admin-num">Leads</th>
              <th class="admin-num">Share</th>
              <th class="admin-num">Booked</th>
            </tr>
          </thead>
          <tbody>
            {leadSources.map((r) => (
              <tr>
                <td>
                  {r.lead_source === '(not recorded)'
                    ? <span class="admin-dim">Not recorded</span>
                    : leadSourceLabel(r.lead_source)}
                </td>
                <td class="admin-num">{r.total}</td>
                <td class="admin-num">{Math.round((Number(r.total) / leadSourceTotal) * 100)}%</td>
                <td class="admin-num">{r.booked || <span class="admin-dim">&mdash;</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {!loadError && uncovered.length > 0 && (
    <section class="admin-section">
      <h2>Worth a page</h2>
      <p class="admin-note">
        {uncovered.length === 1 ? 'This district has' : 'These districts have'} sent enquiries and
        {uncovered.length === 1 ? ' has' : ' have'} no neighbourhood page on the site. A page
        naming the place is what lets it rank for &ldquo;plumber &lt;place&gt;&rdquo; &mdash; the
        search people actually make. Add one in <code>src/data/areas.ts</code>, or ask the MCP
        connector to draft it.
      </p>
      <ul class="combo-links">
        {uncovered.map((r) => (
          <li>
            <strong>{r.district}</strong>
            {r.borough && <> &mdash; {r.borough}</>}
            {' '}({r.total} {Number(r.total) === 1 ? 'enquiry' : 'enquiries'})
          </li>
        ))}
      </ul>
    </section>
  )}

  {!loadError && unknownBoroughs > 0 && (
    <p class="admin-note">
      {unknownBoroughs} {unknownBoroughs === 1 ? 'enquiry has' : 'enquiries have'} no borough
      recorded. That means the postcode lookup did not answer when the form was submitted, not
      that the postcode has no borough &mdash; the district column is still reliable.
    </p>
  )}

  <section class="admin-section">
    <h2>What the map is and isn&rsquo;t</h2>
    <p class="admin-note">
      <strong>Not everything drawn here is a place we work.</strong> Greater London&rsquo;s 33 boroughs,
      plus Guildford and St Albans, are filled blue-grey with a solid border: those are covered today.
      The {plannedCount} unfilled shapes with a dashed border are the districts the planned M25 corridor
      passes through &mdash; they are named so the expansion can be read against real places, and we do
      not work in them yet. They are left unfilled on purpose: only about
      {corridorSharePct}% of their combined area is actually within 3 miles of the motorway, so shading
      them whole would make the corridor look roughly two and a half times bigger than it is. The green
      band is the corridor itself, and it shows where the M25 runs, not where a van can realistically
      get in traffic.
    </p>
    <p class="admin-note">
      Two details worth knowing before you lean on this. <strong>Guildford</strong> is not near the
      corridor at all &mdash; its town centre is about 7&frac12; miles from the motorway, roughly
      4&frac12; miles beyond the edge of the band. It is on the map because we cover it, not because
      of where the M25 goes. <strong>St Albans</strong> is a coin toss: the city centre is about 2.8
      miles from the motorway, so it falls inside the band by around 250 metres, and picking a
      slightly different point in the city puts it outside. Treat the band&rsquo;s edge as
      approximate everywhere &mdash; East Hertfordshire and Harlow miss it by a tenth of a mile, and
      a 3.1-mile band would have pulled them both in.
    </p>
    <p class="admin-note">
      Blue dots are real locations: the postcode the customer typed when they asked us to quote.
      The orange, green and purple dots are not &mdash; a tap on a call, WhatsApp or text link
      records the page it happened on and nothing about where the person was, so those dots sit at
      the place the <em>page</em> is about. A tap on the Wimbledon page plots in Wimbledon whether
      the caller was in Wimbledon or Watford. It answers &ldquo;which local pages earn calls&rdquo;,
      which is the SEO question, rather than &ldquo;where do our callers live&rdquo;, which nothing
      on this site can answer.
    </p>
    <p class="admin-note">
      We could guess a caller&rsquo;s location from their IP address and it would be worse than
      useless: measured against two commercial geo-IP databases, roughly three quarters of all
      London addresses resolve to a single point near Charing Cross, and that same point carries
      about half of the entire UK. It would draw a convincing map of something that is not true, so
      this does not do it. The honest route to phone and WhatsApp locations is the office noting
      the job postcode when the call comes in.
    </p>
  </section>
</AdminLayout>
