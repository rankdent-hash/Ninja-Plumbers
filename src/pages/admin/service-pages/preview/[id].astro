---
// Live preview of one service_pages row, rendered through the same
// components /services/[slug] uses — so what a reviewer sees here is what
// publishing (then deploying) actually produces. Admin-gated by middleware.
// Reads Supabase directly by id, since getStaticPaths only ever sees
// published rows and this needs to work for a draft.
import Base from '../../../../layouts/Base.astro';
import site from '../../../../data/site.json';
import { services } from '../../../../data/services';
import { appliances } from '../../../../data/appliances';
import ServiceIcon from '../../../../components/ServiceIcon.astro';
import Tick from '../../../../components/Tick.astro';
import PhoneIcon from '../../../../components/PhoneIcon.astro';
import WhatsAppIcon from '../../../../components/WhatsAppIcon.astro';
import HeroWithForm from '../../../../components/HeroWithForm.astro';
import Schema from '../../../../components/Schema.astro';
import { getSupabaseAdmin } from '../../../../lib/supabaseAdmin';
import { rowToService, publishedServicePages } from '../../../../lib/servicePages';

export const prerender = false;

const supabase = getSupabaseAdmin();
const { id } = Astro.params;

let service: ReturnType<typeof rowToService> | null = null;
let loadError = '';
if (!supabase) {
  loadError = 'Not connected to Supabase.';
} else {
  const { data, error } = await supabase.from('service_pages').select('*').eq('id', id).maybeSingle();
  if (error) loadError = 'Could not load that service page.';
  else if (!data) loadError = 'No service page found with that id.';
  else service = rowToService(data as any);
}

const allServices = service ? [...services, ...(await publishedServicePages(supabase))].filter((s) => s.slug !== service!.slug) : [];
const relatedAppliances = service ? appliances.filter((a) => a.related.includes(service!.slug)) : [];

const crumbs = service ? [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: service.title.replace('&amp;', 'and') },
] : [];

const serviceSchema = service && {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.metaDescription,
  serviceType: service.title,
  provider: {
    '@type': 'Plumber',
    name: site.name,
    telephone: site.booking.tel,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.line1,
      addressLocality: site.address.city,
      postalCode: site.address.postcode,
      addressCountry: site.address.country,
    },
  },
  areaServed: { '@type': 'City', name: 'London' },
};
---
{loadError && <p style="padding:40px; font:16px system-ui;">{loadError}</p>}

{service && (
  <Base title={`Preview: ${service.metaTitle}`} description={service.metaDescription}>
    <Schema slot="head" breadcrumb={crumbs} faqs={service.faqs} extra={serviceSchema} />
    <div style="background:#fffbe6; border-bottom:2px solid #e6b800; padding:8px 16px; text-align:center; font:14px system-ui; position:sticky; top:0; z-index:999;">
      Preview only &mdash; not the live page. <a href="javascript:history.back()">&larr; Back to editor</a>
    </div>

    <HeroWithForm
      eyebrow={service.eyebrow}
      h1={service.h1}
      intro={service.intro}
      breadcrumb={crumbs}
      bullets={[
        'Gas Safe registered and fully insured',
        'DBS-checked engineers',
        'Emergency callout available 24/7',
        'Price agreed before work starts',
      ]}
      formHeading={`Get a price for ${service.title.replace('&amp;', 'and').toLowerCase()}`}
      service={service.title}
      tel={site.booking}
    />

    <section class="section">
      <div class="container service-row">
        <div class="service-copy">
          <span class="eyebrow">What we cover</span>
          <h2>What this includes</h2>
          <ul class="ticks">
            {service.does.map((d) => <li><Tick /> {d}</li>)}
          </ul>
          <div class="cta-row">
            <a href="/contact#enquiry" class="btn btn-navy">Send us the job</a>
          </div>
        </div>
        <aside class="service-aside">
          <div class="icon"><ServiceIcon name={service.icon} /></div>
          <h3>{service.aside.title}</h3>
          <p>{service.aside.body}</p>
        </aside>
      </div>
    </section>

    {service.spaces && (
      <section class="section">
        <div class="container">
          <span class="eyebrow">Types of premises</span>
          <h2>The spaces we work in</h2>
          <div class="guidance">
            {service.spaces.map((s) => (
              <div class="guidance-item">
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section section-alt">
      <div class="container">
        <span class="eyebrow">Before you call</span>
        <h2>Worth knowing first</h2>
        <p class="measure">Some of this may save you a callout entirely. We would rather tell you than not.</p>
        <div class="guidance">
          {service.guidance.map((g) => (
            <div class="guidance-item">
              <h3>{g.title}</h3>
              <p>{g.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container measure-wide">
        <span class="eyebrow">Questions</span>
        <h2>Common questions</h2>
        <div class="faqs">
          {service.faqs.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {relatedAppliances.length > 0 && (
      <section class="section">
        <div class="container">
          <span class="eyebrow">Fitted and serviced</span>
          <h2>Related appliance work</h2>
          <ul class="grid grid-3 card-grid">
            {relatedAppliances.map((a) => (
              <li class="card">
                <div class="icon"><ServiceIcon name={a.icon} /></div>
                <h3><a href={`/appliances/${a.slug}`} class="card-title-link">{a.title}</a></h3>
                <p>{a.summary}</p>
                <a href={`/appliances/${a.slug}`} class="card-link">More on {a.title.toLowerCase()} <span aria-hidden="true">&rarr;</span></a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="section">
      <div class="container">
        <span class="eyebrow">Other services</span>
        <h2>We also handle</h2>
        <ul class="grid grid-3 card-grid">
          {allServices.map((s) => (
            <li class="card">
              <div class="icon"><ServiceIcon name={s.icon} /></div>
              <h3>{s.title}</h3>
              <p>{s.summary}</p>
              <a href={`/services/${s.slug}`} class="card-link">More on {s.title} <span aria-hidden="true">&rarr;</span></a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section section-navy">
      <div class="container center measure-wide">
        <h2>Need {service.title.toLowerCase()} in London?</h2>
        <p>Tell us what&rsquo;s happening and where you are, and we&rsquo;ll tell you what it costs before anyone starts work.</p>
        <div class="cta-row center-row">
          <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
            <PhoneIcon /> Call {site.booking.display}
          </a>
          <a href={site.whatsapp.url} target="_blank" rel="noopener" class="btn btn-outline btn-lg">
            <WhatsAppIcon /> WhatsApp us
          </a>
        </div>
      </div>
    </section>
  </Base>
)}
