---
// API keys for the AI blog generation flow. Stored in Supabase rather than as
// Vercel env vars, so a rotated key takes effect immediately with no
// redeploy. Real values are never sent back to the browser — each field
// shows only whether a key is set and its last 4 characters.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSupabaseAdmin } from '../../lib/supabaseAdmin';
import { getMaskedSettings } from '../../lib/adminSettings';

export const prerender = false;

const admin = Astro.locals.admin!;
const supabase = getSupabaseAdmin();

let masked: Record<string, string | null> = { openai_api_key: null, anthropic_api_key: null, gemini_api_key: null };
let loadError = '';
type McpTokenRow = { id: string; name: string; created_at: string; last_used_at: string | null; revoked_at: string | null };
let mcpTokens: McpTokenRow[] = [];
if (!supabase) {
  loadError = 'The admin panel is not connected to Supabase yet.';
} else {
  masked = await getMaskedSettings(supabase);
  const { data } = await supabase
    .from('mcp_tokens')
    .select('id, name, created_at, last_used_at, revoked_at')
    .order('created_at', { ascending: false });
  mcpTokens = data ?? [];
}

// Hardcoded rather than derived from Astro.url.origin: this page can be
// reached via a Vercel preview alias as well as the real domain, and an MCP
// client needs the one stable, canonical URL regardless of which hostname
// whoever generated the token happened to be looking at.
const mcpUrl = 'https://www.tamesisplumbers.co.uk/api/mcp';
const fmtDate = (iso: string | null) =>
  iso ? new Date(iso).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/London' }) : null;

const fields = [
  { key: 'openai_api_key', label: 'OpenAI API key', hint: 'Used for ChatGPT text generation and the hero image generator.' },
  { key: 'anthropic_api_key', label: 'Anthropic (Claude) API key', hint: 'Used for Claude text generation.' },
  { key: 'gemini_api_key', label: 'Google Gemini API key', hint: 'Used for Gemini text generation.' },
] as const;
---
<AdminLayout title="Settings" admin={admin}>
  <div class="admin-head">
    <h1>Settings</h1>
    <p class="admin-sub">API keys for AI-assisted blog post generation</p>
  </div>

  {loadError && <p class="form-error-summary" role="alert">{loadError}</p>}

  {!loadError && (
    <div class="admin-add admin-settings-card">
      <form id="settings-form" class="admin-add-form">
        <p class="form-error-summary" id="settings-error" role="alert" hidden></p>
        <p class="admin-note" id="settings-saved" hidden>Saved.</p>
        {fields.map((f) => (
          <div class="field field-wide">
            <label for={f.key}>{f.label}</label>
            <input
              id={f.key}
              name={f.key}
              type="password"
              autocomplete="off"
              placeholder={masked[f.key] ? `Currently set (ends ${masked[f.key]})` : 'Not set'}
            />
            <p class="admin-field-hint">{f.hint}</p>
          </div>
        ))}
        <button type="submit" class="btn btn-navy">Save settings</button>
      </form>
    </div>
  )}

  {!loadError && (
    <section class="admin-section">
      <h2>MCP access</h2>
      <p class="admin-note">
        Lets an AI chat client (Claude, ChatGPT, or anything that speaks MCP) create, edit, publish
        and unpublish blog posts, landing pages and service pages through a conversation — including
        generating a hero image for a blog post. A chat client with an MCP token can put any of these
        live on its own, with no review step in between: treat it the same as any other author with
        access to <a href="/admin/blog">/admin/blog</a>,
        <a href="/admin/landing-pages">/admin/landing-pages</a> or
        <a href="/admin/service-pages">/admin/service-pages</a>.
      </p>
      <p class="admin-note">
        Publishing is always a separate, explicit step from writing — never automatic — and it can
        preview what would happen first (<code>dry_run</code>) before committing. Editing a page that's
        already live still works and takes effect immediately, but a snapshot of the page from just
        before the edit is kept, so what changed is reconstructable afterwards. The one thing that
        stays fully locked down: no discount or offer wording can be set while writing or editing a
        landing page — turning the site's existing, fixed promotion on or off for a page is its own
        separate tool, so a real discount only ever appears somewhere with a deliberate, explicit
        instruction to put it there.
      </p>
      <p class="admin-note">
        Most chat clients — including Claude.ai's own connector setup — can sign in on their own
        with the server URL below: no token to copy. If a client instead asks for an API key or
        bearer token, create one below and paste that in instead.
      </p>

      <div class="field field-wide" style="margin-bottom:18px;">
        <label for="mcp-url">Server URL &mdash; paste this into the connector's URL field</label>
        <input id="mcp-url" type="text" readonly value={mcpUrl} onfocus="this.select()">
      </div>

      <div id="mcp-reveal" class="admin-note" role="alert" hidden style="border:1px solid var(--border); border-radius:var(--radius); padding:14px 16px; background:var(--bg);">
        <p style="margin:0 0 8px;"><strong>Copy this token now &mdash; it will not be shown again.</strong> Paste it into the connector as a bearer token / API key.</p>
        <div class="field field-wide" style="margin:0;">
          <label for="mcp-reveal-value">Your new token</label>
          <input id="mcp-reveal-value" type="text" readonly onfocus="this.select()">
        </div>
        <button type="button" class="btn btn-ghost" id="mcp-copy-btn" style="margin-top:8px;">Copy</button>
      </div>

      {mcpTokens.length === 0 ? (
        <p class="admin-empty">No tokens yet.</p>
      ) : (
        <div class="admin-table-scroll" tabindex="0">
          <table class="admin-table">
            <thead>
              <tr><th>Name</th><th>Created</th><th>Last used</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
              {mcpTokens.map((t) => (
                <tr>
                  <td>{t.name}</td>
                  <td class="admin-nowrap">{fmtDate(t.created_at)}</td>
                  <td class="admin-dim">{fmtDate(t.last_used_at) ?? 'Never'}</td>
                  <td><span class:list={['admin-urgency', t.revoked_at ? 'is-draft' : 'is-live']}>{t.revoked_at ? 'Revoked' : 'Active'}</span></td>
                  <td>
                    {!t.revoked_at && (
                      <button type="button" class="btn btn-ghost mcp-revoke-btn" data-token-id={t.id}>Revoke</button>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      <div class="admin-add admin-settings-card" style="margin-top:18px;">
        <form id="mcp-create-form" class="admin-add-form">
          <p class="form-error-summary" id="mcp-error" role="alert" hidden></p>
          <div class="field field-wide">
            <label for="mcp-name">New token name</label>
            <input id="mcp-name" name="name" type="text" required maxlength="80" placeholder="e.g. Claude connector">
          </div>
          <button type="submit" class="btn btn-navy">Create token</button>
        </form>
      </div>
    </section>
  )}
</AdminLayout>

<script src="/admin-settings.js" is:inline></script>
<script src="/admin-mcp.js" is:inline></script>
