---
// Postcode district pages.
//
// These are coverage pages, not a second set of area pages. A district spans
// several named neighbourhoods and often more than one borough, and that list
// is what makes each one different — so the page is built around it and
// deliberately carries no invented local prose. Where an area page exists for
// the district's main neighbourhood, the page hands off to it prominently,
// because that is the page written to rank.
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { postcodes, INDEX_POSTCODE_PAGES } from '../../data/postcodes';
import { areas } from '../../data/areas';
import { services } from '../../data/services';
import { appliances } from '../../data/appliances';
import HeroWithForm from '../../components/HeroWithForm.astro';
import Schema from '../../components/Schema.astro';
import PhoneIcon from '../../components/PhoneIcon.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';

export function getStaticPaths() {
  return postcodes.map((pc) => ({ params: { slug: pc.slug }, props: { pc } }));
}

const { pc } = Astro.props;

const areaPage = pc.areaSlug ? areas.find((a) => a.slug === pc.areaSlug) : null;

// Other districts nearby: those sharing a borough first, then the rest of
// the region in list order, starting from this district and wrapping round.
// Taking the first twelve of the region instead left the later districts
// with almost no links in.
const region = postcodes.filter((p) => p.region === pc.region);
const at = region.findIndex((p) => p.slug === pc.slug);
const byDistance = region
  .map((p, i) => ({ p, d: Math.min(Math.abs(i - at), region.length - Math.abs(i - at)) }))
  .filter(({ p }) => p.slug !== pc.slug)
  .sort((x, y) => x.d - y.d)
  .map(({ p }) => p);
const sharesBorough = (p: (typeof postcodes)[number]) => p.boroughs.some((b) => pc.boroughs.includes(b));
const siblings = [...byDistance.filter(sharesBorough), ...byDistance.filter((p) => !sharesBorough(p))].slice(0, 12);

const boroughList =
  pc.boroughs.length === 1
    ? pc.boroughs[0]
    : pc.boroughs.slice(0, -1).join(', ') + ' and ' + pc.boroughs[pc.boroughs.length - 1];

const places = [pc.primary, ...pc.neighbourhoods];
const placeList =
  places.length === 1
    ? places[0]
    : places.slice(0, -1).join(', ') + ' and ' + places[places.length - 1];

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Areas We Cover', href: '/areas-we-cover' },
  { label: `${pc.district} postcode`, href: '/postcodes' },
  { label: pc.district },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  name: `${site.name} — ${pc.district}`,
  url: `${site.url}/postcodes/${pc.slug}`,
  telephone: site.booking.tel,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.line1,
    addressLocality: site.address.city,
    postalCode: site.address.postcode,
    addressCountry: site.address.country,
  },
  areaServed: pc.boroughs.map((b) => ({ '@type': 'AdministrativeArea', name: b })),
};

const faqs = [
  {
    q: `Which neighbourhoods are in the ${pc.district} postcode district?`,
    a: `${pc.district} takes in ${placeList}, within ${boroughList}. Our engineers work in every part of it.`,
  },
];

// Metadata is length-budgeted rather than assembled and hoped for: Google
// truncates titles around 60 characters and descriptions around 160, and
// district names like "Crystal Palace and Upper Norwood" blow through both.
const shortPrimary = pc.primary.split(' and ')[0];
const longTitle = `${pc.district} Plumber | ${pc.primary} | Ninja Plumbers`;
const title = longTitle.length <= 60
  ? longTitle
  : `${pc.district} Plumber | ${shortPrimary} | Ninja Plumbers`;

// Fit as many neighbourhood names as the description budget allows.
const fitPlaces = (budget: number) => {
  const out: string[] = [];
  let used = 0;
  for (const name of places) {
    const add = (out.length ? ', ' : '') + name;
    if (used + add.length > budget) break;
    out.push(name);
    used += add.length;
  }
  return out.length ? out.join(', ') : places[0];
};
const description = `${pc.district} plumber for ${fitPlaces(40)}. Boiler repairs, blocked drains, bathroom fitting and emergency callouts. Call us on ${site.booking.display}.`;
---
<Base title={title} description={description} noindex={!INDEX_POSTCODE_PAGES}>
  <Schema slot="head" breadcrumb={crumbs} faqs={faqs} extra={schema} />

  <HeroWithForm
    eyebrow={`${pc.region} · ${pc.district}`}
    h1={`Plumber in ${pc.district}`}
    intro={`Plumbing, heating and drainage work in every part of ${pc.district}. The district spans ${places.slice(0, 3).join(', ')}${places.length > 3 ? ', plus the streets in between' : ''}.`}
    breadcrumb={crumbs}
    bullets={[
      'Insured, and on the Gas Safe Register',
      '24/7 emergency callout',
      'You agree the price before we start',
      'Our workmanship is guaranteed',
    ]}
    formHeading={`Your ${pc.district} price`}
  />

  <section class="section">
    <div class="container">
      <span class="eyebrow">The district</span>
      <h2>Places inside {pc.district}</h2>
      <p class="measure">
        {pc.district} is a {pc.region.toLowerCase()} district that spans {boroughList}.
        {places.length > 1
          ? ` Our engineers work in all ${places.length} of the named areas listed here.`
          : ' Our engineers cover the full district.'}
      </p>
      <ul class="pc-places">
        {places.map((n) => <li>{n}</li>)}
      </ul>

      {areaPage && (
        <div class="pc-handoff">
          <h3>Searching for {areaPage.name} in particular?</h3>
          <p>
            {areaPage.name} is the principal neighbourhood in {pc.district}. Its own page goes into
            the housing there and the plumbing faults those buildings tend to have.
          </p>
          {/* btn-navy, not btn-outline: this block sits on a light section and
              btn-outline is white-on-transparent, built for the navy sections. */}
          <p><a href={`/areas/${areaPage.slug}`} class="btn btn-navy">{areaPage.name} plumbing page</a></p>
        </div>
      )}
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h2>Our work in {pc.district}</h2>
      <p class="measure">
        Nothing here differs from our work elsewhere in London. Open any service to see what is
        included and what is worth checking before you get in touch.
      </p>
      <ul class="combo-links">
        {services.map((s) => (
          <li><a href={`/services/${s.slug}`} set:html={s.title} /></li>
        ))}
      </ul>
    </div>
  </section>

  {/* Same reasoning as the area pages: appliance-per-postcode was tested
      against the 140/month bar and did not clear it, so this is the link
      down rather than a 14th URL for every district. */}
  <section class="section">
    <div class="container">
      <span class="eyebrow">Fixtures and appliances</span>
      <h2>{pc.district} appliance and fixture fitting</h2>
      <ul class="combo-links">
        {appliances.map((a) => (
          <li><a href={`/appliances/${a.slug}`}>{a.title}</a></li>
        ))}
        <li><a href="/appliances">The full appliance list</a></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">FAQ</span>
      <h2>{pc.district}, answered</h2>
      <dl class="faq">
        {faqs.map((f) => (
          <div class="faq-item">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {siblings.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <span class="eyebrow">Close by</span>
        <h2>Further {pc.region.toLowerCase()} postcodes</h2>
        <ul class="combo-links">
          {siblings.map((s) => (
            <li><a href={`/postcodes/${s.slug}`}>{s.district} plumber</a></li>
          ))}
          <li><a href="/postcodes">The full district list</a></li>
        </ul>
      </div>
    </section>
  )}

  <section class="section section-navy">
    <div class="container center measure-wide">
      <h2>Plumbing problem in {pc.district}?</h2>
      <p>
        Send your postcode and a short account of the fault. You get the price
        before any work gets under way.
      </p>
      <div class="cta-row center-row">
        <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
          <PhoneIcon /> Call {site.booking.display}
        </a>
        <a href={site.whatsapp.url} class="btn btn-outline btn-lg">
          <WhatsAppIcon /> WhatsApp us
        </a>
      </div>
    </div>
  </section>
</Base>
