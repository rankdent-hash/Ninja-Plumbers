---
// Hub for the appliance and fixture pages, grouped the way the data is.
// Mirrors /boilers: a section outside /services with its own index, so the
// service pages keep the clean /services/[slug] namespace.
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { appliances, applianceGroups } from '../../data/appliances';
import { services } from '../../data/services';
import ServiceIcon from '../../components/ServiceIcon.astro';
import PhoneIcon from '../../components/PhoneIcon.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import HeroWithForm from '../../components/HeroWithForm.astro';
import Schema from '../../components/Schema.astro';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Appliances & fixtures' },
];

const grouped = applianceGroups.map((g) => ({
  ...g,
  items: appliances.filter((a) => a.group === g.slug),
}));

// Named here so the hub can point back at the core services rather than being
// a dead end that only goes downwards.
const backTo = ['general-plumbing', 'boiler-service', 'bathroom-installation']
  .map((slug) => services.find((s) => s.slug === slug)!);

const faqs = [
  {
    q: 'Does a washing machine or dishwasher need a plumber to connect it?',
    a: 'Where a cold feed with an isolating valve and a waste connection are already in the right spot, hooking up a new machine is normally straightforward. A plumber is needed when any of those are missing, badly placed or leaking, or when the machine is going somewhere new that needs its own supply and waste run.',
  },
  {
    q: 'How can I tell whether my heating needs power flushing?',
    a: 'Look for radiators that are warm at the top but cold along the bottom, a boiler that is noisy or keeps cutting out, and black or brown water when a radiator is bled. Each of these suggests sludge in the system. Flushing removes it; bleeding the radiators does not.',
  },
  {
    q: 'Is it worth having a water softener in London?',
    a: 'Because London’s water is hard, a softener reduces limescale on taps, showers and glass, as well as inside boilers, cylinders and appliances. Whether that makes it worthwhile depends on your home and how much the scale bothers you. The pros and cons are laid out in our blog post on water softeners in London.',
  },
  {
    q: 'How does a Saniflo differ from a sump pump?',
    a: 'A Saniflo, also called a macerator, pumps waste away from a toilet, basin or shower where there is not enough fall for ordinary gravity drainage, as in a basement or loft bathroom. A sump pump deals with groundwater or surface water gathering in a pit, usually in a basement or cellar, and pumps it out.',
  },
  {
    q: 'What has to go under the sink for a boiling water tap?',
    a: 'Most models need cupboard space below for a small tank, a cold water supply and an electrical socket to power the tank. Some include a filter that needs replacing now and then. We check the space and the supply before fitting the tap.',
  },
];
---
<Base
  title="Appliance &amp; Fixture Plumbing in London | Ninja Plumbers"
  description={`Across London, Ninja Plumbers installs and repairs water softeners, underfloor heating, boiling taps and pumps, and does power flushing. Call ${site.booking.display}.`}
>
  <Schema slot="head" breadcrumb={crumbs} faqs={faqs} />

  <HeroWithForm
    eyebrow="Appliances & fixtures"
    h1="Appliance and fixture plumbing across London"
    intro="People tend to look for these jobs by the item itself rather than by trade: a boiling tap, a power flush, a softener, a pump that has stopped working. Ninja Plumbers gives each one a page of its own, setting out what the work involves and what to check before you book."
    breadcrumb={crumbs}
    bullets={[
      'Gas Safe registered and fully insured',
      'DBS-checked engineers',
      'Emergency callout available 24/7',
      'Price agreed before work starts',
      'Workmanship guaranteed',
    ]}
    formHeading="What would you like fitted?"
  />

  {grouped.map((g) => (
    <section class="section">
      <div class="container">
        <span class="eyebrow">{g.label}</span>
        <h2>{g.label}</h2>
        <p class="measure">{g.blurb}</p>
        <ul class="grid grid-3 card-grid">
          {g.items.map((a) => (
            <li class="card" id={a.slug}>
              <div class="icon"><ServiceIcon name={a.icon} /></div>
              <h3><a href={`/appliances/${a.slug}`} class="card-title-link">{a.title}</a></h3>
              <p>{a.summary}</p>
              <a href={`/appliances/${a.slug}`} class="card-link" aria-label={`More on ${a.title}`}>
                Read more <span aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section section-alt">
    <div class="container measure-wide">
      <span class="eyebrow">FAQs</span>
      <h2>Questions people ask</h2>
      <div class="faqs">
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="measure" style="margin-top:24px;">
        Further reading on the blog: <a href="/blog/is-a-water-softener-worth-it-in-london">water softeners in London</a>,
        <a href="/blog/what-is-a-saniflo-and-when-do-you-need-one">Saniflo pumps</a> and
        <a href="/blog/why-outside-taps-freeze-and-burst">outside taps in winter</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Something else?</span>
      <h2>Our core services</h2>
      <p class="measure">
        After a repair instead of a new fitting? You will most likely find it on one of these pages.
      </p>
      <ul class="grid grid-3 card-grid">
        {backTo.map((s) => (
          <li class="card">
            <div class="icon"><ServiceIcon name={s.icon} /></div>
            <h3><a href={`/services/${s.slug}`} class="card-title-link" set:html={s.title} /></h3>
            <p>{s.summary}</p>
            <a href={`/services/${s.slug}`} class="card-link">
              More on {s.title.replace('&amp;', 'and')} <span aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
      <p><a href="/services" class="btn btn-navy">Browse every service</a></p>
    </div>
  </section>

  <section class="section section-navy">
    <div class="container center measure-wide">
      <h2>Unsure which of these fits?</h2>
      <p>Describe the real problem &mdash; scale, low pressure, a leak, an appliance that refuses to empty &mdash; and Ninja Plumbers will tell you which of these deals with it. If none of them is the answer, we will say so instead of selling you the wrong job.</p>
      <div class="cta-row center-row">
        <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
          <PhoneIcon /> Call {site.booking.display}
        </a>
        <a href={site.whatsapp.url} class="btn btn-outline btn-lg">
          <WhatsAppIcon /> WhatsApp us
        </a>
      </div>
    </div>
  </section>
</Base>
