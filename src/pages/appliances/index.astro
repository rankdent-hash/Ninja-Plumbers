---
// Hub for the appliance and fixture pages, grouped the way the data is.
// Mirrors /boilers: a section outside /services with its own index, so the
// service pages keep the clean /services/[slug] namespace.
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { appliances, applianceGroups } from '../../data/appliances';
import { services } from '../../data/services';
import ServiceIcon from '../../components/ServiceIcon.astro';
import PhoneIcon from '../../components/PhoneIcon.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import HeroWithForm from '../../components/HeroWithForm.astro';
import Schema from '../../components/Schema.astro';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Appliances & fixtures' },
];

const grouped = applianceGroups.map((g) => ({
  ...g,
  items: appliances.filter((a) => a.group === g.slug),
}));

// Named here so the hub can point back at the core services rather than being
// a dead end that only goes downwards.
const backTo = ['general-plumbing', 'boiler-service', 'bathroom-installation']
  .map((slug) => services.find((s) => s.slug === slug)!);

const faqs = [
  {
    q: 'Do I need a plumber to connect a washing machine or dishwasher?',
    a: 'If there is already a cold feed with an isolating valve and a waste connection in the right place, connecting a new machine is usually simple. You need a plumber when those are missing, in the wrong place, leaking, or when the machine is moving to a new spot and needs a new supply and waste run.',
  },
  {
    q: 'How do I know if my heating needs a power flush?',
    a: 'The usual signs are radiators that are warm at the top and cold along the bottom, a boiler that is noisy or keeps cutting out, and black or brown water when you bleed a radiator. All of them point to sludge in the system. A flush clears it; bleeding the radiators will not.',
  },
  {
    q: 'Is a water softener worth it in London?',
    a: 'London water is hard, so a softener cuts limescale on taps, showers and glass, and inside boilers, cylinders and appliances. Whether it is worth it depends on your home and how much scale bothers you. Our blog post on water softeners in London sets out the pros and cons.',
  },
  {
    q: 'What is the difference between a Saniflo and a sump pump?',
    a: 'A Saniflo, or macerator, pumps waste from a toilet, basin or shower away where there is no fall for normal gravity drainage, such as a basement or loft bathroom. A sump pump removes groundwater or surface water that collects in a pit, usually in a basement or cellar, and pumps it out.',
  },
  {
    q: 'What does a boiling water tap need under the sink?',
    a: 'Most need room in the cupboard below for a small tank, a cold water supply, and an electrical socket for the tank. Some also have a filter that needs changing from time to time. We check the space and the supply before the tap goes in.',
  },
];
---
<Base
  title="Appliance &amp; Fixture Plumbing | Ninja Plumbers London"
  description={`Ninja Plumbers fits and repairs water softeners, underfloor heating, power flushing, boiling taps and pumps across London. Call ${site.booking.display}.`}
>
  <Schema slot="head" breadcrumb={crumbs} faqs={faqs} />

  <HeroWithForm
    eyebrow="Appliances & fixtures"
    h1="Appliance and fixture plumbing in London"
    intro="These are the jobs people search for by naming the thing, not the trade — a softener, a power flush, a boiling tap, a pump that's given up. Ninja Plumbers has given each one its own page covering what's involved and what's worth checking first."
    breadcrumb={crumbs}
    bullets={[
      'Gas Safe registered and fully insured',
      'DBS-checked engineers',
      'Emergency callout available 24/7',
      'Price agreed before work starts',
      'Workmanship guaranteed',
    ]}
    formHeading="Tell us what needs fitting"
  />

  {grouped.map((g) => (
    <section class="section">
      <div class="container">
        <span class="eyebrow">{g.label}</span>
        <h2>{g.label}</h2>
        <p class="measure">{g.blurb}</p>
        <ul class="grid grid-3 card-grid">
          {g.items.map((a) => (
            <li class="card" id={a.slug}>
              <div class="icon"><ServiceIcon name={a.icon} /></div>
              <h3><a href={`/appliances/${a.slug}`} class="card-title-link">{a.title}</a></h3>
              <p>{a.summary}</p>
              <a href={`/appliances/${a.slug}`} class="card-link" aria-label={`More on ${a.title}`}>
                Read more <span aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section section-alt">
    <div class="container measure-wide">
      <span class="eyebrow">Questions</span>
      <h2>Common questions</h2>
      <div class="faqs">
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="measure" style="margin-top:24px;">
        More help on our blog: <a href="/blog/is-a-water-softener-worth-it-in-london">water softeners in London</a>,
        <a href="/blog/what-is-a-saniflo-and-when-do-you-need-one">Saniflo pumps</a> and
        <a href="/blog/why-outside-taps-freeze-and-burst">outside taps in winter</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Looking for something else</span>
      <h2>The main services</h2>
      <p class="measure">
        Looking for a repair rather than a new fitting? It's probably one of the pages below.
      </p>
      <ul class="grid grid-3 card-grid">
        {backTo.map((s) => (
          <li class="card">
            <div class="icon"><ServiceIcon name={s.icon} /></div>
            <h3><a href={`/services/${s.slug}`} class="card-title-link" set:html={s.title} /></h3>
            <p>{s.summary}</p>
            <a href={`/services/${s.slug}`} class="card-link">
              More on {s.title.replace('&amp;', 'and')} <span aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
      <p><a href="/services" class="btn btn-navy">All services</a></p>
    </div>
  </section>

  <section class="section section-navy">
    <div class="container center measure-wide">
      <h2>Not sure which one you need?</h2>
      <p>Tell us what's actually wrong &mdash; scale, pressure, a leak, a machine refusing to drain &mdash; and Ninja Plumbers will point you to whichever of these fixes it. Sometimes none of them are the answer, and we'll tell you that too rather than sell you the wrong job.</p>
      <div class="cta-row center-row">
        <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
          <PhoneIcon /> Call {site.booking.display}
        </a>
        <a href={site.whatsapp.url} class="btn btn-outline btn-lg">
          <WhatsAppIcon /> WhatsApp us
        </a>
      </div>
    </div>
  </section>
</Base>
