---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { allAreas as areas } from '../../data/areas';
import { services } from '../../data/services';
import { combos } from '../../data/combos';
import { postcodes } from '../../data/postcodes';
import { appliances } from '../../data/appliances';
import HeroWithForm from '../../components/HeroWithForm.astro';
import Schema from '../../components/Schema.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import Tick from '../../components/Tick.astro';
import PhoneIcon from '../../components/PhoneIcon.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';

export function getStaticPaths() {
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

const { area } = Astro.props;
const outside = area.region === 'outside';
const HEADING: Record<string, string> = {
  'emergency-plumbing': 'Emergency plumber',
  'boiler-repair': 'Boiler repair',
  'boiler-service': 'Boiler service',
  'boiler-installation': 'Boiler installation',
  'boiler-replacement': 'Boiler replacement',
  'bathroom-installation': 'Bathroom installation',
  'drain-unblocking': 'Drain unblocking',
};
const localPages = combos
  .filter((c) => c.area === area.slug)
  .sort((a, b) => b.volume - a.volume);

// Link a listed postcode through to its district page where one exists, so
// the district pages are reachable from every area that sits in them.
const districtSlugs = new Set(postcodes.map((p) => p.slug));
const hasDistrict = (pc: string) => districtSlugs.has(pc.toLowerCase());

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Areas We Cover', href: '/areas-we-cover' },
  { label: area.name },
];

// Two-way: an area also lists every area that names it as a neighbour, so
// no area page depends on a single list elsewhere for its links.
const nearbySlugs = [
  ...area.nearby,
  ...areas.filter((a) => a.nearby.includes(area.slug) && !area.nearby.includes(a.slug)).map((a) => a.slug),
];
const nearby = nearbySlugs
  .map((s) => areas.find((a) => a.slug === s))
  .filter(Boolean);

// Three questions per area, built from the area's own data so each page's
// answers differ: its postcodes and council, its most common jobs, and
// (outside London) an honest word on distance. No response times.
const PROPER = new Set(['Victorian', 'Edwardian', 'Georgian', 'Warner', 'Thames', 'London']);
const lowerFirst = (t: string) => (PROPER.has(t.split(/[\s,]/)[0]) ? t : t.charAt(0).toLowerCase() + t.slice(1));
const where = outside ? `${area.borough}, ${area.county}` : `the London Borough of ${area.borough}`;
const faqs = [
  {
    q: `Do you work in every part of ${area.name}?`,
    a: `Yes. Our area takes in the whole of ${area.name}, along with the ${area.postcodes.join(', ')} postcode ${area.postcodes.length > 1 ? 'districts' : 'district'}, in ${where}. Council lines and postcode lines often differ, so if you are not sure, look up your postcode on our areas page or ring us.`,
  },
  {
    q: `Which plumbing faults are most common in ${area.name}?`,
    a: `The jobs that come up most here are ${area.common.map(lowerFirst).join('; ')}.`,
    list: area.common,
  },
  {
    q: `Do you send emergency plumbers to ${area.name}?`,
    a: outside
      ? `Yes. Someone answers our emergency line at any hour, day or night, for burst pipes, major leaks, loss of water and loss of heating. ${area.name} is a longer trip from our Fulham base than our London areas are, so on the call we will give you an honest time for when an engineer can reach you. Ring ${site.booking.display}.`
      : `Yes. Someone answers our emergency line at any hour, day or night, for burst pipes, major leaks, loss of water and loss of heating in ${area.name}. On the call we will give you an honest time for when an engineer can reach you. Ring ${site.booking.display}.`,
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  name: `${site.name} — ${area.name}`,
  url: `${site.url}/areas/${area.slug}`,
  telephone: site.booking.tel,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.line1,
    addressLocality: site.address.city,
    postalCode: site.address.postcode,
    addressCountry: site.address.country,
  },
  areaServed: {
    '@type': 'Place',
    name: `${area.name}, ${outside ? area.county : 'London'}`,
    containedInPlace: { '@type': 'AdministrativeArea', name: area.borough },
  },
};
---
<Base title={area.metaTitle} description={area.metaDescription}>
  <Schema slot="head" breadcrumb={crumbs} faqs={faqs.map(({ q, a }) => ({ q, a }))} extra={schema} />

  <HeroWithForm
    eyebrow={`${area.borough} · ${area.postcodes.join(', ')}`}
    h1={`Plumber in ${area.name}`}
    intro={area.intro}
    breadcrumb={crumbs}
    bullets={[
      'Fully insured and on the Gas Safe Register',
      'Every engineer DBS-checked',
      'Callouts for emergencies at any hour',
      'You know the price before we begin',
    ]}
    formHeading={`Get a plumber in ${area.name}`}
  />

  <section class="section">
    <div class="container service-row">
      <div class="service-copy">
        <span class="eyebrow">The local picture</span>
        <h2>Homes and plumbing in {area.name}</h2>
        <p class="lead">{area.character}</p>
        {area.note && <p class="area-note">{area.note}</p>}
      </div>
      <aside class="service-aside">
        <h3>Jobs we see a lot here</h3>
        <ul class="ticks">
          {area.common.map((c) => <li><Tick /> {c}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">How we can help</span>
      <h2>Plumbing and heating services in {area.name}</h2>
      <ul class="grid grid-3 card-grid">
        {services.map((s) => (
          <li class="card">
            <div class="icon"><ServiceIcon name={s.icon} /></div>
            <h3><a href={`/services/${s.slug}`} class="card-title-link" set:html={s.title} /></h3>
            <p>{s.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Appliance work has no page of its own per area — tested against the
      same 140/month bar as the combos above and it does not clear it (see
      rejectedApplianceAreas in rejected.ts). This is how it stays reachable
      from {area.name} without 14 more near-duplicate URLs. */}
  <section class="section">
    <div class="container">
      <span class="eyebrow">Fitted and replaced</span>
      <h2>Fixtures and appliances in {area.name}</h2>
      <p class="measure">Softeners, pumps and taps are among the other things we fit. Each has a page of its own that sets out what the work involves.</p>
      <ul class="combo-links">
        {appliances.map((a) => (
          <li><a href={`/appliances/${a.slug}`}>{a.title}</a></li>
        ))}
        <li><a href="/appliances">See all appliance work</a></li>
      </ul>
    </div>
  </section>

  {localPages.length > 0 && (
    <section class="section">
      <div class="container">
        <span class="eyebrow">Job by job</span>
        <h2>Frequent callouts in {area.name}</h2>
        <ul class="combo-links">
          {localPages.map((c) => (
            <li><a href={`/services/${c.service}/${c.area}`}>{HEADING[c.service]} in {area.name}</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section section-alt">
    <div class="container">
      <div class="coverage-split">
        <div class="check-area">
          <h2>Postcodes we serve</h2>
          <ul class="postcode-chips">
            {area.postcodes.map((p) => (
              <li>{hasDistrict(p) ? <a href={`/postcodes/${p.toLowerCase()}`}>{p}</a> : p}</li>
            ))}
          </ul>
          <p class="small">
            {outside
              ? `${area.name} is in ${area.borough}, ${area.county}.`
              : `${area.name} is part of the London Borough of ${area.borough}.`} Council boundaries
            and postcode boundaries seldom line up perfectly. If you cannot see your postcode here,
            ring us and we&rsquo;ll tell you whether it is one we serve.
          </p>
          <div class="cta-row">
            <a href={`tel:${site.booking.tel}`} class="btn btn-orange">
              <PhoneIcon /> Call {site.booking.display}
            </a>
          </div>
        </div>

        {nearby.length > 0 && (
          <div class="check-area">
            <h2>Neighbouring areas</h2>
            <p class="small">{outside
              ? `The towns around ${area.name} are covered too:`
              : `Our coverage spans all of Greater London. These areas border ${area.name}:`}</p>
            <ul class="nearby-list">
              {nearby.map((n) => (
                <li>
                  <a href={`/areas/${n.slug}`}>
                    <strong>Plumber in {n.name}</strong>
                    <span>{n.borough}</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="small"><a href="/areas-we-cover">View every area we cover</a></p>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container measure-wide">
      <span class="eyebrow">FAQs</span>
      <h2>Questions about plumbing in {area.name}</h2>
      <div class="faqs">
        {faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            {f.list ? (
              <>
                <p>The jobs that come up most here:</p>
                <ul class="faq-list">{f.list.map((item) => <li>{item}</li>)}</ul>
              </>
            ) : (
              <p>{f.a}</p>
            )}
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-navy">
    <div class="container center measure-wide">
      <h2>Book a plumber in {area.name}</h2>
      <p>Share your postcode and what has gone wrong, and we&rsquo;ll quote a price before any tools come out.</p>
      <div class="cta-row center-row">
        <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
          <PhoneIcon /> Call {site.booking.display}
        </a>
        <a href={site.whatsapp.url} class="btn btn-outline btn-lg">
          <WhatsAppIcon /> WhatsApp us
        </a>
      </div>
    </div>
  </section>
</Base>
