---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { services } from '../data/services';
import { areas } from '../data/areas';
import ServiceIcon from '../components/ServiceIcon.astro';
import PhoneIcon from '../components/PhoneIcon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';

const topAreas = areas.slice(0, 6);
---
<Base
  title="Page not found | Tamesis Plumbers"
  description="That page doesn't exist. Find the service you need, or call 020 3488 3737."
  noindex
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>That page doesn&rsquo;t exist</h1>
      <p>The link may be old, or there may be a typo in the address. If you have a plumbing emergency, don&rsquo;t hunt around &mdash; just call.</p>
      <div class="cta-row">
        <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
          <PhoneIcon /> Call {site.booking.display}
        </a>
        <a href={site.whatsapp.url} class="btn btn-outline btn-lg">
          <WhatsAppIcon /> WhatsApp us
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">What we do</span>
      <h2>Looking for one of these?</h2>
      <ul class="grid grid-3 card-grid">
        {services.map((s) => (
          <li class="card">
            <div class="icon"><ServiceIcon name={s.icon} /></div>
            <h3><a href={`/services/${s.slug}`} class="card-title-link" set:html={s.title} /></h3>
            <p>{s.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">Where we work</span>
      <h2>Or an area</h2>
      <ul class="combo-links">
        {topAreas.map((a) => (
          <li><a href={`/areas/${a.slug}`}>Plumber in {a.name}</a></li>
        ))}
        <li><a href="/areas-we-cover">All areas we cover</a></li>
        <li><a href="/">Back to the homepage</a></li>
      </ul>
    </div>
  </section>
</Base>
