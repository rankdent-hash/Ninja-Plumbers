---
// Server-rendered rather than statically generated, for the same reason
// /lp/[slug].astro is: a service page published in /admin/service-pages or
// via MCP used to have no URL at all until the next deploy rebuilt the
// static paths, however "published" it looked everywhere else.
//
// The 19 real trade services are matched from the in-memory array, so they
// never depend on the database resolving. The one query below serves both
// the fallback lookup for an MCP-created slug and the "we also handle" list,
// and a short edge cache (see the Cache-Control header) keeps repeat hits
// off the function entirely.
//
// One consequence worth knowing: sitemap.xml is still generated at build
// time (see astro.config.mjs, which now lists these URLs explicitly since
// they are no longer crawlable from the static output). A newly published
// page is live and cross-linked immediately; its sitemap entry lands on the
// next deploy.
export const prerender = false;

import { SCHEMA_AREA_SERVED } from '../../data/serviceArea';
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { services } from '../../data/services';
import { appliances } from '../../data/appliances';
import { blogPosts } from '../../data/blog';
import { combos } from '../../data/combos';
import { areas, allAreas } from '../../data/areas';
import { serviceGroups } from '../../data/nav';
import { brands } from '../../data/brands';
import { lowerTitle } from '../../lib/text';
import { groupedSectors, sectorsLinkingTo } from '../../data/sectors';
import SectorPictogram from '../../components/SectorPictogram.astro';
import { dampPages } from '../../data/damp';
import ServiceIcon from '../../components/ServiceIcon.astro';
import Tick from '../../components/Tick.astro';
import PhoneIcon from '../../components/PhoneIcon.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import HeroWithForm from '../../components/HeroWithForm.astro';
import Schema from '../../components/Schema.astro';
import { serviceExtras } from '../../data/service-extras';
import { getSupabaseAdmin } from '../../lib/supabaseAdmin';
import { publishedServicePages } from '../../lib/servicePages';

// The 19 real trade services in services.ts are hand-written and untouched
// here. Published AI/MCP-created pages (see /admin/service-pages) live in
// Supabase and render through this same template, so a new service page
// reads identically to every existing one.
const slug = Astro.params.slug;
const aiServices = await publishedServicePages(getSupabaseAdmin());
const allServices = [...services, ...aiServices];
const service = allServices.find((s) => s.slug === slug) ?? null;

if (!service) {
  return new Response('Not found', { status: 404 });
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');
// "Other work we take on" lists the page's own group only (plumbing, heating,
// drainage, bathrooms, air con). It used to list every other service on every
// page — about 750 words repeated site-wide, which diluted each page's topic
// and added nothing unique. The full list stays one click away on /services.
// A published AI-created service belongs to no group, so it falls back to a
// short list rather than everything.
const currentGroup = serviceGroups.find((g) => g.services.includes(service.slug));
const groupOthers = currentGroup
  ? currentGroup.services
      .filter((slug) => slug !== service.slug)
      .map((slug) => allServices.find((s) => s.slug === slug))
      .filter((s): s is (typeof allServices)[number] => Boolean(s))
  : [];
// A group with a single service (electrical, for now) has no siblings, so it
// shows the jobs it most often goes alongside instead of an empty section.
const PAIRED: Record<string, string[]> = {
  'electrical-repairs': ['bathroom-installation', 'shower-installation', 'water-through-ceiling'],
};
const others = groupOthers.length > 0
  ? groupOthers
  : (PAIRED[service.slug] ?? [])
      .map((slug) => allServices.find((s) => s.slug === slug))
      .filter((s): s is (typeof allServices)[number] => Boolean(s))
      .concat(PAIRED[service.slug] ? [] : allServices.filter((s) => s.slug !== service.slug).slice(0, 6));
const othersInGroup = groupOthers.length > 0 && currentGroup;

// Unique per-page sections: what changes the price, extra questions, and (on
// the emergency page) what to have ready when you ring.
const extra = serviceExtras[service.slug];
const allFaqs = [...service.faqs, ...(extra?.extraFaqs ?? [])];

const HEADING: Record<string, string> = {
  'emergency-plumbing': 'Emergency plumber',
  'boiler-repair': 'Boiler repair',
  'boiler-service': 'Boiler service',
  'boiler-installation': 'Boiler installation',
  'boiler-replacement': 'Boiler replacement',
  'bathroom-installation': 'Bathroom installation',
  'drain-unblocking': 'Drain unblocking',
  'air-conditioning-repair': 'Air conditioning repair',
  'air-conditioning-maintenance': 'Air conditioning maintenance',
  'air-conditioning-installation': 'Air conditioning installation',
  'air-conditioning-replacement': 'Air conditioning replacement',
};
const localPages = combos
  .filter((c) => c.service === service.slug)
  .sort((a, b) => b.volume - a.volume);
// The appliance pages that name this service as their parent, so the link
// runs both ways and neither side is reachable only from the footer.
const relatedAppliances = appliances.filter((a) => a.related.includes(service.slug));
// Damp pages that point back at this service (general plumbing, leak
// detection), linked the other way too: a damp patch is often a leak.
const relatedDamp = dampPages.filter((d) => d.related.includes(service.slug));
// Commercial Plumbing lists every sector page; any other service lists the
// sectors whose pages link to it, so links run both ways.
const sectorGroups = service.slug === 'commercial-plumbing' ? groupedSectors : [];
// A popular service can be linked from twenty-odd sector pages; naming them
// all turns one helpful sentence into a list nobody reads. Six, then a link
// to the rest.
const MENTION_CAP = 6;
const allMentions = service.slug === 'commercial-plumbing' ? [] : sectorsLinkingTo(`/services/${service.slug}`);
const sectorMentions = allMentions.slice(0, MENTION_CAP);
const moreMentions = allMentions.length > MENTION_CAP;
// Computed, not hand-maintained: a post links here, so this page links back.
const relatedPosts = blogPosts.filter((p) => p.relatedServices.includes(service.slug));
const label = HEADING[service.slug] ?? service.title.replace('&amp;', 'and');

// "Registered with NICEIC" style wording once the scheme is filled in in
// site.json; a plain "Registered electricians" until then.
const electricalRegistered = site.electricalRegistration?.scheme
  ? `Registered with ${site.electricalRegistration.scheme}`
  : 'Registered electricians';

// Trust points in the hero. Air conditioning leads with the F-Gas
// certification that refrigerant work needs; electrical drops Gas Safe,
// which says nothing about electrical work.
const heroBullets = service.slug.startsWith('air-conditioning-')
  ? ['Refrigerant work by F-Gas certified engineers', 'Engineers DBS-checked and fully insured', 'Price agreed before we start', 'Workmanship guaranteed']
  : currentGroup?.slug === 'electrical'
    ? [electricalRegistered, 'Engineers DBS-checked and fully insured', '24/7 emergency callouts', 'Price agreed before we start', 'Workmanship guaranteed']
    : ['Fully insured and Gas Safe registered', 'Engineers DBS-checked', '24/7 emergency callouts', 'Price agreed before we start', 'Workmanship guaranteed'];
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: service.title.replace('&amp;', 'and') },
];

// Commercial enquiries are better served by the management line.
const isCommercial = service.slug === 'commercial-plumbing';
const primaryTel = isCommercial ? site.management : site.booking;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.metaDescription,
  serviceType: service.title,
  provider: {
    '@type': currentGroup?.slug === 'electrical' ? 'Electrician' : 'Plumber',
    name: site.name,
    telephone: site.booking.tel,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.line1,
      addressLocality: site.address.city,
      postalCode: site.address.postcode,
      addressCountry: site.address.country,
    },
  },
  areaServed: SCHEMA_AREA_SERVED,
};
---
<Base
  title={service.metaTitle}
  description={service.metaDescription}
>
  <Schema slot="head" breadcrumb={crumbs} faqs={allFaqs} extra={serviceSchema} />

  <HeroWithForm
    eyebrow={service.eyebrow}
    h1={service.h1}
    intro={service.intro}
    breadcrumb={crumbs}
    bullets={heroBullets}
    formHeading={`Get a price for ${lowerTitle(service.title)}`}
    service={service.title}
    tel={primaryTel}
  />

  <section class="section">
    <div class="container service-row">
      <div class="service-copy">
        <span class="eyebrow">The work</span>
        <h2>Included in the job</h2>
        <ul class="ticks">
          {service.does.map((d) => <li><Tick /> {d}</li>)}
        </ul>
        <div class="cta-row">
          <a href="/contact#enquiry" class="btn btn-navy">Tell us what you need</a>
        </div>
      </div>
      <aside class="service-aside">
        {service.slug === 'emergency-plumbing' && (
          <figure class="service-aside-figure">
            <img
              src="/images/services/emergency-plumbing-burst-pipe-callout.png"
              width="900"
              height="675"
              alt="Drawing of water spraying from a burst pipe next to a 24/7 callout badge, standing for the Ninja Plumbers emergency plumbing service that runs round the clock in London"
              title="Ninja Plumbers: emergency plumbing callouts, 24/7"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Callouts for major leaks and burst pipes anywhere in London, day or night.</figcaption>
          </figure>
        )}
        {service.slug === 'general-plumbing' && (
          <figure class="service-aside-figure">
            <div class="gp-anim-panel">
              <div class="gp-icons">
                <div class="gp-icon gp-icon-1">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 7h5"/><path d="M6.5 7v6"/><path d="M6.5 10H13a4 4 0 0 1 4 4v1"/><path d="M17 18v3"/><line x1="14" y1="21" x2="20" y2="21"/>
                  </svg>
                  <span class="gp-drop" aria-hidden="true"></span>
                </div>
                <div class="gp-icon gp-icon-2">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 12h18v3a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5v-3z"/><path d="M7 12V5.5a2.5 2.5 0 0 1 5 0"/><line x1="7" y1="20" x2="6" y2="22"/><line x1="17" y1="20" x2="18" y2="22"/>
                  </svg>
                </div>
                <div class="gp-icon gp-icon-3">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="4" y="5" width="16" height="12" rx="2"/><line x1="9" y1="5" x2="9" y2="17"/><line x1="13" y1="5" x2="13" y2="17"/><line x1="17" y1="5" x2="17" y2="17"/><line x1="7" y1="19" x2="7" y2="21"/><line x1="17" y1="19" x2="17" y2="21"/>
                  </svg>
                </div>
                <div class="gp-icon gp-icon-4">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                  </svg>
                </div>
              </div>
              <p class="gp-message"><strong>Pipework, radiators, toilets and taps.</strong> The small household jobs that keep getting put off.</p>
            </div>
            <figcaption>Small jobs get a proper quote too, and are often sorted in a single visit.</figcaption>
          </figure>
        )}
        {service.slug === 'boiler-repair' && (
          <figure class="service-aside-figure">
            <div class="br-anim-panel">
              <div class="br-stage" aria-hidden="true">
                <span class="br-heat br-heat-1"></span>
                <span class="br-heat br-heat-2"></span>
                <span class="br-heat br-heat-3"></span>
                <div class="br-unit">
                  <span class="br-screen">
                    <span class="br-state br-state-1">FAULT</span>
                    <span class="br-state br-state-2">DIAGNOSED</span>
                    <span class="br-state br-state-3">HEAT ON</span>
                  </span>
                  <span class="br-dials"><i></i><i></i></span>
                  <svg class="br-flame" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.07-2.14-.22-4.05 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.15.43-2.29 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
                  </svg>
                </div>
              </div>
              <p class="br-message">
                <strong>We find the fault, then quote.</strong>
                You see a repair price and a replacement price, and the choice is yours.
              </p>
              <a class="br-call" href={`tel:${primaryTel.tel}`}>
                <PhoneIcon /> Call {primaryTel.display}
              </a>
            </div>
            <figcaption>A boiler locked out on a fault code, or no heating or hot water.</figcaption>
          </figure>
        )}
        <div class="icon"><ServiceIcon name={service.icon} /></div>
        <h3>{service.aside.title}</h3>
        <p>{service.aside.body}</p>
      </aside>
    </div>
  </section>

  {service.spaces && (
    <section class="section">
      <div class="container">
        <span class="eyebrow">Where we work</span>
        <h2>Premises we look after</h2>
        <div class="guidance">
          {service.spaces.map((s) => (
            <div class="guidance-item">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">Good to know</span>
      <h2>Read this before you ring</h2>
      <p class="measure">You may find you can sort some of this yourself, without calling us. We are fine with that, and would rather you knew it.</p>
      <div class="guidance">
        {service.guidance.map((g) => (
          <div class="guidance-item">
            <h3>{g.title}</h3>
            <p>{g.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {extra?.haveReady && (
    <section class="section">
      <div class="container measure-wide">
        <span class="eyebrow">Calling us</span>
        <h2>{extra.haveReady.heading}</h2>
        <ul class="ticks">
          {extra.haveReady.items.map((item) => <li><Tick /> {item}</li>)}
        </ul>
      </div>
    </section>
  )}

  {extra?.price && (
    <section class={extra.haveReady ? 'section section-alt' : 'section'}>
      <div class="container">
        <span class="eyebrow">Cost</span>
        <h2>What changes the price</h2>
        <p class="measure">{extra.price.intro}</p>
        <div class="guidance">
          {extra.price.factors.map((f) => (
            <div class="guidance-item">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))}
        </div>
        <p class="measure price-terms">We agree the price with you before any work begins, and accept both card and cash.</p>
      </div>
    </section>
  )}

  <section class={extra?.price && !extra.haveReady ? 'section section-alt' : 'section'}>
    <div class="container measure-wide">
      <span class="eyebrow">Your questions</span>
      <h2>Questions we often get</h2>
      <div class="faqs">
        {allFaqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {localPages.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <span class="eyebrow">Local pages</span>
        <h2>{label} in your area</h2>
        <p class="measure">Pages for the parts of London where we are asked for this most often.</p>
        <ul class="combo-links">
          {localPages.map((c) => {
            const a = allAreas.find((x) => x.slug === c.area)!;
            return <li><a href={`/services/${c.service}/${c.area}`}>{label} in {a.name}</a></li>;
          })}
        </ul>
      </div>
    </section>
  )}

  {relatedAppliances.length > 0 && (
    <section class="section">
      <div class="container">
        <span class="eyebrow">Appliances</span>
        <h2>Appliance jobs linked to this service</h2>
        <p class="measure">
          Each of these installations falls under this service, with a page of its own explaining the work.
        </p>
        <ul class="grid grid-3 card-grid">
          {relatedAppliances.map((a) => (
            <li class="card">
              <div class="icon"><ServiceIcon name={a.icon} /></div>
              <h3><a href={`/appliances/${a.slug}`} class="card-title-link">{a.title}</a></h3>
              <p>{a.summary}</p>
              <a href={`/appliances/${a.slug}`} class="card-link">
                Read about {a.title.toLowerCase()} <span aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <span class="eyebrow">Related services</span>
      <h2>{othersInGroup ? `Other ${currentGroup.label.toLowerCase().replace(/^bathrooms$/, 'bathroom')} jobs we do` : 'Other jobs we do'}</h2>
      <ul class="grid grid-3 card-grid">
        {others.map((s) => (
          <li class="card">
            <div class="icon"><ServiceIcon name={s.icon} /></div>
            <h3>{s.title}</h3>
            <p>{s.summary}</p>
            <a href={`/services/${s.slug}`} class="card-link">
              Read about {s.title} <span aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
      {sectorMentions.length > 0 && (
        <p class="measure">
          Businesses use us for {lowerTitle(service.title)} too, among them {sectorMentions.map((sc, i) => (
            <>{i > 0 && (i === sectorMentions.length - 1 && !moreMentions ? ' and ' : ', ')}<a href={`/commercial/${sc.slug}`}>{sc.name.replace('&', 'and').toLowerCase()}</a></>
          ))}{moreMentions && <>, and <a href="/services/commercial-plumbing">plenty of other business types</a></>}.
        </p>
      )}
      {relatedDamp.length > 0 && (
        <p class="measure">
          Leak or damp? A slow leak can look just like damp, and damp can pass for a leak.
          Read {relatedDamp.map((d, i) => (
            <>{i > 0 && (i === relatedDamp.length - 1 ? ' and ' : ', ')}<a href={`/damp/${d.slug}`}>{d.title.toLowerCase()}</a></>
          ))}, or go to our <a href="/damp">damp and condensation</a> page.
        </p>
      )}
      <p class="all-services-link"><a href="/services">Browse all our services <span aria-hidden="true">&rarr;</span></a></p>
    </div>
  </section>

  {sectorGroups.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <span class="eyebrow">Our business customers</span>
        <h2>Small business plumbing</h2>
        <p class="measure">
          The plumbing in most small premises is much like a home&rsquo;s, only it works harder and can
          less afford to be out of action. Choose your type of business to see what we do for places like yours.
          For toilet and changing-room refits, see <a href="/services/commercial-washroom-refurbishment">commercial washroom refurbishment</a>.
        </p>
        <div class="sector-groups">
          {sectorGroups.map((g) => (
            <div class="sector-group">
              <h3 class="sector-group-h">{g.label}</h3>
              <ul class="sector-tiles">
                {g.sectors.map((sc) => (
                  <li>
                    <a href={`/commercial/${sc.slug}`} class="sector-tile">
                      <span class="sector-tile-icon"><SectorPictogram slug={sc.slug} /></span>
                      <span>{sc.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {relatedPosts.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <span class="eyebrow">Our blog</span>
        <h2>Advice on this topic</h2>
        <ul class="combo-links">
          {relatedPosts.map((p) => (
            <li><a href={`/blog/${p.slug}`}>{p.title}</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {service.slug.startsWith('boiler-') && (
    <section class="section section-alt brand-crosslink">
      <div class="container">
        <span class="eyebrow">Boiler makes</span>
        <h2>Have a particular make of boiler?</h2>
        <p class="measure">
          Every make has its own page, covering what is typical of it and the faults
          it tends to develop.
        </p>
        <ul class="combo-links">
          {brands.map((b) => (
            <li><a href={`/boilers/${b.slug}`}>{b.name}</a></li>
          ))}
        </ul>
        <p><a href="/boilers" class="btn btn-navy">Boiler and gas engineers</a></p>
      </div>
    </section>
  )}

  <section class="section section-navy">
    <div class="container center measure-wide">
      <h2>Looking for {lowerTitle(service.title)} in London?</h2>
      <p>Tell us what is wrong and where you are, and you will have the price before any work begins.</p>
      <div class="cta-row center-row">
        <a href={`tel:${primaryTel.tel}`} class="btn btn-orange btn-lg">
          <PhoneIcon /> Call {primaryTel.display}
        </a>
        <a href={site.whatsapp.url} class="btn btn-outline btn-lg">
          <WhatsAppIcon /> WhatsApp us
        </a>
      </div>
    </div>
  </section>
</Base>
