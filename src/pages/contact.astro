---
/*
 * Contact page, rebuilt to the "Ninja Plumbers Redesign" canvas (Contact —
 * desktop 1440 / Contact — mobile 390).
 *
 * All four contact routes, the office and company details, the "useful
 * details to give us" list, the four steps and the FAQs are the page's own
 * existing copy, restyled. Two things the canvas drew are deliberately not
 * here: the "£25 off your first call-out" offer in its top bar, which is not
 * an offer this business runs, and the Google Maps iframe, which would be the
 * only third-party request on the page — the address links out to directions
 * instead, so nothing about a visitor reaches Google just to render this page.
 */
import Ninja from '../layouts/Ninja.astro';
import NinjaIcon from '../components/ninja/NinjaIcon.astro';
import NinjaQuoteCard from '../components/ninja/NinjaQuoteCard.astro';
import Schema from '../components/Schema.astro';
import site from '../data/site.json';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Contact' }];

const steps = [
  { title: 'You tell us what is happening', body: 'By phone, WhatsApp, email or the form. We ask a few questions, and a photo or a fault code helps us work out what is likely wrong and what the engineer needs to bring.' },
  { title: 'We book the visit', body: 'We agree a time that suits you and tell you about the call-out charge before anyone sets off. For an emergency, we get an engineer moving as soon as one is free.' },
  { title: 'The engineer diagnoses and prices it', body: 'On site, the engineer finds the cause and gives you a price for the work before starting. Nothing goes ahead until you have agreed it.' },
  { title: 'The job is done and paid for', body: 'Once the work is finished and tested, you can pay by card or cash. Our workmanship is guaranteed, so if anything we did is not right afterwards, call the office and we will come back and put it right.' },
];

const faqs = [
  { q: 'Is there a call-out charge?', a: 'Yes. We tell you what it is when you book, before an engineer sets off, so there is no surprise on the day.' },
  { q: 'Can you give me a price over the phone?', a: 'Often we can give you a rough idea from a good description or a photo. The firm price comes from the engineer once they have seen the job, and it is agreed with you before any work starts.' },
  { q: 'How can I pay?', a: 'By card or cash, once the work is done.' },
  { q: 'What are your opening hours?', a: `The office is open ${site.hours.office}. Outside those hours, the emergency callout line is still answered for burst pipes, major leaks, no water and no heating.` },
  { q: 'Do you cover my area?', a: 'We cover Greater London, plus Guildford, Woking and the towns around them in Surrey and north-east Hampshire. The areas page lets you check your postcode.' },
];

// site.json currently carries the same number for booking and management.
// The old layout listed both regardless, which in these cards reads as the
// same phone number twice; the management route only appears once it is
// actually a different line.
const managementIsSeparate = site.management.tel !== site.booking.tel;

const routes = [
  {
    href: `tel:${site.booking.tel}`,
    icon: 'phone',
    bg: '#1B1F2A',
    value: site.booking.display,
    label: managementIsSeparate
      ? 'Job booking — quickest for getting an engineer out'
      : 'Job booking, and commercial, accounts and complaints — quickest for getting an engineer out',
  },
  {
    href: site.whatsapp.url,
    icon: 'whatsapp',
    bg: '#25D366',
    fg: '#0B3D22',
    value: `WhatsApp ${site.whatsapp.display}`,
    label: 'Send a photo or video of the problem for a quicker answer',
    external: true,
  },
  {
    href: `mailto:${site.email}`,
    icon: 'mail',
    bg: '#19647F',
    value: site.email,
    label: 'Landlords, agents and written quotes — suits anything that can wait',
  },
  ...(managementIsSeparate
    ? [{
        href: `tel:${site.management.tel}`,
        icon: 'headset',
        bg: '#0E3A4B',
        value: site.management.display,
        label: 'Management — commercial, accounts and complaints',
      }]
    : []),
];

const directions = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(
  `${site.address.line1}, ${site.address.city} ${site.address.postcode}`
)}`;

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Ninja Plumbers',
  url: new URL('/contact', Astro.site).href,
  about: { '@type': 'Plumber', name: site.name, telephone: site.booking.tel, email: site.email, url: site.url },
};
---
<Ninja
  title="Contact Us | Book a London Plumber | Ninja Plumbers"
  description={`Contact Ninja Plumbers in London by phone on ${site.booking.display}, WhatsApp on ${site.whatsapp.display} or email. Office in Fulham, emergency callout 24/7.`}
>
<Schema slot="head" breadcrumb={crumbs} faqs={faqs} extra={contactSchema} />

{/* ---------- Hero ---------- */}
<section class="hero">
  <svg class="hero-rings" viewBox="0 0 600 600" aria-hidden="true">
    <circle cx="300" cy="300" r="118"/><circle cx="300" cy="300" r="178"/>
    <circle cx="300" cy="300" r="238"/><circle cx="300" cy="300" r="296"/>
  </svg>

  <div class="shell" style="display:block;padding:48px 0 44px">
    <ol class="crumbs">
      <li><a href="/">Home</a></li>
      <li aria-hidden="true">/</li>
      <li>Contact</li>
    </ol>
    <p class="eyebrow">Get in touch</p>
    <h1 style="max-width:24ch;margin:0 0 14px">Talk to a real person &mdash; not a call centre</h1>
    <p class="lead" style="max-width:54ch;margin:0">
      Ring Ninja Plumbers and you&rsquo;ll speak to someone who can actually get an engineer
      moving. If it&rsquo;s urgent, don&rsquo;t sit waiting on an email &mdash; call.
    </p>
  </div>
</section>

{/* ---------- Routes + form ---------- */}
<section class="section" style="padding-top:56px">
  <div class="shell contact-grid">
    <div style="display:grid;gap:14px">
      <h2 style="margin-bottom:4px">Ways to contact us</h2>
      <p style="margin:0 0 6px">
        However you&rsquo;d rather get in touch, it lands with the same Fulham office &mdash;
        pick whichever&rsquo;s easiest.
      </p>

      {routes.map((r) => (
        <a
          class="ccard"
          href={r.href}
          target={r.external ? '_blank' : undefined}
          rel={r.external ? 'noopener' : undefined}
        >
          <span class="ci" style={`background:${r.bg}${r.fg ? `;color:${r.fg}` : ''}`}>
            <NinjaIcon name={r.icon} />
          </span>
          <span><strong>{r.value}</strong><small>{r.label}</small></span>
          <NinjaIcon name="arrow" cls="ic arrow" />
        </a>
      ))}

      <div class="hours">
        <h3 style="margin-bottom:6px">Opening hours</h3>
        <div><span>Monday &ndash; Sunday</span><span>7am &ndash; 10pm</span></div>
        <div><span>Bank holidays</span><span>7am &ndash; 10pm</span></div>
        <div><span>Emergency callout</span><span>24/7</span></div>
        <p class="small muted" style="margin:8px 0 0">
          Outside office hours the emergency line is still answered for burst pipes, major
          leaks, no water and no heating.
        </p>
      </div>

      <div class="aside-card">
        <h3>Useful details to give us</h3>
        <p>With these four details to hand, you should get a proper answer on the first call, rather than needing three:</p>
        <ul class="check-list" style="grid-template-columns:1fr;margin-top:14px">
          <li><NinjaIcon name="check" />The postcode of the property</li>
          <li><NinjaIcon name="check" />The problem, and about when it began</li>
          <li><NinjaIcon name="check" />If the water has been turned off or is still flowing</li>
          <li><NinjaIcon name="check" />Access to the property, and when you will be in</li>
        </ul>
        <p class="small muted" style="margin:14px 0 0">
          There&rsquo;s no need to type out a long description &mdash; a WhatsApp photo usually
          shows us more, and makes it likelier the engineer arrives with the right part on the
          first visit.
        </p>
      </div>

      <div class="hours">
        <h3 style="margin-bottom:6px">Office &amp; company</h3>
        <div><span>Address</span><span>{site.address.line1}, {site.address.postcode}</span></div>
        <div><span>Registered company</span><span>{site.legalName}</span></div>
        <div><span>Company number</span><span>{site.companyNumber}</span></div>
        <div><span>Coverage</span><span>Greater London &amp; Surrey</span></div>
        <p class="small" style="margin:8px 0 0">
          <a href={directions} target="_blank" rel="noopener">Get directions <NinjaIcon name="arrow" /></a>
          &nbsp;&middot;&nbsp;
          <a href="/areas-we-cover">View every area</a>
        </p>
      </div>

      <div class="callout">
        <NinjaIcon name="alert" />
        <p>
          <strong>Emergency right now?</strong> Please call rather than using the form &mdash;
          water through a ceiling or a smell of gas needs a voice, not an inbox. If you can
          smell gas, leave the property and ring the National Gas Emergency Service free on
          <a href="tel:0800111999">0800 111 999</a> first.
        </p>
      </div>
    </div>

    <NinjaQuoteCard
      heading="Send us the job"
      intro="Quotes and bookings — we'll call you back about the work and the price."
      submitLabel="Send & get a call back"
      trust={['No obligation', 'No spam, ever', 'Price agreed before work starts']}
    />
  </div>
</section>

{/* ---------- Steps ---------- */}
<section class="section section-cream">
  <div class="shell">
    <div class="section-head center">
      <p class="eyebrow">After you get in touch</p>
      <h2>From your call to a finished job</h2>
    </div>
    <ol class="steps" style="grid-template-columns:repeat(2,minmax(0,1fr))">
      {steps.map((st, i) => (
        <li class="step">
          <span class="n">{i + 1}</span>
          <h3>{st.title}</h3>
          <p>{st.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ---------- FAQ ---------- */}
<section class="section">
  <div class="shell">
    <div class="section-head center">
      <p class="eyebrow">FAQs</p>
      <h2>Worth knowing before you contact us</h2>
    </div>
    <div class="faq">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}<NinjaIcon name="chevron" /></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p style="text-align:center;margin:28px 0 0">
      Looking for a particular job? Start with <a href="/services">all our services</a>, or go
      straight to <a href="/services/emergency-plumbing">emergency plumbing</a>,
      <a href="/boilers">boilers</a>, <a href="/heating">heating</a> or
      <a href="/drainage">drainage</a>.
    </p>
  </div>
</section>

{/* ---------- Dark CTA band ---------- */}
<section class="band">
  <div class="shell">
    <div>
      <p class="eyebrow">Don&rsquo;t email an emergency</p>
      <h2>No water, no heating or a burst pipe?</h2>
      <p>Our emergency callouts cover London at any hour, day or night.</p>
      <a class="phone-big" href={`tel:${site.booking.tel}`}>
        <span class="pi"><NinjaIcon name="phone" /></span>{site.booking.display}
      </a>
    </div>
    <div class="actions">
      <a class="btn btn-light btn-lg" href={`tel:${site.booking.tel}`}>Call now</a>
      <a class="btn btn-wa btn-lg" href={site.whatsapp.url} target="_blank" rel="noopener">
        WhatsApp us
      </a>
    </div>
  </div>
</section>

</Ninja>
