---
// One page per damp/condensation topic. Same shape as the appliance page
// template, with a cross-link block back to the core services these
// overlap with.
import { SCHEMA_AREA_SERVED } from '../../data/serviceArea';
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { dampPages } from '../../data/damp';
import { services } from '../../data/services';
import { blogPosts } from '../../data/blog';
import ServiceIcon from '../../components/ServiceIcon.astro';
import Tick from '../../components/Tick.astro';
import PhoneIcon from '../../components/PhoneIcon.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import HeroWithForm from '../../components/HeroWithForm.astro';
import Schema from '../../components/Schema.astro';

export function getStaticPaths() {
  return dampPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;

const related = page.related.map((slug) => services.find((s) => s.slug === slug)!);
const siblings = dampPages.filter((d) => d.slug !== page.slug);
const relatedPosts = blogPosts.filter((p) => (p.relatedDamp ?? []).includes(page.slug));

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Damp & Condensation', href: '/damp' },
  { label: page.title },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.title,
  description: page.metaDescription,
  serviceType: page.title,
  provider: {
    '@type': 'Plumber',
    name: site.name,
    telephone: site.booking.tel,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.line1,
      addressLocality: site.address.city,
      postalCode: site.address.postcode,
      addressCountry: site.address.country,
    },
  },
  areaServed: SCHEMA_AREA_SERVED,
};
---
<Base title={page.metaTitle} description={page.metaDescription}>
  <Schema slot="head" breadcrumb={crumbs} faqs={page.faqs} extra={serviceSchema} />

  <HeroWithForm
    eyebrow={page.eyebrow}
    h1={page.h1}
    intro={page.intro}
    breadcrumb={crumbs}
    bullets={[
      'Fully insured and Gas Safe registered',
      'Engineers who are DBS-checked',
      '24/7 emergency callouts on offer',
      'You agree the price before we start',
      'Our workmanship is guaranteed',
    ]}
    formHeading={`Request a quote for ${page.title.toLowerCase()}`}
    service={page.title}
    tel={site.booking}
  />

  <section class="section">
    <div class="container service-row">
      <div class="service-copy">
        <span class="eyebrow">The work</span>
        <h2>What the job covers</h2>
        <ul class="ticks">
          {page.does.map((d) => <li><Tick /> {d}</li>)}
        </ul>
        <div class="cta-row">
          <a href="/contact#enquiry" class="btn btn-navy">Tell us about the job</a>
        </div>
      </div>
      <aside class="service-aside">
        <div class="icon"><ServiceIcon name={page.icon} /></div>
        <h3>{page.aside.title}</h3>
        <p>{page.aside.body}</p>
      </aside>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">Good to know</span>
      <h2>Things to check before booking</h2>
      <p class="measure">A few of these points could mean you need no visit at all. We would sooner you knew that.</p>
      <div class="guidance">
        {page.guidance.map((g) => (
          <div class="guidance-item">
            <h3>{g.title}</h3>
            <p>{g.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container measure-wide">
      <span class="eyebrow">FAQs</span>
      <h2>Questions people ask us</h2>
      <div class="faqs">
        {page.faqs.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">Plumbing links</span>
      <h2>When the cause is plumbing</h2>
      <p class="measure">
        If a leaking pipe or fitting is behind the problem, not damp as such, these pages explain that work.
      </p>
      <ul class="grid grid-3 card-grid">
        {related.map((s) => (
          <li class="card">
            <div class="icon"><ServiceIcon name={s.icon} /></div>
            <h3><a href={`/services/${s.slug}`} class="card-title-link" set:html={s.title} /></h3>
            <p>{s.summary}</p>
            <a href={`/services/${s.slug}`} class="card-link">
              Read about {s.title.replace('&amp;', 'and')} <span aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">More on damp</span>
      <h2>Other damp and condensation pages</h2>
      <ul class="combo-links">
        {siblings.map((d) => (
          <li><a href={`/damp/${d.slug}`}>{d.title}</a></li>
        ))}
      </ul>
      <p><a href="/damp" class="btn btn-navy">Every damp &amp; condensation page</a></p>
    </div>
  </section>

  {relatedPosts.length > 0 && (
    <section class="section">
      <div class="container">
        <span class="eyebrow">Blog posts</span>
        <h2>Further reading</h2>
        <ul class="combo-links">
          {relatedPosts.map((p) => (
            <li><a href={`/blog/${p.slug}`}>{p.title}</a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section section-navy">
    <div class="container center measure-wide">
      <h2>Looking for {page.title.toLowerCase()} in London?</h2>
      <p>Let us know the problem and your address, and you will hear the cost before any work begins.</p>
      <div class="cta-row center-row">
        <a href={`tel:${site.booking.tel}`} class="btn btn-orange btn-lg">
          <PhoneIcon /> Call {site.booking.display}
        </a>
        <a href={site.whatsapp.url} class="btn btn-outline btn-lg">
          <WhatsAppIcon /> Message us on WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>
